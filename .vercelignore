# Vercel CLI uploads everything not excluded here (or in .gitignore) before
# running tools/vercel-build.sh. None of this is read by that script (it only
# touches build.py, src/*.js, tools/admin-dashboard.html, assets/audio/*) or
# by the api/*.js serverless functions — it's Claude Code project state and
# planning docs. Without this file, .claude/ alone (old agent worktrees) was
# ~178MB of a ~200MB+ upload on every deploy.
.claude
design
docs
production
