## Per-type icon — direct 1:1 lookup into _FACE_TYPE_ICON (see that const's header comment).
## No value-based tiering: the web build's own FT_IC table has exactly one icon per face type,
## unlike the Origins intent-icon set this used to borrow, which only had 3 dmg tiers to fake it
## from.
func _face_icon_for(face_type: String) -> Texture2D:
	return _FACE_TYPE_ICON.get(face_type, _FACE_TYPE_ICON["blank"])


## Body-part icon for the die tray (review-uiux-godot-vs-web.md P1 #3) — web/part/<slot>_<class>
## .svg, the same files godot/tests/t_assets.gd gates for all 6 slots x 6 classes. Returns null
## for a class with no matching file (non-hero enemies have cls=="" and never appear in the die
## tray — _party_dice_units() only returns units with roster_index >= 0 — so in practice this
## null path is unreachable from the die tray itself, but stays a safe no-icon fallback rather
## than an error if that ever changes).
## Rendered from the class's own 3D rig by tools/render_portraits.tscn. Returns null for a
## unit with no class (every non-hero enemy), which the TextureRect draws as nothing — those
## never appear in the dice tray anyway.
func _class_portrait(cls: String) -> Texture2D:
	if cls == "":
		return null
	var key := "portrait_%s" % cls
	if not _part_icon_cache.has(key):
		var path := "res://assets/portraits/%s.png" % cls
		_part_icon_cache[key] = load(path) if ResourceLoader.exists(path) else null
	return _part_icon_cache[key]


func _part_icon_for(part: String, cls: String) -> Texture2D:
	if cls == "":
		return null
	var slot := String(_PART_ICON_SLOT.get(part, part))
	var key := "%s_%s" % [slot, cls]
	if not _part_icon_cache.has(key):
		_part_icon_cache[key] = load("res://assets/icons/web/part/%s.svg" % key)
	return _part_icon_cache[key]


# ===========================================================================
# Unit inspector (src/client.html scUnitInfo(), :6945)
#
# The gap this closes: a player could read their OWN dice off the tray cards, but an enemy's
# die was not readable anywhere. Twenty-one monsters and six bosses, each with six faces, and
# the only way to learn any of it was to be hit by it. That is not difficulty, it is hidden
# information in a game whose own rule spec calls for "minh bạch triệt để" — total transparency.
# ===========================================================================

## Opens the inspector for `uid`. Built fresh each time rather than kept and repainted: it is
## a modal the player dismisses, the data behind it is a snapshot of one moment, and a stale
## panel showing last turn's HP would be worse than no panel.
func _open_unit_inspect(uid: int) -> void:
	if _combat == null:
		return
	var u := _combat.by_uid(uid)
	if u == null:
		return
	_close_unit_inspect()
	_inspect_panel = _build_unit_inspect(u)


func _close_unit_inspect() -> void:
	if _inspect_panel != null and is_instance_valid(_inspect_panel):
		var layer := _inspect_panel.get_parent()
		# Detach BEFORE queue_free(). queue_free() is deferred to the end of the frame, so a
		# panel closed and reopened within one frame — which is exactly what _open_unit_inspect()
		# does — would leave the old full-screen click blocker in the tree, still swallowing
		# input, behind the new one. Removing it first makes the close immediate.
		if layer != null and layer.get_parent() != null:
			layer.get_parent().remove_child(layer)
		if layer != null:
			layer.queue_free()
	_inspect_panel = null


func _build_unit_inspect(u: Unit) -> Control:
	var layer := CanvasLayer.new()
	layer.layer = 28          # under the quit confirm (30), over the HUD
	add_child(layer)

	var dim := ColorRect.new()
	dim.color = Color(0, 0, 0, 0.66)
	dim.set_anchors_preset(Control.PRESET_FULL_RECT)
	dim.mouse_filter = Control.MOUSE_FILTER_STOP
	dim.gui_input.connect(func(ev: InputEvent):
		# Click anywhere off the card to dismiss — the web build's own overlay behaviour.
		if ev is InputEventMouseButton and (ev as InputEventMouseButton).pressed:
			_close_unit_inspect())
	layer.add_child(dim)

	var center := CenterContainer.new()
	center.set_anchors_preset(Control.PRESET_FULL_RECT)
	center.mouse_filter = Control.MOUSE_FILTER_IGNORE
	dim.add_child(center)

	var panel := PanelContainer.new()
	# Opaque, for the same reason the quit dialog is: a panel of small text over a lit
	# battlefield is unreadable at 0.82 alpha.
	panel.add_theme_stylebox_override("panel", DangoTheme.panel_style(DangoTheme.BG, 3, 12, 18.0))
	panel.custom_minimum_size = Vector2(560, 0)
	center.add_child(panel)

	var margin := MarginContainer.new()
	for side in ["left", "right", "top", "bottom"]:
		margin.add_theme_constant_override("margin_" + side, 16)
	panel.add_child(margin)

	var col := VBoxContainer.new()
	col.add_theme_constant_override("separation", 10)
	margin.add_child(col)

	_inspect_header(col, u)
	_inspect_context(col, u)
	_inspect_status(col, u)
	_inspect_faces(col, u)

	var close := Button.new()
	close.text = "Close"
	close.custom_minimum_size = Vector2(0, 40)
	DangoTheme.style_button(close, false, false, DangoTheme.TEXT)
	close.pressed.connect(_close_unit_inspect)
	col.add_child(close)

	return dim


func _inspect_header(col: VBoxContainer, u: Unit) -> void:
	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", 10)
	col.add_child(row)

	var portrait := TextureRect.new()
	portrait.custom_minimum_size = Vector2(44, 44)
	portrait.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	portrait.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	# Party Axies have a rendered portrait; enemies wear their Chimera sprite. Both already
	# exist, so the header shows the same creature the board does.
	portrait.texture = (MonsterArt.texture_for(u.key, u.is_boss) if u.side == "e"
		else _class_portrait(u.cls))
	row.add_child(portrait)

	var text_col := VBoxContainer.new()
	text_col.add_theme_constant_override("separation", 0)
	text_col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(text_col)

	var name_row := HBoxContainer.new()
	name_row.add_theme_constant_override("separation", 8)
	text_col.add_child(name_row)

	var name_label := Label.new()
	name_label.text = u.n.to_upper()
	name_label.add_theme_font_size_override("font_size", 20)
	name_label.add_theme_color_override("font_color", DangoTheme.TEXT)
	name_row.add_child(name_label)

	var tag := ""
	if u.side == "e":
		tag = "BOSS" if u.is_boss else ("TOKEN" if u.is_token else "")
	else:
		tag = String(u.cls).to_upper()
	if tag != "":
		var pill := Label.new()
		pill.text = tag
		pill.add_theme_font_size_override("font_size", 12)
		pill.add_theme_color_override("font_color", DangoTheme.PRIMARY)
		name_row.add_child(pill)

	var sub := Label.new()
	var bits: Array = ["%d/%d HP" % [maxi(u.hp, 0), maxi(u.max_hp, 1)]]
	if u.shield > 0:
		bits.append("Shield %d" % u.shield)
	if u.side == "p":
		bits.append("Tier %d" % u.tier)
	sub.text = "  ·  ".join(PackedStringArray(bits))
	sub.add_theme_font_size_override("font_size", 14)
	sub.add_theme_color_override("font_color", DangoTheme.TEXT_DIM)
	text_col.add_child(sub)


## Class passive for a party Axie, AI role for an enemy. The passive text comes from
## ContentDB.CLASS_PASSIVE — the engine has always applied these, and the player has never been
## told what they are.
func _inspect_context(col: VBoxContainer, u: Unit) -> void:
	var label := ""
	var body := ""
	if u.side == "p" and ContentDB.CLASS_PASSIVE.has(u.cls):
		var pas: Dictionary = ContentDB.CLASS_PASSIVE[u.cls]
		label = "PASSIVE · %s" % String(pas.get("n", ""))
		body = String(pas.get("d", ""))
	elif u.side == "e" and String(u.role) != "":
		label = "%s · ENEMY" % String(u.role).to_upper()
	if label == "":
		return
	var l := Label.new()
	l.text = label
	l.add_theme_font_size_override("font_size", 12)
	l.add_theme_color_override("font_color", DangoTheme.PRIMARY)
	col.add_child(l)
	if body != "":
		var b := Label.new()
		b.text = body
		b.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		b.custom_minimum_size = Vector2(520, 0)
		b.add_theme_font_size_override("font_size", 14)
		b.add_theme_color_override("font_color", DangoTheme.TEXT_DIM)
		col.add_child(b)


func _inspect_status(col: VBoxContainer, u: Unit) -> void:
	var active: Array = []
	for key in u.status.keys():
		if int(u.status[key]) > 0:
			active.append("%s %d" % [String(key).to_upper(), int(u.status[key])])
	if active.is_empty():
		return
	var l := Label.new()
	l.text = "  ".join(PackedStringArray(active))
	l.add_theme_font_size_override("font_size", 14)
	l.add_theme_color_override("font_color", DangoTheme.TEXT)
	col.add_child(l)


## All six faces. Values come from CombatEngine._face_value(), NOT the raw face data: growth,
## weaken, blind, vital and overdrive all change what a face is worth right now, and a panel
## that showed the base number would be lying at exactly the moment the player consults it.
func _inspect_faces(col: VBoxContainer, u: Unit) -> void:
	var heading := Label.new()
	heading.text = "ALL SIX FACES"
	heading.add_theme_font_size_override("font_size", 12)
	heading.add_theme_color_override("font_color", DangoTheme.PRIMARY)
	col.add_child(heading)

	var rolled_index: int = u.roll_face_index()
	for i in u.die.size():
		var f: Dictionary = u.die[i]
		var face_type := String(f.get("type", ""))
		var row := HBoxContainer.new()
		row.add_theme_constant_override("separation", 8)
		col.add_child(row)

		var icon := TextureRect.new()
		icon.custom_minimum_size = Vector2(20, 20)
		icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		icon.texture = _FACE_TYPE_ICON.get(face_type, null)
		row.add_child(icon)

		var value := Label.new()
		value.custom_minimum_size = Vector2(34, 0)
		value.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		value.text = "—" if face_type == "blank" else str(_combat._face_value(u, i))
		value.add_theme_font_size_override("font_size", 17)
		value.add_theme_color_override("font_color", DangoTheme.TEXT)
		row.add_child(value)

		var caption := Label.new()
		var raw_part := String(f.get("part", ""))
		# Same fallback the die card uses. Enemy faces all carry part "m", which is not a real
		# body part and correctly yields no part label; anything else shows its own name even if
		# _PART_LABEL has not heard of it yet.
		var part_name := String(_PART_LABEL.get(raw_part, raw_part.to_upper())) if _PART_LABEL.has(raw_part) else ""
		var type_name := String(_DIE_TYPE_LABEL.get(face_type, face_type.to_upper()))
		caption.text = ("%s · %s" % [part_name, type_name]) if part_name != "" else type_name
		caption.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		caption.add_theme_font_size_override("font_size", 14)
		caption.add_theme_color_override("font_color", DangoTheme.TEXT)
		row.add_child(caption)

		var keywords: Array = f.get("keywords", [])
		if not keywords.is_empty():
			var kw := Label.new()
			var names: Array = []
			for k in keywords:
				# Value-carrying keywords are stored as "burn:6"; show the family name.
				var base_kw := String(k).split(":")[0]
				names.append(String(_KEYWORD_LABEL.get(base_kw, base_kw.to_upper())))
			kw.text = " ".join(PackedStringArray(names))
			kw.add_theme_font_size_override("font_size", 11)
			kw.add_theme_color_override("font_color", DangoTheme.TEXT_DIM)
			row.add_child(kw)

		if i == rolled_index:
			var mark := Label.new()
			mark.text = "ROLLED"
			mark.add_theme_font_size_override("font_size", 11)
			mark.add_theme_color_override("font_color", DangoTheme.SUCCESS)
			row.add_child(mark)


## A unit joined the fight. Goes through the full rebuild, not just the reconcile: building the
## nameplate is only half of it, and a nameplate that has not been painted yet shows 0/0 with an
## empty bar — which reads as a monster that spawned dead. (Seen in
## production/qa/evidence/2026-09-18_midcombat-spawn.png before this call was widened; the
## engine had the unit at full HP the whole time.)
func _on_unit_spawned(_uid: int) -> void:
	if _combat == null:
		return
	_rebuild_all()


## Makes the visuals match the engine's roster: builds a portrait, head HUD, 3D slot and audio
## voice for any unit that does not have them yet, then re-seats both rows.
##
## THIS IS THE SOURCE OF TRUTH, not `unit_spawned`. The bug it fixes was "there is a place that
## adds a unit and nothing tells the view" — there were five such places, one of them in
## `relic_hooks.gd`, a different file entirely. A fix that relies on every future spawn site
## remembering to announce itself would be the same bug waiting to happen, so the signal is
## treated as an optimisation and this comparison as the guarantee.
##
## Idempotent by construction: it only ever acts on uids it has not seen, so calling it from
## `_ready()`, from the signal, and from every `_rebuild_all()` is safe and cheap (a board is
## at most ~12 units).
func _sync_unit_visuals() -> void:
	var party_uids: Array = []
	var enemy_uids: Array = []
	for i in _combat.party.size():
		var u: Unit = _combat.party[i]
		party_uids.append(u.uid)
		if not _portraits.has(u.uid):
			_spawn_portrait(u, false, i, _combat.party.size())
	for i in _combat.enemies.size():
		var e: Unit = _combat.enemies[i]
		enemy_uids.append(e.uid)
		if not _portraits.has(e.uid):
			_spawn_portrait(e, true, i, _combat.enemies.size())

	# Every spawn shifts its whole row: `spawn_unit()` fixes a slot's position from the
	# slot_count it was given, so without this the newcomer sits on top of someone.
	if is_instance_valid(_stage3d):
		_stage3d.reseat_side(party_uids, false)
		_stage3d.reseat_side(enemy_uids, true)


func _spawn_portrait(u: Unit, is_enemy: bool, slot_index: int, slot_count: int) -> void:
	var p: UnitPortrait = _PORTRAIT_SCENE.instantiate()
	_unit_visuals_root.add_child(p)
	p.setup(u.uid, u.n, u.cls, is_enemy)
	p.clicked.connect(_on_target_clicked)
	_portraits[u.uid] = p

	var hud := UnitHeadHUD.new()
	hud.uid = u.uid
	hud.intent_hover_changed.connect(_on_enemy_intent_hover)
	_unit_visuals_root.add_child(hud)
	_head_huds[u.uid] = hud

	_stage3d.spawn_unit(u.uid, u.cls, is_enemy, slot_index, slot_count, u.is_boss, u.key)
	# The audio director only ever sees uids in `hit_landed`, so it needs each unit's voice
	# up front. Heroes carry their own class; monsters have none and get one derived from the
	# Chimera sprite they wear — without this every enemy in the game would be silent.
	_audio.register_unit(u.uid, u.cls, u.key, u.is_boss)


# ===========================================================================
# Per-frame overlay positioning (Nameplate at the feet, UnitHeadHUD above the head; all
# world->screen via CombatStage3D). Not an EventBus handler — see file-level "STATE-READ
# DISCIPLINE" comment for why this one function is allowed to re-read _combat/CombatStage3D every
# frame anyway (camera-space follow only).
#
# v2 UI redesign REMOVES two things that used to live here — TargetLines (the dashed
# attacker->target curves) and the dynamic vignette re-target — per design_handoff_axie_dice_ui's
# own treeNotes: "the intent plate names the target and the target's own plate carries the number
# plus the at-risk slice on its bar, so the lines were a third copy of information already on
# screen twice", and the vignette is superseded by the new static directional scrim (see
# _build_stage_background()'s comment for the full reasoning). Positioning nameplates/HUDs off
# the live 3D projection is UNCHANGED — CombatStage3D.gd (camera + per-slot world positions) is
# not a file this pass owns, so the v2 redline's "party columns at a fixed 194px pitch centred on
# x=960" is only partly landed: the DIE TRAY (fully owned here) now sits at that exact pitch, but
# the party nameplates above still follow wherever CombatStage3D's fixed camera projects them,
# which may not land on the identical pixel grid — see the task report for the follow-up this
# needs.
# ===========================================================================

func _layout_unit_visuals() -> void:
	if _combat == null:
		return
	var stage_offset: Vector2 = _stage3d.position   # Stage3D no longer fills the whole Root
		# (anchored to an inset "playfield" band in Combat.tscn) but UnitVisualsRoot DOES fill the
		# whole Root — get_unit_screen_pos() returns Stage3D-LOCAL coordinates, so every result
		# here must be re-based into the shared full-Root overlay space.
	for uid in _portraits.keys():
		var p: UnitPortrait = _portraits[uid]
		var feet := _stage3d.get_unit_screen_pos(uid, CombatStage3D.FEET_HEIGHT)
		if feet.x >= 0.0:
			p.position = stage_offset + Vector2(feet.x - UnitPortrait.WIDTH * 0.5, feet.y + 6.0)

		var hud: UnitHeadHUD = _head_huds.get(uid)
		if hud == null:
			continue
		var head := _stage3d.get_unit_screen_pos(uid, CombatStage3D.HEAD_HEIGHT)
		if head.x >= 0.0:
			var h := hud.total_height()
			hud.position = stage_offset + Vector2(head.x - UnitHeadHUD.WIDTH * 0.5, head.y - h)
	_backdrop.apply_parallax(stage_offset)


# ===========================================================================
# Input — click-click (dice tray = select source, Nameplate/3D model = select target)
# ===========================================================================

func _on_die_slot_pressed(slot_index: int) -> void:
	if _is_animating:
		return
	var units := _party_dice_units()
	if slot_index >= units.size():
		return
	var u: Unit = units[slot_index]
	if u.hp <= 0 or not u.has_rolled() or u.roll_used():
		return
	_selected_die_uid = -1 if _selected_die_uid == u.uid else u.uid
	_rebuild_all()


## Writes the CONTINUE RUN slot with this fight's full state. Called after every action that
## actually changes the engine — the same placement JS uses for its thirteen saveRun() calls.
## Selecting a die is deliberately NOT one of them: it changes nothing an engine snapshot would
## record, and saving on it would write the file on every click for no gain.
func _save_run_progress() -> void:
	if _combat == null or _result_shown:
		return
	RunState.save_run(_combat.to_data())


func _on_target_clicked(uid: int) -> void:
	if _is_animating:
		return
	# src/client.html:5273 — a unit that is NOT a legal target opens its inspector instead;
	# a legal one is a target. In this port "legal target" is exactly what _update_portrait()
	# paints as targetable: a die is selected and the unit is alive. So the targeting path
	# below is untouched, and this only fills in the click that used to do nothing at all.
	var u := _combat.by_uid(uid)
	if _selected_die_uid == -1 or u == null or u.hp <= 0:
		_open_unit_inspect(uid)
		return
	var ok := _combat.use_die(_selected_die_uid, uid)
	_append_log("[input] use %s -> %s : %s" % [_unit_name(_selected_die_uid), _unit_name(uid), "ok" if ok else "invalid"])
	if not ok:
		var p: UnitPortrait = _portraits.get(uid)
		if p != null:
			p.spawn_float_text("Invalid target", "deb", 0)
	_selected_die_uid = -1
	_clear_all_previews()
	_rebuild_all()
	_save_run_progress()


func _on_reroll_pressed() -> void:
	var uids: Array = []
	var slot_indices: Array = []
	var units := _party_dice_units()
	for i in units.size():
		var u: Unit = units[i]
		if u.hp > 0 and u.has_rolled() and not u.roll_used() and not u.heavy and not u.frozen:
			uids.append(u.uid)
			slot_indices.append(i)
	# Toss overlay must go up BEFORE reroll_dice()/_rebuild_all() below repaint the new face —
	# see _start_reroll_toss()'s own comment for why this ordering is what makes "hide old value,
	# reveal new only once the toss settles" work with zero engine changes.
	if not slot_indices.is_empty():
		_start_reroll_toss(slot_indices)
	var ok := _combat.reroll_dice(uids)
	_append_log("[input] reroll %d dice : %s" % [uids.size(), "ok" if ok else "failed"])
	_selected_die_uid = -1
	_rebuild_all()
	_save_run_progress()


## "Tung xúc xắc" toss juice (ui-programmer follow-up pass, task C). Each rerolled slot's
## `reroll_overlay` (see _build_die_slot_content()) is shown IMMEDIATELY, before reroll_dice()/
## _rebuild_all() below ever run — so the instant those repaint this slot with the brand-new face
## value, the overlay is already sitting on top hiding it. The overlay itself then spins+bounces
## for _REROLL_TOSS_DURATION and hides again at the very end, "revealing" the new value that was
## underneath the whole time. No gameplay state is touched and no engine file is read/written —
## purely a Control Tween, gated behind disable_juice_for_tests like every other juice entry point
## in this file.
func _start_reroll_toss(slot_indices: Array) -> void:
	if disable_juice_for_tests:
		return
	for i in slot_indices:
		if i < 0 or i >= _die_slot_content.size():
			continue
		var content: Dictionary = _die_slot_content[i]
		var overlay: PanelContainer = content.get("reroll_overlay")
		if overlay == null or not is_instance_valid(overlay) or not overlay.is_inside_tree():
			continue
		overlay.visible = true
		overlay.modulate = Color(1, 1, 1, 1)
		overlay.rotation_degrees = 0.0
		overlay.pivot_offset = overlay.size * 0.5
		overlay.scale = Vector2.ONE
		var tw := create_tween()
		# Spin + bounce-up, then settle back to rest — "tung lên rồi rơi xuống ổn định".
		tw.tween_property(overlay, "rotation_degrees", randf_range(300.0, 420.0),
			_REROLL_TOSS_DURATION * 0.7).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
		tw.parallel().tween_property(overlay, "scale", Vector2(1.28, 1.28),
			_REROLL_TOSS_DURATION * 0.4).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		tw.tween_property(overlay, "scale", Vector2.ONE, _REROLL_TOSS_DURATION * 0.3) \
			.set_trans(Tween.TRANS_ELASTIC).set_ease(Tween.EASE_OUT)
		tw.tween_callback(func():
			if is_instance_valid(overlay):
				overlay.visible = false
				overlay.rotation_degrees = 0.0
				overlay.scale = Vector2.ONE)


func _on_end_turn_pressed() -> void:
	_combat.end_turn()
	_selected_die_uid = -1
	_clear_all_previews()
	_rebuild_all()
	_save_run_progress()


func _on_log_toggle_pressed() -> void:
	_debug_log_container.visible = not _debug_log_container.visible


## Wired to CombatEngine's existing undo_last() (rule spec §2: "free undo within a turn") — an
## already-public engine API this pass simply exposes in the UI; no new gameplay rule added here
## (file-header: "NEVER contains game rules itself").
func _on_undo_pressed() -> void:
	if _is_animating:
		return
	if _combat.undo_last():
		_selected_die_uid = -1
		_clear_all_previews()
		_append_log("[input] undo")
		_rebuild_all()
		_save_run_progress()


## Static how-to-play panel (review-uiux-godot-vs-web.md P0 #1 layout: "Undo / Info / Log
## pushed right"; P2 #12 separately flags the missing "click a die..." hint line — this covers
## that too, at no extra cost, since it's the same static text). No engine call, no state read
## beyond what's already true of this input model (file-header "INPUT MODEL" comment).
func _on_info_toggle_pressed() -> void:
	# ui-programmer, godot-port-gap-inventory.md §2.1 "scInfo" — opens the real six-tab panel
	# (InfoPanelView.tscn, a NEW scene, not part of this file's node tree) instead of just
	# toggling the old static how-to-play hint. Smallest possible hook per task brief: this
	# function body is the only change made to CombatView.gd for that feature.
	#
	# A TOGGLE, not an opener. The button is labelled Info and was a toggle before; opening a
	# second copy on the second press would stack two panels the player then has to close twice,
	# and the one underneath would be showing a snapshot of a turn that has since moved on.
	if is_instance_valid(_info_overlay):
		_info_overlay.queue_free()
		_info_overlay = null
		return
	var panel := preload("res://scenes/combat/InfoPanelView.tscn").instantiate()
	panel.setup(_combat, RunState.owned_relic_ids)
	panel.closed.connect(panel.queue_free)
	var layer := CanvasLayer.new()
	layer.layer = 29
	add_child(layer)
	layer.add_child(panel)
	panel.tree_exited.connect(layer.queue_free)
	_info_overlay = layer


## Damage-preview hover, path 1/2 (review P0 #2): hovering a currently-playable ATTACK die
## previews its value on every alive enemy (click-click has no "hovering a target" moment
## before a die is even selected, so this previews against the whole legal-target set instead
## of one specific unit — see file-header DEVIATIONS #3).
func _on_die_slot_hover(slot_index: int, entering: bool) -> void:
	if entering:
		var units := _party_dice_units()
		if slot_index < units.size():
			var u: Unit = units[slot_index]
			if u.hp > 0 and u.has_rolled() and not u.roll_used():
				var fi := u.roll_face_index()
				var f: Dictionary = u.die[fi]
				if String(f.get("type", "")) == "dmg":
					var value := int(f.get("value", 0))
					for e in _combat.alive_enemies():
						var p: UnitPortrait = _portraits.get(e.uid)
						if p != null:
							p.set_preview_damage(value)
					return
	_clear_all_previews()


## Damage-preview hover, path 2/2 (review P0 #2 + #3 combined): hovering an enemy's intent
## badge previews that intent's actual value on its actual target — the more important of the
## two per the review's own framing ("quyết định người chơi giơ khiên hay lao vào đánh"). Also
## brightens this enemy's target-line (see _layout_unit_visuals()).
func _on_enemy_intent_hover(uid: int, hovering: bool) -> void:
	_hovered_enemy_uid = uid if hovering else -1
	if not hovering:
		_clear_all_previews()
		return
	var e := _combat.by_uid(uid)
	if e == null or e.intent.is_empty():
		return
	var fi := int(e.intent.get("face_index", -1))
	var tgt_uid := int(e.intent.get("target_uid", -1))
	if fi < 0 or fi >= e.die.size() or tgt_uid < 0:
		return
	var f: Dictionary = e.die[fi]
	if String(f.get("type", "")) != "dmg":
		return
	var p: UnitPortrait = _portraits.get(tgt_uid)
	if p != null:
		p.set_preview_damage(int(f.get("value", 0)))


func _clear_all_previews() -> void:
	for p in _portraits.values():
		(p as UnitPortrait).clear_preview_damage()


# ===========================================================================
# EventBus reactions — each funnels into _rebuild_all() (see file-level comment)
# ===========================================================================

func _on_hp_changed(_uid: int, _hp: int, _max_hp: int, _shield: int) -> void:
	_rebuild_all()

func _on_hit_landed(src_uid: int, uid: int, value: int, crit: bool) -> void:
	_append_log("[hit] %s -> %s : %d%s" % [_unit_name(src_uid), _unit_name(uid), value, " CRIT" if crit else ""])
	if is_instance_valid(_stage3d):
		_stage3d.play_hit_reaction(uid)   # `uid` is whoever just TOOK this hit — see
			# CombatStage3D.play_hit_reaction()'s own comment for the damage_pipeline.gd cross-check
	_play_hit_juice()

func _on_unit_died(uid: int) -> void:
	_append_log("[death] %s" % _unit_name(uid))
	var p: UnitPortrait = _portraits.get(uid)
	if p != null:
		p.play_death_fade()
	if is_instance_valid(_stage3d):
		_stage3d.play_death(uid)   # plays the real Dead clip first, THEN the scale-to-zero fade
			# once that clip's own on_complete callback fires — see CombatStage3D.play_death()
	_rebuild_all()

func _on_face_used(uid: int, _side: String, target_uid: int, aoe: bool, face_part: String, _face_name: String, face_type: String) -> void:
	# Cached so _on_hit_landed() (whose own payload has no face_part) can build a player-facing
	# sentence — see _player_hit_line(). Raw debug line below is UNCHANGED from the pre-review
	# pass (t_face_used_log_tag.gd regression-tests its exact "[AOE]" tagging logic).
	_last_face_used_by_uid[uid] = {"part": face_part, "type": face_type}
	var tgt := _unit_name(target_uid) if target_uid >= 0 else "-"
	var show_aoe_tag := aoe and face_type != "mana" and face_type != "summon"
	_append_log("[use] %s -> %s (%s/%s)%s" % [_unit_name(uid), tgt, face_part, face_type, " [AOE]" if show_aoe_tag else ""])
	if is_instance_valid(_stage3d):
		_stage3d.play_action(uid, face_type)   # "ra chiêu" — clip/pace now varies by face_type,
			# see CombatStage3D.play_action()'s _ACTION_ANIM_BY_TYPE comment

func _on_resonance_triggered(uid: int) -> void:
	_append_log("[resonance] %s" % _unit_name(uid))
	var p: UnitPortrait = _portraits.get(uid)
	if p != null:
		p.flash_resonance()

func _on_relic_pulsed(relic_id: String, uid: int) -> void:
	_append_log("[relic] %s on %s" % [relic_id, _unit_name(uid)])

func _on_float_text(uid: int, text: String, css_class: String, big: int) -> void:
	var p: UnitPortrait = _portraits.get(uid)
	if p != null:
		p.spawn_float_text(text, css_class, big)

func _on_boss_phase_changed(uid: int) -> void:
	_append_log("[phase] boss %s changed phase" % _unit_name(uid))
	_rebuild_all()

func _on_enemy_intent_executed(uid: int) -> void:
	_append_log("[eact] %s executes intent" % _unit_name(uid))
	_end_turn_acting_uid = uid   # §5.1a: END_TURN vignette pool follows whichever enemy is
		# currently resolving its intent — reset when leaving END_TURN, see _on_turn_phase_changed()
	_rebuild_all()

func _on_status_tick(statuses: PackedStringArray) -> void:
	_append_log("[tick] status effects resolved%s" % (
		"" if statuses.is_empty() else ": " + ", ".join(statuses)))
	_rebuild_all()

func _on_turn_phase_changed(_old_phase: int, new_phase: int) -> void:
	if new_phase != CombatPhase.END_TURN:
		_end_turn_acting_uid = -1   # next END_TURN starts from the "even lighting" fallback
			# again (§5.1a) until the first enemy_intent_executed(uid) of that phase arrives
	_rebuild_all()

func _on_combat_finished(won: bool) -> void:
	_append_log("[combat_finished] won=%s" % won)
	_audio.stop_music()   # fades; a hard cut lands on top of the win/loss beat and reads as a bug
	_rebuild_all()
	_finish(won)


## Player-facing translation (review P0 #1: "Buba cắm sừng Gooey Slime · 5", NOT
## "[use] Puffy -> Puffy (ears/mana)"). Built from the same hit_landed payload the raw log
## line above uses, plus the face part/type cached from the most recent face_used for this
## attacker — see _on_face_used()/_last_face_used_by_uid comments.
func _player_hit_line(src_uid: int, tgt_uid: int, value: int, crit: bool) -> String:
	var src := _unit_name(src_uid)
	var tgt := _unit_name(tgt_uid)
	var cached: Dictionary = _last_face_used_by_uid.get(src_uid, {})
	var part := String(cached.get("part", ""))
	var face_type := String(cached.get("type", ""))
	var line: String
	match face_type:
		"heal":
			line = "%s hồi máu cho %s" % [src, tgt]
		"shield":
			line = "%s dựng khiên cho %s" % [src, tgt]
		"poison":
			line = "%s đầu độc %s" % [src, tgt]
		_:
			var verb: String = _PART_VERB.get(part, "tấn công")
			line = "%s %s %s" % [src, verb, tgt]
	line += " · %d" % value
	if crit:
		line += " (chí mạng)"
	return line


# ===========================================================================
# Rebuild — the single "read model, redraw" entry point (see file-level comment)
# ===========================================================================

func _rebuild_all() -> void:
	if _combat == null:
		return

	# Reconcile BEFORE reading anything: a unit that appeared since the last rebuild has no
	# portrait yet, and _update_portrait() silently returns for a uid it does not know.
	_sync_unit_visuals()
	_update_top_bar()
	_update_bottom_deck()
	_update_end_turn_ui()

	for u in _combat.party:
		_update_portrait(u)
	for e in _combat.enemies:
		_update_portrait(e)

	_update_dice_tray()


## v2 top bar — repaints every value _build_top_bar() constructed (node chip's WAVE line, wave
## track, turn pill, relic strip, shard chip) plus the undo button's own gating.
func _update_top_bar() -> void:
	_update_wave_track()
	_update_turn_pill()
	_update_relic_strip()
	_shard_value_label.text = str(RunState.shards_this_run)
	_update_undo_ui()


## WAVE progress. `total` reads RunState.map_graph's own row count (RunMapGraph.rows.size())
## rather than the web build's fixed "12" — Godot's run-map graph (run_map_generator.gd) is a
## longer branching structure (18/30 rows for short/full mode), not a linear 12-step gauntlet, so
## hardcoding 12 would misreport real run length. Falls back to a single-segment "WAVE 1" if
## map_graph is empty (e.g. t_combatview_smoke's synthetic setup, which sets
## RunState.pending_combat directly and never calls RunState.start_new_run()).
##
## Pip colouring per the redline ("Wave track"): cleared = PRIMARY, current = CREAM_HI (and one
## pip wider), future = FUTURE, the final (boss) pip = DANGER regardless of state.
func _update_wave_track() -> void:
	var graph := RunMapGraph.from_data(RunState.map_graph)
	var total := maxi(graph.rows.size(), 1)
	var current := clampi(RunState.power_level + 1, 1, total)
	_wave_label.text = "WAVE %d" % current

	while _wave_track.get_child_count() < total:
		var seg := ColorRect.new()
		_wave_track.add_child(seg)
	while _wave_track.get_child_count() > total:
		var c := _wave_track.get_child(_wave_track.get_child_count() - 1)
		_wave_track.remove_child(c)
		c.queue_free()
	for i in _wave_track.get_child_count():
		var seg: ColorRect = _wave_track.get_child(i)
		var n := i + 1
		var is_boss := n == total
		if n == current:
			seg.custom_minimum_size = Vector2(17, 12)
			seg.color = DangoTheme.CREAM_HI
		else:
			seg.custom_minimum_size = Vector2(14 if is_boss else 11, 12)
			if is_boss:
				seg.color = DangoTheme.DANGER
			elif n < current:
				seg.color = DangoTheme.PRIMARY
			else:
				seg.color = DangoTheme.FUTURE


## Turn pill — PRIMARY/ink for the player's own phase, DANGER/cream for the enemy phase (redline
## "Turn pill": "Dark ink #2A1505 on the Kam fill ... never white ... Flips to a DANGER fill for
## the enemy phase"). DangoTheme.ink_on() picks the right ink for either fill automatically.
func _update_turn_pill() -> void:
	var acting := _combat.phase != CombatPhase.END_TURN
	var bg := DangoTheme.PRIMARY if acting else DangoTheme.DANGER
	_turn_pill_style.bg_color = bg
	var ink := DangoTheme.ink_on(bg)
	_turn_dot.color = ink
	_turn_label.text = "YOUR TURN" if acting else "ENEMY TURN"
	_turn_label.add_theme_color_override("font_color", ink)
	_turn_number_label.text = "TURN %d" % _combat.turn
	_turn_number_label.add_theme_color_override("font_color", Color(ink.r, ink.g, ink.b, 0.7))


## Relic strip — rebuilt every rebuild (relic_ids essentially never changes mid-combat, but a
## relic reward/purchase mid-run means this scene is re-entered fresh each fight anyway, so a
## from-scratch rebuild here costs nothing and can never drift from `_combat.relic_ids`).
func _update_relic_strip() -> void:
	for c in _relic_strip.get_children():
		c.queue_free()
	for rid in _combat.relic_ids:
		var def: RelicDef = RelicRegistry.get_def(rid)
		if def == null:
			continue
		var color := DangoTheme.rarity_color(int(def.rarity))
		var chip := _icon_tile(null, 33.0, 0.0, DangoTheme.solid_chip_style(color, 9, 3, Vector2.ZERO))
		chip.tooltip_text = String(def.name)
		var letter := Label.new()
		letter.text = String(def.name).left(1).to_upper()
		letter.add_theme_font_size_override("font_size", 16)
		letter.add_theme_color_override("font_color", DangoTheme.ink_on(color))
		letter.mouse_filter = Control.MOUSE_FILTER_IGNORE
		(chip.get_child(0) as CenterContainer).add_child(letter)
		_relic_strip.add_child(chip)


## Undo button state — mirrors the reroll button's own gating (EXECUTE phase, not won/lost) plus
## "is there anything to undo" (CombatEngine.undo_stack, rule spec §2's own free-undo scope: it
## clears on reroll/new-turn, so an empty stack correctly disables this outside those bounds too).
func _update_undo_ui() -> void:
	_undo_button.disabled = _combat.won or _combat.lost or _combat.phase != CombatPhase.EXECUTE \
		or (_combat.undo_stack as Array).is_empty()


## v2 bottom deck — mana value, relic-active affordability, and the reroll count chip. End Turn's
## own enabled/disabled + warn state stays in _update_end_turn_ui() (unchanged call site, still
## invoked separately from _rebuild_all()).
func _update_bottom_deck() -> void:
	_mana_value_label.text = str(_combat.mana)
	_update_actives()
	_update_reroll_count()


const _ACTIVE_SLOT_CAP := 4

## Relic-active slots — mirrors the mockup's own `_activeSlots()` algorithm: up to 4 shown, a
## "+n" tile if there are more, empty dashed tiles padding out to 4 if there are fewer. No
## click-wiring (see _build_actives_card()'s scope note) — display only.
func _update_actives() -> void:
	for c in _actives_row.get_children():
		c.queue_free()

	var held: Array = []
	for rid in _combat.relic_ids:
		var def: RelicDef = RelicRegistry.get_def(rid)
		if def != null and int(def.act_cost) > 0:
			held.append(def)
	_active_count_label.text = "%d / %d" % [mini(held.size(), _ACTIVE_SLOT_CAP), _ACTIVE_SLOT_CAP]

	var overflow := held.size() > _ACTIVE_SLOT_CAP
	var shown: Array = held.slice(0, _ACTIVE_SLOT_CAP - 1 if overflow else _ACTIVE_SLOT_CAP)
	for def in shown:
		var affordable := _combat.mana >= int(def.act_cost)
		var slot := PanelContainer.new()
		slot.custom_minimum_size = Vector2(55, 55)
		slot.tooltip_text = "%s · MP %d" % [String(def.name), int(def.act_cost)]
		slot.add_theme_stylebox_override("panel", DangoTheme.solid_chip_style(
			DangoTheme.MANA_PURPLE if affordable else DangoTheme.DISABLED_FILL, 12, 2, Vector2(0, 4)))
		var col := VBoxContainer.new()
		col.alignment = BoxContainer.ALIGNMENT_CENTER
		col.add_theme_constant_override("separation", 2)
		slot.add_child(col)
		var icon := TextureRect.new()
		icon.custom_minimum_size = Vector2(22, 22)
		icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		icon.texture = _ICON_MANA   # relics have no per-active icon field yet — see task report
		icon.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		col.add_child(icon)
		var cost := Label.new()
		cost.text = "MP %d" % int(def.act_cost)
		cost.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		cost.add_theme_font_size_override("font_size", 12)
		cost.add_theme_color_override("font_color",
			DangoTheme.INK if affordable else Color(1.0, 0.604, 0.588))
		col.add_child(cost)
		_actives_row.add_child(slot)

	if overflow:
		var more := _icon_tile(null, 55.0, 0.0,
			DangoTheme.solid_chip_style(DangoTheme.PANEL_RAISED, 12, 2, Vector2.ZERO))
		var more_label := Label.new()
		more_label.text = "+%d" % (held.size() - _ACTIVE_SLOT_CAP + 1)
		more_label.add_theme_color_override("font_color", Color(0.78, 0.733, 0.839))
		(more.get_child(0) as CenterContainer).add_child(more_label)
		_actives_row.add_child(more)
	else:
		for _i in range(shown.size(), _ACTIVE_SLOT_CAP):
			var empty := PanelContainer.new()
			empty.custom_minimum_size = Vector2(55, 55)
			empty.add_theme_stylebox_override("panel", DangoTheme.solid_chip_style(
				Color(0x16 / 255.0, 0x1A / 255.0, 0x22 / 255.0), 12, 2, Vector2.ZERO))
			_actives_row.add_child(empty)


## Reroll count chip — PRIMARY/ink while any rerolls remain, WELL_TRACK/dim once they run out
## (mirrors the mockup's own `rerollBg`/`rerollFg`). Also where the reroll button's own
## enabled/disabled state is set — unchanged gating from the pre-v2 pass.
func _update_reroll_count() -> void:
	var n := _combat.rerolls
	_reroll_count_label.text = "×%d" % n
	var bg := DangoTheme.PRIMARY if n > 0 else DangoTheme.WELL_TRACK
	_reroll_count_style.bg_color = bg
	_reroll_count_label.add_theme_color_override("font_color",
		DangoTheme.INK_ON_PRIMARY if n > 0 else Color(0x5C / 255.0, 0x65 / 255.0, 0x73 / 255.0))
	_reroll_button.disabled = _combat.won or _combat.lost or n <= 0 or _combat.phase != CombatPhase.EXECUTE


## End Turn warning state (still a colour-only warn, unchanged from the pre-v2 pass). Re-evaluated
## every rebuild, not just on press — the button already looks like a warning before the player
## even clicks it. No longer forces a font colour: End Turn's label is now a real child Label
## inked INK_ON_PRIMARY once in _style_end_turn_button(), not Button.text/font_color — see that
## function's comment for where the old ~2.2:1 white-on-orange pairing was actually removed.
func _update_end_turn_ui() -> void:
	var has_unused := false
	for u in _party_dice_units():
		if u.hp > 0 and u.has_rolled() and not u.roll_used():
			has_unused = true
			break
	var warn := has_unused and _combat.phase == CombatPhase.EXECUTE and not (_combat.won or _combat.lost)
	DangoTheme.style_button(_end_turn_button, true, warn)
	_end_turn_button.disabled = _combat.won or _combat.lost


func _update_portrait(u: Unit) -> void:
	var p: UnitPortrait = _portraits.get(u.uid)
	if p == null:
		return
	p.update_stats(u.hp, u.max_hp, u.shield, u.status)
	_stage3d.set_alive(u.uid, u.hp > 0)

	var hud: UnitHeadHUD = _head_huds.get(u.uid)
	if hud != null:
		hud.visible = u.hp > 0
		hud.set_status(u.status)
		if u.side == "e":
			_apply_intent_to_hud(hud, u)
		else:
			hud.set_intent(false, "", 0, "")

	var is_selected := (u.uid == _selected_die_uid)
	p.set_selected(is_selected)
	if not is_selected:
		var targetable := _selected_die_uid != -1 and u.hp > 0
		p.set_targetable(targetable)
		_stage3d.set_targetable(u.uid, targetable)


## Enemy intent is public information by design (rule spec §2 "minh bạch triệt để") — safe to
## read directly off the Unit even before any playback system exists.
func _apply_intent_to_hud(hud: UnitHeadHUD, u: Unit) -> void:
	if u.hp <= 0 or u.intent.is_empty():
		hud.set_intent(false, "", 0, "")
		return
	var fi := int(u.intent.get("face_index", -1))
	if fi < 0 or fi >= u.die.size():
		hud.set_intent(false, "", 0, "")
		return
	var f: Dictionary = u.die[fi]
	var tgt_uid := int(u.intent.get("target_uid", -1))
	var tgt_name := _unit_name(tgt_uid) if tgt_uid >= 0 else "?"
	hud.set_intent(true, String(f.get("type", "")), int(f.get("value", 0)), tgt_name)


func _update_dice_tray() -> void:
	var units := _party_dice_units()
	for i in _die_slot_buttons.size():
		var btn: Button = _die_slot_buttons[i]
		var content: Dictionary = _die_slot_content[i]
		if i >= units.size():
			btn.visible = false
			(content.root as VBoxContainer).visible = false
			continue
		var u: Unit = units[i]
		btn.visible = true
		(content.root as VBoxContainer).visible = true

		# Header (portrait badge/name/READY-SPENT-DEAD) and the six-face track are always
		# repainted, in every state — task defect 1 wants name/HP/die-composition visible even
		# for a dead/not-yet-rolled/spent card, not just for a usable one.
		_update_die_slot_header(content, u)
		_update_face_track(content, u)

		var usable := u.hp > 0 and u.has_rolled() and not u.roll_used()
		var used_this_turn := u.hp > 0 and u.has_rolled() and u.roll_used()
		btn.disabled = not usable
		var is_sel := (u.uid == _selected_die_uid)
		btn.button_pressed = is_sel

		# v2 "Die card · selected" redline: SPENT drops the card to opacity .55 and ignores
		# hover; a dead unit's card (no `roll_used` opinion of its own since it can never be
		# selected either way) gets the same treatment by extension — FLAGGED: the mockup has no
		# "dead die" state to copy, this reuses the SPENT look rather than inventing a third one.
		# `used_this_turn`/`u.hp<=0` STILL shows the card's real content (see below) — the pre-v2
		# card swapped to a blank "(đã dùng)" placeholder here, which the mockup's own SPENT
		# example (Pomodoro) contradicts: it renders the last-rolled face, just dimmed.
		(content.root as VBoxContainer).modulate = (
			Color(1, 1, 1, 0.55) if (used_this_turn or u.hp <= 0) else Color(1, 1, 1, 1))

		_update_die_slot_content(content, u)
		btn.add_theme_stylebox_override("normal", _die_slot_base_style)
		btn.add_theme_stylebox_override("hover", _die_slot_base_style)
		btn.add_theme_stylebox_override("disabled", _die_slot_base_style)
		# Selected slots have button_pressed=true (toggle_mode) — must override "pressed"/
		# "focus" too, or Godot falls back to the theme default for those states (see the
		# same note in _connect_ui_buttons()).
		btn.add_theme_stylebox_override("pressed", _die_slot_base_style)
		btn.add_theme_stylebox_override("focus", _die_slot_base_style)

		var show_ring := is_sel   # SPENT/dead never reach here selected — _selected_die_uid is
			# cleared on use elsewhere — but guard explicitly rather than trust call order.
		(content.sel_ring_outer as Panel).visible = show_ring
		(content.sel_ring_inner as Panel).visible = show_ring

		_update_die_slot_lift(btn, i, is_sel)
		_maybe_play_roll_juice(u, btn)
		_maybe_play_die_used_flip(u, btn)


## Shared "nothing to show but a caption" state (dead / not-rolled-yet — NOT spent any more, see
## _update_dice_tray()'s comment) — hides `face_area` (FaceRow+KeywordRow+FaceTrack as one unit)
## and shows only `plain_label`. Does NOT touch header_bg/name_label — those stay visible in
## every state, see _update_die_slot_header(), called unconditionally before this runs.
func _show_die_slot_plain(content: Dictionary, text: String) -> void:
	(content.plain_label as Label).text = text
	(content.plain_label as Label).visible = true
	(content.face_area as VBoxContainer).visible = false


## Header repaint (redline "Die card": "26px round portrait + name at FONT_DISPLAY 18/800"). No
## READY/SPENT/DEAD word any more — see _build_die_slot_content()'s class comment for why v2
## drops it. Called every rebuild for every slot, regardless of roll state, so name/portrait/class
## colour stay visible even while dead/not-yet-rolled/spent.
func _update_die_slot_header(content: Dictionary, u: Unit) -> void:
	(content.portrait_rect as TextureRect).texture = _class_portrait(u.cls)
	var name_label: Label = content.name_label
	# Tier as a roman numeral rather than as a different portrait. The rig has no per-tier
	# appearance at all (CombatStage3D._build_parts() uses one fixed part variant and one colour
	# per class), so rendering "6 classes x 3 tiers" would produce twelve duplicate images
	# pretending to be distinct. T1 shows nothing: every Axie starts there, so the marker only
	# earns its space once it means something.
	var base := "%s%s" % [u.n, _TIER_SUFFIX.get(u.tier, "")]
	name_label.text = "%s ★" % base if u.roll_crit_now() else base

	var header_bg: PanelContainer = content.header_bg
	var style := header_bg.get_theme_stylebox("panel") as StyleBoxFlat
	style.bg_color = DangoTheme.class_color(u.cls)


## Six-face track repaint — `Unit.die` is the fixed 6-face composition (set once at spawn, never
## reshuffled mid-combat, unlike `rolled` which only tracks this turn's single active face — see
## unit.gd's own field comments). v2 "Die card" redline: "six 10px bars, the rolled one in its
## type colour, the rest CREAM_TRACK" — a flat colour fill per bar, no icon (see
## _build_die_slot_content()'s FLAGGED comment on why the pre-v2 per-cell icon is dropped).
func _update_face_track(content: Dictionary, u: Unit) -> void:
	var panels: Array = content.face_panels
	var current_fi := u.roll_face_index() if u.has_rolled() else -1
	for i in panels.size():
		var panel: PanelContainer = panels[i]
		if i >= u.die.size():
			panel.visible = false
			continue
		panel.visible = true
		var f: Dictionary = u.die[i]
		var col := (DangoTheme.die_type_color(String(f.get("type", "")))
			if i == current_fi else DangoTheme.CREAM_TRACK)
		panel.add_theme_stylebox_override("panel", DangoTheme.solid_chip_style(col, 5, 2, Vector2.ZERO))


## Rich per-face content (redline "Die card": part-icon tile, value, face-type tile+glyph,
## PART · TYPE caption, keyword pills, six-bar track). Mirrors src/client.html's paintDieFace()/
## FT_IC/FT_COLOR/DIE_LABEL/kwText() tables — see the class-level consts' header comments. Called
## for every non-empty slot regardless of roll state; dead/not-rolled fall back to
## _show_die_slot_plain() (nothing has_rolled() to display), everything else (including SPENT —
## see _update_dice_tray()) shows the real face, dimmed by the caller's `modulate` instead.
func _update_die_slot_content(content: Dictionary, u: Unit) -> void:
	var plain_label: Label = content.plain_label
	var face_area: VBoxContainer = content.face_area
	var value_label: Label = content.value_label
	var part_icon_rect: TextureRect = content.part_icon_rect
	var type_tile: PanelContainer = content.type_tile
	var type_icon_rect: TextureRect = content.type_icon_rect
	var caption_label: Label = content.caption_label
	var kw_row: HBoxContainer = content.kw_row

	if u.hp <= 0:
		_show_die_slot_plain(content, "(gục)")
		return
	if not u.has_rolled():
		_show_die_slot_plain(content, "(chưa roll)")
		return

	plain_label.visible = false
	face_area.visible = true
	for c in kw_row.get_children():
		c.queue_free()

	var fi := u.roll_face_index()
	var f: Dictionary = u.die[fi]
	var face_type := String(f.get("type", ""))
	var value := int(f.get("value", 0))
	var col := DangoTheme.die_type_color(face_type)

	type_icon_rect.texture = _face_icon_for(face_type)
	(type_tile.get_theme_stylebox("panel") as StyleBoxFlat).bg_color = col

	# value<=0 faces (buff/debuff always roll value=0 in ContentDB) hide the number — a "0" badge
	# would misleadingly read as "does nothing" — same guard the old corner-badge logic used.
	value_label.visible = value > 0
	if value_label.visible:
		value_label.text = str(value)

	var part := String(f.get("part", ""))
	var part_icon := _part_icon_for(part, u.cls)   # body-part icon (web/part/<slot>_<class>.svg)
	part_icon_rect.texture = part_icon
	part_icon_rect.visible = part_icon != null
	caption_label.text = "%s · %s" % [
		String(_PART_LABEL.get(part, part.to_upper())),
		String(_DIE_TYPE_LABEL.get(face_type, face_type.to_upper())),
	]

	for k in (f.get("keywords", []) as Array):
		var kw_name := String(k).split(":")[0]
		var chip := PanelContainer.new()
		chip.mouse_filter = Control.MOUSE_FILTER_IGNORE
		chip.custom_minimum_size = Vector2(0, 20)
		chip.add_theme_stylebox_override("panel",
			DangoTheme.solid_chip_style(col, 999, 3, Vector2(7, 0)))
		var lbl := DangoTheme.display_label(
			String(_KEYWORD_LABEL.get(kw_name, kw_name.to_upper())), 12, DangoTheme.ink_on(col), 800)
		lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
		chip.add_child(lbl)
		kw_row.add_child(chip)


## Lift (redline "Die card · selected": translateY(-16px)) — a `position` tween on the Button
## itself. Safe against GridContainer's own layout pass because this only runs from
## _update_dice_tray() (part of the sanctioned full-rebuild path), the same pattern
## _play_die_roll_bounce() below already uses for scale/rotation on these same buttons without a
## Container fighting it back. TRANS_BACK/EASE_OUT approximates the redline's
## cubic-bezier(.2,.9,.3,1.3) overshoot — Godot's Tween has no arbitrary-bezier easing.
func _update_die_slot_lift(btn: Button, i: int, lifted: bool) -> void:
	if _die_slot_lifted[i] == lifted:
		return
	_die_slot_lifted[i] = lifted
	var target_y := -_DIE_LIFT_PX if lifted else 0.0
	if disable_juice_for_tests or not btn.is_inside_tree():
		btn.position.y = target_y
		return
	var tw := create_tween()
	tw.tween_property(btn, "position:y", target_y, _DIE_LIFT_DURATION) \
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT if lifted else Tween.EASE_IN)


## Flip-on-use juice (review P1 #6). Detects the unused->used transition here (inside
## _update_dice_tray(), part of the sanctioned full-model-read path — same rationale
## _maybe_play_roll_juice() below already documents for why this isn't a signal handler).
func _maybe_play_die_used_flip(u: Unit, btn: Button) -> void:
	var used_now := u.hp > 0 and u.has_rolled() and u.roll_used()
	var was_used: bool = _last_die_used.get(u.uid, false)
	_last_die_used[u.uid] = used_now
	if used_now and not was_used:
		_play_die_flip(btn)


func _play_die_flip(btn: Button) -> void:
	if disable_juice_for_tests or not is_instance_valid(btn) or not btn.is_inside_tree():
		return
	btn.pivot_offset = btn.size * 0.5
	var tw := create_tween()
	tw.tween_property(btn, "scale:x", 0.0, _DIE_FLIP_DURATION * 0.5)
	tw.tween_property(btn, "scale:x", 1.0, _DIE_FLIP_DURATION * 0.5)


## Roll-bounce juice (unchanged from the pre-review pass — see original file history/report for
## why this lives here instead of a signal handler: EventBus has no dedicated "die just
## rolled" signal with the right payload).
func _maybe_play_roll_juice(u: Unit, btn: Button) -> void:
	if not u.has_rolled():
		_last_die_face.erase(u.uid)
		return
	var fi := u.roll_face_index()
	var prev = _last_die_face.get(u.uid, null)
	_last_die_face[u.uid] = fi
	if prev == null or prev == fi:
		return
	_play_die_roll_bounce(btn)


func _play_die_roll_bounce(btn: Button) -> void:
	if disable_juice_for_tests:
		return
	if not is_instance_valid(btn) or not btn.is_inside_tree():
		return
	btn.pivot_offset = btn.size * 0.5
	var tw := create_tween()
	tw.tween_property(btn, "scale", Vector2(_ROLL_ANIM_SCALE, _ROLL_ANIM_SCALE), _ROLL_ANIM_DURATION * 0.5)
	tw.parallel().tween_property(btn, "rotation_degrees", randf_range(-8.0, 8.0), _ROLL_ANIM_DURATION * 0.5)
	tw.tween_property(btn, "scale", Vector2.ONE, _ROLL_ANIM_DURATION * 0.5)
	tw.parallel().tween_property(btn, "rotation_degrees", 0.0, _ROLL_ANIM_DURATION * 0.5)


## Hit-stop + screen shake (unchanged from the pre-review pass).
func _play_hit_juice() -> void:
	if flashes_suppressed():
		return
	var end_anim := _begin_hit_animation()
	if is_inside_tree():
		await get_tree().create_timer(_HITSTOP_DURATION).timeout
	if is_instance_valid(_stage3d):
		await _stage3d.shake(_SHAKE_AMPLITUDE, _SHAKE_DURATION)
	end_anim.call()


## Input lock (unchanged from the pre-review pass).
func _begin_hit_animation() -> Callable:
	_hit_anim_count += 1
	_is_animating = true
	var released := false
	var release := func():
		if released:
			return
		released = true
		_hit_anim_count = maxi(_hit_anim_count - 1, 0)
		_is_animating = _hit_anim_count > 0
	if is_inside_tree():
		get_tree().create_timer(_INPUT_LOCK_FAILSAFE).timeout.connect(release)
	else:
		release.call()
	return release


func _party_dice_units() -> Array:
	var out: Array = []
	for u in _combat.party:
		if u.roster_index >= 0:
			out.append(u)
	out.sort_custom(func(a, b): return a.roster_index < b.roster_index)
	return out


func _unit_name(uid: int) -> String:
	if _combat == null:
		return "?"
	var u := _combat.by_uid(uid)
	return u.n if u != null else "uid#%d" % uid


func _append_log(line: String) -> void:
	_log_lines.append(line)
	if _log_lines.size() > _MAX_LOG_LINES:
		_log_lines.pop_front()
	_log_panel.text = "\n".join(_log_lines)


# ===========================================================================
# Win/Lose — unchanged handoff contract from the skeleton stage (architecture plan §4).
# ===========================================================================

func _finish(won: bool) -> void:
	if _result_shown:
		return
	_result_shown = true
	RunState.apply_combat_result(_combat.get_result())   # unchanged position/ordering relative
		# to the pre-animation-pass code — only the win branch below now awaits the march before
		# its own overlay/scene-change lines; this call itself is not delayed.
	if won:
		# Juice pass B: let the surviving party actually march off the field before cutting to
		# RunMap, instead of the previous same-frame overlay-then-scene-change (which meant the
		# "BẠN THẮNG" overlay was never actually visible for a frame in practice). See
		# _play_victory_march()/CombatStage3D.play_victory_march().
		await _play_victory_march()
		_result_overlay.visible = true
		# apply_combat_result() (above) already decided WON vs. a normal win-with-rewards:
		# defeating the run's FINAL boss sets RunState.phase to WON directly (src/engine.js
		# finishCombat() never offers a reward on that path either) — that's the run-complete
		# screen, not the map. RunState.after_node() is deliberately NOT called here for the
		# ordinary-win case: src/engine.js's takeReward() advances s.pw/s.phase strictly AFTER
		# the player picks a reward, so after_node() now only runs from
		# RunMapController._on_reward_chosen(), once a card is actually picked (see
		# RunState._generate_post_combat_rewards()'s ordering-fix note). This scene only ever
		# changes scene; it never advances run state on the ordinary-win path.
		if RunState.phase == RunState.RunPhase.WON:
			_result_label.text = "BẠN THẮNG — RUN COMPLETE"
			get_tree().change_scene_to_file("res://scenes/result/Result.tscn")
		else:
			_result_label.text = "BẠN THẮNG"
			get_tree().change_scene_to_file("res://scenes/run_map/RunMap.tscn")
	else:
		_result_overlay.visible = true
		_result_label.text = "BẠN THUA"
		get_tree().change_scene_to_file("res://scenes/result/Result.tscn")


## Gathers the currently-alive party (dead members already faded out via play_death() and should
## not un-hide/move) and hands their uids to CombatStage3D's actual Tween/anim-clip logic.
func _play_victory_march() -> void:
	if not is_instance_valid(_stage3d) or _combat == null:
		return
	var uids: Array = []
	for u in _combat.party:
		if u.hp > 0:
			uids.append(u.uid)
	await _stage3d.play_victory_march(uids, _VICTORY_MARCH_DISTANCE, _VICTORY_MARCH_DURATION)
