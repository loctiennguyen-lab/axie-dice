func _ready() -> void:
	get_tree().root.size_changed.connect(_on_window_resized)
	_setup = RunState.pending_combat
	RunState.pending_combat = {}
	_tutorial = bool(_setup.get("tutorial", false))
	# CONTINUE RUN enters this scene straight from the main menu, so nobody has called
	# RunState.enter_node() and pending_combat is empty. Everything _setup is read for —
	# node_id, kind, pw, combat_seed — is already inside the saved engine snapshot, so rebuild
	# it from there rather than requiring the map to be walked again just to produce it.
	if _setup.is_empty() and not RunState.resume_combat.is_empty():
		_setup = _setup_from_snapshot(RunState.resume_combat)
	assert(not _setup.is_empty(), "Combat.tscn entered with no pending_combat set — " +
		"RunMapController must call RunState.enter_node() with a combat node_kind first")

	# Shell (FIX-PASS-02 §1 item 4 / godot/CLAUDE.md rule 2) — the first UI-building statement,
	# right after the setup/assert above, which has to run first regardless. `plate=null`:
	# Combat's real plate is BattleBackdrop's own art (`%Background`, `_build_stage_background()`
	# below), not a static texture known at this point — see `_shell_root`'s doc comment for why
	# this targets `%Root` rather than `self`, and why `plate=null` is intentional here rather
	# than fighting BattleBackdrop for the same visual with a second background. No footer
	# (Combat owns its own chrome); `combat=true` so any future plate this shell draws grades at
	# combat's darker/less-saturated brightness, matching `_grade_stage_art()` below.
	# Local replacement for the old Dango shell: a click-through PlateHost carrying the default
	# radial scrim (same stops as before, so the board looks identical) and the empty,
	# click-through Content column t_combat_hit_targets.gd asserts against. The scrim must sit
	# BEHIND the real children, so PlateHost is moved to index 0.
	_shell_root.set_anchors_preset(Control.PRESET_FULL_RECT)
	var _shell_plate_host := Control.new()
	_shell_plate_host.name = "PlateHost"
	_shell_plate_host.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_shell_plate_host.set_anchors_preset(Control.PRESET_FULL_RECT)
	_shell_root.add_child(_shell_plate_host)
	var _shell_scrim := TextureRect.new()
	_shell_scrim.name = "Scrim"
	_shell_scrim.texture = _scrim_gradient([0.0, 0.52, 1.0], [0.04, 0.40, 0.84], true)
	_shell_scrim.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	_shell_scrim.stretch_mode = TextureRect.STRETCH_SCALE
	_shell_scrim.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_shell_scrim.set_anchors_preset(Control.PRESET_FULL_RECT)
	_shell_plate_host.add_child(_shell_scrim)
	var _shell_content := Control.new()
	_shell_content.name = "Content"
	_shell_content.set_anchors_preset(Control.PRESET_FULL_RECT)
	_shell_content.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_shell_root.add_child(_shell_content)
	_shell_root.move_child(_shell_plate_host, 0)

	_build_stage_background()
	_connect_event_bus()
	_build_hud_r1()
	_style_turn_banner()
	_connect_ui_buttons()
	_layout_stage_bands()
	# `expand` lets the canvas grow vertically, so the enemy/party bands and the front line
	# between them have to be re-derived whenever the window changes shape.
	get_viewport().size_changed.connect(_layout_stage_bands)

	_audio = CombatAudioDirector.new()
	_audio.name = "CombatAudioDirector"
	_dm_audio = DiceMomentAudio.new()
	_dm_audio.name = "DiceMomentAudio"
	add_child(_dm_audio)
	add_child(_audio)   # must be in the tree (and so past its _ready) before _spawn_portrait()
		# starts calling register_unit() below

	_combat = CombatEngine.new()
	_core_float_live = {}   # new fight: no Core note from the last one is still stacked
	# The run owns the log; the combat only writes into it. Set before any action can be taken,
	# and on the resume path too — a fight resumed from a save is the same run, and a log with a
	# hole in the middle is not evidence of anything. A TUTORIAL fight is not part of any run,
	# so it gets a log of its own: appending rehearsal moves to the run's log would put actions
	# into the replay-verify record that the run never actually took.
	_combat.action_log = ActionLog.new() if _tutorial else RunState.action_log
	# CONTINUE RUN: a run saved mid-fight carries the whole CombatEngine snapshot, and restoring
	# it is not the same thing as starting the node again — setup_new() would re-roll the
	# encounter and hand the player a fresh, full-health enemy line-up for a fight they were
	# halfway through winning. JS resumes the same way (client.html:3996 drops straight back to
	# screen='combat' with the saved `s`).
	var resumed: Dictionary = RunState.resume_combat
	RunState.resume_combat = {}
	if not resumed.is_empty():
		_combat.from_data(resumed)
		_combat.set_epoch(RunState.epoch)   # a resumed fight keeps the run's epoch source
		_append_log("=== combat RESUMED from save: node=%s turn=%d ===" % [_combat.node_id, _combat.turn])
	else:
		_combat.setup_new(_setup)
	_max_rerolls = _combat.max_rerolls

	# One path builds the board, at t=0 and at every later spawn alike. Two separate paths is
	# what let units that JOIN a fight (gooey_king's SPLIT, summoner adds, Axie Eggs) ship with
	# no nameplate, no HP bar and no sound: `_ready()` was the only place that ever built one.
	_stage3d.set_encounter_kind(String(_setup.get("kind", "")))
	_sync_unit_visuals()

	# Pick the backdrop from where this fight sits in the run, so an 18-row run reads as a
	# journey instead of eighteen fights on the same patch of desert. The row comes from the
	# map graph rather than from power_level: power_level counts every node type, so it drifts
	# away from the row number as soon as the player takes an event or a shop.
	_backdrop.show_for_node(_current_map_row(), String(_setup.get("kind", "")) == "boss")
	_apply_arena_for_node()
	_grade_stage_art()
	# Same two inputs the backdrop uses, so picture and music agree about which fight this is.
	# The track itself is chosen from the node id's hash, never randomly — see CombatAudio.
	_audio.start_music(String(_setup.get("node_id", "")),
		String(_setup.get("kind", "")) == "boss")

	_append_log("=== combat start: node=%s kind=%s pw=%d seed=%d ===" % [
		_setup.get("node_id", "?"), _setup.get("kind", "?"), _setup.get("pw", -1), _setup.get("combat_seed", -1)])
	_rebuild_all()
	_save_run_progress()   # quitting before the first click still resumes INTO this fight,
		# rather than back onto the map with the node not yet entered


func _process(_delta: float) -> void:
	_layout_unit_visuals()


## The CombatSetup fields this scene reads, recovered from a saved CombatEngine snapshot.
## Deliberately NOT the full setup shape: `roster_snapshot`/`relic_ids` are only an input to
## setup_new(), which a resumed fight never calls — the units and relics come back inside the
## snapshot itself. Including them would invite someone to believe this is a setup you could
## start a fresh fight from.
func _setup_from_snapshot(snap: Dictionary) -> Dictionary:
	return {
		"node_id": String(snap.get("node_id", "")),
		"kind": String(snap.get("kind", "battle")),
		"pw": int(snap.get("pw", 0)),
		"ascension": int(snap.get("ascension", 0)),
		"combat_seed": int(snap.get("combat_seed", 0)),
	}


## The RunMap row this combat's node sits on, or 1 when there is no map to ask (DevReview and
## the QA capture scenes enter Combat.tscn directly, without a run).
func _current_map_row() -> int:
	var node_id := String(_setup.get("node_id", ""))
	if node_id == "" or RunState.map_graph.is_empty():
		return 1
	var node := RunMapGraph.from_data(RunState.map_graph).find_node(node_id)
	return node.row if node != null else 1


## Builds the 3D arena for this fight (CombatStage3D.set_arena_for_node: pure of row / boss /
## total rows, no RNG). Skipped when there is no map to ask (tutorial, DevReview, test combat),
## which leaves the flat 2D backdrop. Runs once per combat, so the graph is parsed once.
func _apply_arena_for_node() -> void:
	var node_id := String(_setup.get("node_id", ""))
	if node_id == "" or RunState.map_graph.is_empty():
		return
	var graph := RunMapGraph.from_data(RunState.map_graph)
	var node := graph.find_node(node_id)
	if node == null or graph.rows.is_empty():
		return
	_stage3d.set_arena_for_node(node.row, String(_setup.get("kind", "")) == "boss", graph.rows.size())


func _exit_tree() -> void:
	Engine.time_scale = 1.0   # never leave a hit-stop behind
	_stage3d.dispose_all()


## True while the party runs to the gate after a win; any click / Space / Enter / Esc skips it.
var _exit_running := false


func _input(event: InputEvent) -> void:
	if not _exit_running:
		return
	var skip := false
	if event is InputEventMouseButton:
		skip = (event as InputEventMouseButton).pressed
	elif event is InputEventKey:
		var k := event as InputEventKey
		KeyBindings.ensure()
		skip = k.pressed and not k.echo and (event.is_action_pressed(KeyBindings.COMBAT_END_TURN) \
			or event.is_action_pressed(KeyBindings.MENU_BACK) or [KEY_SPACE, KEY_ENTER, KEY_KP_ENTER].has(k.keycode))
	if skip:
		_stage3d.skip_victory_march()
		if is_inside_tree():   # a handler above may have changed scene
			get_viewport().set_input_as_handled()


func _unhandled_key_input(event: InputEvent) -> void:
	if pause_menu_open():
		return   # the pause plate owns the keyboard (its own Esc = Resume)
	if event is InputEventKey and event.pressed and not (event as InputEventKey).echo:
		KeyBindings.ensure()
		# Keys are InputMap actions (scripts/ui/key_bindings.gd, rebindable in Settings > Controls).
		# Defaults: Space/E end the turn, Z undoes, R rerolls, 1-5 pick a die, A Aid, I inspect, Esc menu.
		var die := -1
		for i in KeyBindings.DIE_ACTIONS.size():
			if event.is_action_pressed(KeyBindings.DIE_ACTIONS[i]):
				die = i
				break
		if event.is_action_pressed(KeyBindings.COMBAT_END_TURN) and not _end_turn_button.disabled \
				and not _is_animating:
			_on_end_turn_pressed()
		elif event.is_action_pressed(KeyBindings.COMBAT_UNDO) and not _undo_button.disabled and not _is_animating:
			_on_undo_pressed()
		elif event.is_action_pressed(KeyBindings.COMBAT_HOLD) and not _is_animating and _hud_frame != null \
				and _hud_frame.hold_button != null and not _hud_frame.hold_button.disabled:
			_on_hold_pressed()
		elif die >= 0 and not _is_animating:
			_on_die_slot_pressed(die)
		elif event.is_action_pressed(KeyBindings.COMBAT_REROLL):
			# Reroll key rerolls; while the dice are in the air it only lands them.
			if _dice_in_air():
				_land_dice_now()
			elif not _reroll_button.disabled:
				_on_reroll_pressed()
		elif event.is_action_pressed(KeyBindings.COMBAT_AID) and _aid != null and _aid.enabled and not _aid.modal_open():
			_aid.toggle_tray()
		elif event.is_action_pressed(KeyBindings.MENU_BACK) and _wild_mode:
			_exit_wild_mode()
		elif event.is_action_pressed(KeyBindings.MENU_BACK) and _rr_mode:
			_exit_rr_mode()
		elif event.is_action_pressed(KeyBindings.MENU_BACK) and _aid != null and _aid.handle_escape():
			pass
		elif event.is_action_pressed(KeyBindings.MENU_BACK) and _inspect_panel != null and is_instance_valid(_inspect_panel):
			_close_unit_inspect()
		elif event.is_action_pressed(KeyBindings.COMBAT_INSPECT):
			_inspect_hotkey()
		elif event.is_action_pressed(KeyBindings.MENU_BACK):
			# The only way out of a fight now that combat-v2.html's four-chip utility row has no
			# Quit button. Esc opens the in-run pause menu (UI-03 14, same as the run map); "Leave the fight" in the
			# info menu still has the save-and-quit confirm.
			open_run_menu()


# ===========================================================================
# Setup
# ===========================================================================

## v2 stage background (design_handoff_axie_dice_ui §00 "the art lives" / §03 "Stage background"
## — do this FIRST, every other value on this screen was tuned against it). Two layers, per the
## handoff's own formula: the painted plate graded brighter (`the plate grade shader`) and a
## DIRECTIONAL scrim on top (`_scrim_gradient()`) — dark under the top bar and the deck,
## open through the band where the models stand — replacing the old radial vignette + flat bottom
## gradient this superseded (both built at runtime here before this pass; %Vignette/%BottomGradient
## no longer exist in Combat.tscn, see that file and the treeNotes in the task brief).
##
## Split into two functions because the plate's own TextureRect is owned by BattleBackdrop.gd (not
## a file this pass may edit — see _grade_stage_art()'s own comment for why), and that file only
## creates it once `show_for_node()` has actually picked and loaded an image, which happens later
## in _ready() than everything else built here.
func _build_stage_background() -> void:
	_scrim.texture = _scrim_gradient([0.0, 0.26, 0.52, 0.80, 1.0], [0.62, 0.20, 0.10, 0.50, 0.76], false)
	_scrim.stretch_mode = TextureRect.STRETCH_SCALE


## Applies the v2 colour grade (saturate(1.02) brightness(.74)) to the painted plate BattleBackdrop
## just loaded. Called right after `_backdrop.show_for_node(...)` in _ready() — that is the first
## point at which BattleBackdrop.gd has actually built its internal art TextureRect.
##
## FILE-OWNERSHIP NOTE: BattleBackdrop.gd is not in this pass's "files you own" list, and it keeps
## its own art TextureRect as a private `_image` with no public accessor. `show_for_node()` is
## guaranteed (by that file's own `_build()`) to have added exactly one TextureRect child by the
## time this runs, so reaching it as `get_child(0)` is the only way to grade it without editing
## that script. If BattleBackdrop.gd's internal structure ever changes, this needs revisiting
## together with whoever owns that file (coordination-rules.md #5, "No Unilateral Cross-Domain
## Changes") — ideally by BattleBackdrop.gd growing a real `set_material()`/`art_texture_rect()`.
func _grade_stage_art() -> void:
	if _backdrop.get_child_count() == 0:
		return
	var art := _backdrop.get_child(0)
	if art is CanvasItem:
		var mat := ShaderMaterial.new()
		mat.shader = load("res://resources/shaders/plate_grade.gdshader")
		mat.set_shader_parameter("brightness", 0.74)
		mat.set_shader_parameter("saturation", 1.02)
		(art as CanvasItem).material = mat


## The top bar's four utility chips share one box. combat-v2.html draws them as a fixed row of
## `UNDO · INFO · LOG · ♪`, and every one of them is the same 33px chip; a helper keeps the four
## call sites from drifting the way the five call sites before them did.
##
## 33 content + a 3px border on each edge = 39 outer. The shard chip beside them is the same
## height by the same arithmetic.
const _UTIL_CHIP := 39.0
## Axie class band colours for the reroll dice: tokens color.class_<plant|beast|aqua|reptile|bug|bird>
## (design/art/palette-measured.md). t_ui_laws reads the same tokens.
static func _class_color(cls: String) -> Color:
	var k := cls.strip_edges().to_lower()
	if not (UI3Theme.tokens().get("color", {}) as Dictionary).has("class_" + k):
		return UI3Theme.color("accent")
	return UI3Theme.color("class_" + k)


const _SCRIM_INK := Color(0x24 / 255.0, 0x14 / 255.0, 0x0B / 255.0)


## The stage scrim: ink at `alphas` along `offsets`. `radial` = the default corner-lit radial;
## otherwise a top-to-bottom linear ramp (dark under the top bar and the deck, open mid-board).
static func _scrim_gradient(offsets: Array, alphas: Array, radial: bool) -> GradientTexture2D:
	var grad := Gradient.new()
	grad.offsets = PackedFloat32Array(offsets)
	var cols := PackedColorArray()
	for a in alphas:
		cols.append(Color(_SCRIM_INK.r, _SCRIM_INK.g, _SCRIM_INK.b, float(a)))
	grad.colors = cols
	var tex := GradientTexture2D.new()
	tex.width = 256
	tex.height = 256
	tex.gradient = grad
	if radial:
		tex.fill = GradientTexture2D.FILL_RADIAL
		tex.fill_from = Vector2(0.55, 0.08)
		tex.fill_to = Vector2(1.80, 1.03)
	else:
		tex.fill = GradientTexture2D.FILL_LINEAR
		tex.fill_from = Vector2(0.5, 0.0)
		tex.fill_to = Vector2(0.5, 1.0)
	return tex
func _utility_chip_style(fill: Color, border_w: int = 3) -> StyleBoxFlat:
	# `padding:0 11px` INSIDE a 3px border. A StyleBoxFlat's content margin is measured from the
	# OUTER edge and replaces the border, so the mockup's 11 is written here as 11 + 3. Getting
	# this backwards costs one border width of inset on every chip at once — the convention is
	# spelled out in RunMapController's own PADDING CONVENTION note.
	return UI3Theme.flat(fill, 9, 0, Color.TRANSPARENT, Vector4(11.0 + border_w, 0, 11.0 + border_w, 0))


## Top-bar utility chip, per combat-v2.html's `utils` row: height 33, min-width 33, padding
## 0 11, radius 9, PANEL_RAISED on a 3px black outline, NO shelf (these sit IN the bar, they do
## not float above it), label at Baloo 13/800. Hover fills PRIMARY and re-inks.
##
## Supersedes the 40px-tall `style_button(secondary)` chrome this used to wear: that helper's
## radius (12), padding (14/7) and shelf (4) are the REROLL button's shape, not this one's.
func _style_utility_button(btn: Button) -> void:
	# `height:33px; min-width:33px` are the CONTENT box; the 3px black border adds outside them,
	# so the chip is 39x39 outer. It was set to 33x33, which is the same off-by-the-border the
	# die card and the header buttons were both fixed for.
	#
	# SHRINK_CENTER matters more than the number. `StatsRow` is an HBoxContainer, whose cross
	# axis defaults to FILL — so these five chips were being stretched to the bar's full 60px
	# interior and measured 54px tall in the 2026-09-21 capture, against a design that says 39.
	# That is what "the buttons look squeezed" was: not too small, too tall, with the label
	# floating in the middle of a box a third taller than it should be.
	btn.custom_minimum_size = Vector2(_UTIL_CHIP, _UTIL_CHIP)
	btn.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	btn.focus_mode = Control.FOCUS_NONE
	# Baloo 13/800 at the mockup's `letter-spacing:.05em` — one call sets face, size and tracking.
	btn.add_theme_font_override("font", UI3Theme.font_display())
	btn.add_theme_font_size_override("font_size", 13)
	btn.add_theme_stylebox_override("normal", _utility_chip_style(UI3Theme.color("panel_raised")))
	btn.add_theme_stylebox_override("focus", _utility_chip_style(UI3Theme.color("panel_raised")))
	btn.add_theme_stylebox_override("hover", _utility_chip_style(UI3Theme.color("accent")))
	btn.add_theme_stylebox_override("pressed",
		_utility_chip_style(UI3Theme.color("accent").darkened(0.22), 4))
	btn.add_theme_stylebox_override("disabled",
		_utility_chip_style(UI3Theme.color("panel_raised").darkened(0.38)))
	var _txt := UI3Theme.color("text")
	btn.add_theme_color_override("font_color", _txt)
	btn.add_theme_color_override("font_hover_color", UI3Theme.color("accent_text"))
	btn.add_theme_color_override("font_pressed_color", UI3Theme.color("accent_text"))
	btn.add_theme_color_override("font_disabled_color", Color(_txt.r, _txt.g, _txt.b, 0.45))


func _connect_ui_buttons() -> void:
	_reroll_button.pressed.connect(_on_reroll_pressed)
	_end_turn_button.pressed.connect(_on_end_turn_pressed)
	_log_toggle_button.pressed.connect(_on_log_toggle_pressed)
	_style_utility_button(_log_toggle_button)
	# Reroll/End Turn's own visual content (icon+label+count chip / label+SPACE chip) is built
	# once by _build_bottom_deck() -> _style_reroll_button()/_style_end_turn_button(), called from
	# _ready() before this function runs — style_button() itself is called there too, so this
	# function only wires the click signal.

	# Undo/Info — review-uiux-godot-vs-web.md P0 #1 ("Undo / Info / Log pushed right"). Undo
	# calls CombatEngine's own already-public undo_last() (rule spec §2 "free undo within a
	# turn") — this file adds no new gameplay rule, only exposes an existing engine API, same as
	# the reroll/end-turn buttons already do. Info just toggles a static how-to-play panel (no
	# engine call) — see _on_info_toggle_pressed().
	_undo_button.pressed.connect(_on_undo_pressed)
	_style_utility_button(_undo_button)
	_info_button.pressed.connect(_on_info_toggle_pressed)
	_style_utility_button(_info_button)
	_build_sound_button()
	# NO CHIP LABELLED "QUIT". combat-v2.html's `utils` row is five chips — UNDO, INFO, LOG, ♪
	# and (since 20 Sep) ⚙ — and a worded "Quit" is not one of them; see Q3 in the fix list.
	# The quit CONFIRM flow is untouched and now has two ways in: ESC (_unhandled_key_input())
	# and the ⚙ chip (_build_utility_row's N33 note on why it opens that and not a scene).
	_info_panel.visible = false

	for i in _die_slot_buttons.size():
		_wire_die_slot(i)

	# CB-21 / D1 — THE CARD IS 180x158 OUTER. Combat.tscn sets that on all five slots.
	#
	# It was 188x166 here for one pass, on the reading that the mockup's 180/158 were a content
	# box with the 4px border outside them. They are not: the card div in `combat-v2.html` carries
	# `box-sizing:border-box` explicitly, and its width comes from a wrapper at `width:180px` with
	# no border of its own. Measured off the reference capture the cards are 180 outer on a 194
	# pitch (gap 14), not 188 on 202. FIX-PASS-03 CB-21 says the same: "180 wide x 158 tall".
	#
	# The inner boxes are NOT all content numbers either — each one has to be read on its own.
	# The header is the one that genuinely needs the +3: `height:36px` with `border-bottom:3px`
	# and no `box-sizing`, so it renders 39 tall, which is what _build_die_slot_content() sets.
	# The face row (62) and keyword row (24) carry `box-sizing:border-box` or no border at all.
	#
	# v2 "Die card" redline: CARD_CREAM, 4px black, radius 15, shelf 0 6px 0 — the card is a
	# reading surface (cream), not chrome, in every state. Selection/disabled/spent no longer
	# swap the card to a different dark fill (that was the v1 look); they only change the SEL RING
	# overlay (see _build_die_slot_content()'s sel_ring_outer/sel_ring_inner) and the content's own
	# `modulate` alpha (see _update_dice_tray()'s SPENT/dead handling) — the redline is explicit
	# that a spent card "drops to opacity .55 and ignores hover", not a colour swap.

	# Six-face track cell colour (redline "Die card": "six 10px bars, the rolled one in its type
	# colour, the rest CREAM_TRACK") — built fresh per cell, per rebuild, by
	# _update_face_track() directly (the old Dango theme solid_chip_style(col, ...)), since the colour is
	# per-face data, not a fixed look; no shared StyleBoxFlat instance to build here any more.

	for i in _die_slot_buttons.size():
		var btn: Button = _die_slot_buttons[i]
		_style_die_slot(btn)
		_die_slot_content.append(_build_die_slot_content(btn))

	_stage3d.unit_clicked.connect(_on_target_clicked)   # second input path into the SAME
		# click-click handler as UnitPortrait.clicked
	# Right-click on the model is the always-available "what is this?" door — see that signal's
	# own comment in CombatStage3D.gd. Never a game action, so it needs none of the guards
	# _on_target_clicked() carries.
	_stage3d.unit_inspect_requested.connect(_open_unit_inspect)



## Mute toggle, built here rather than added to Combat.tscn so the scene file stays untouched.
## It sits in the same ButtonsRow as Undo/Info/Log because those are the other three controls
## that act on the session rather than on the fight — nothing here can change a game outcome.
## The state lives in MetaState and is shared by every combat, so a player who mutes once stays
## muted for the run and across restarts.
func _build_sound_button() -> void:
	_sound_button = Button.new()
	_sound_button.name = "SoundButton"
	_sound_button.focus_mode = Control.FOCUS_NONE
	_style_utility_button(_sound_button)
	_sound_button.pressed.connect(_on_sound_toggle_pressed)
	_log_toggle_button.get_parent().add_child(_sound_button)
	_refresh_sound_button()
	_build_settings_button()


## N33 — the ⚙ chip, last in the `utils` row so it lands in the screen's top-right corner.
##
## NEW 20 Sep 2026. Combat had no settings control and neither did the mockup; the owner
## flagged the gap and `combat-v2.html`'s `utils` row went from four chips to five the same
## day. Everything about the chip is its four neighbours' — _style_utility_button() — and it
## joins the same `ButtonsRow` (gap 5) they already live in.
##
## WHAT IT OPENS (owner decision): the existing quit-confirm dialog, the one ESC already opens.
## Combat has no settings panel of its own, and `Settings.tscn` is a SCENE — changing to it
## mid-fight would destroy the run. Reusing the confirm keeps the fight alive and is the only
## honest thing the chip can do today; when combat grows a real settings overlay, the
## `pressed` connection below is the one line that moves.
##
## WHY AN ICON AND NOT THE "⚙" CHARACTER. None of this project's six fonts carries U+2699 —
## their cmaps were read directly, the same check that found U+2713 missing for the map's
## visited badge — and no fallback font is configured, so the glyph would draw as a tofu box.
## `assets/icons/web/settings.svg` was added for this, in the same 128-box, black-outlined
## style as the other web icons.
##
## FLAGGED, same cause, NOT fixed here: the ♪ sound chip beside it has the identical problem
## — U+266A is missing from all six fonts too. It is pre-existing and shipping, so it is
## reported rather than quietly changed under a task about the settings chip. If it renders as
## a box on your machine, say so and it gets the same treatment.
func _build_settings_button() -> void:
	_settings_button = Button.new()
	_settings_button.name = "SettingsButton"
	_settings_button.tooltip_text = "Leave the fight"
	_settings_button.focus_mode = Control.FOCUS_NONE
	_style_utility_button(_settings_button)
	_settings_button.icon = MockupAssets.tex("assets/fx/settings.svg")
	_settings_button.expand_icon = true
	_settings_button.add_theme_constant_override("icon_max_width", 19)
	# The icon stands in for a label, so it takes the label's colours in every state rather
	# than drawing at full white on a chip whose text is TEXT. The svg is pure white for
	# exactly this reason - the tint is what gives it its colour.
	_settings_button.add_theme_color_override("icon_normal_color", UI3Theme.color("text"))
	_settings_button.add_theme_color_override("icon_focus_color", UI3Theme.color("text"))
	_settings_button.add_theme_color_override("icon_hover_color", UI3Theme.color("accent_text"))
	_settings_button.add_theme_color_override("icon_pressed_color", UI3Theme.color("accent_text"))
	_settings_button.add_theme_color_override("icon_disabled_color", UI3Theme.color("text_on_viewport"))
	_settings_button.pressed.connect(open_run_menu)
	_log_toggle_button.get_parent().add_child(_settings_button)


func _on_sound_toggle_pressed() -> void:
	CombatAudioDirector.toggle_muted()
	_refresh_sound_button()


func _refresh_sound_button() -> void:
	if _sound_button == null:
		return
	# The mockup labels this chip "♪" and gives it no second state, so mute reads as the glyph
	# dimming rather than as a different word — the row is four fixed-width chips and a label
	# that changes length would shuffle the whole group sideways on every press.
	var muted := CombatAudioDirector.is_muted()
	_sound_button.text = "♪"
	_sound_button.add_theme_color_override("font_color",
		UI3Theme.color("text_on_viewport") if muted else UI3Theme.color("text"))
	_sound_button.tooltip_text = "Turn sound back on" if muted else "Mute sound"


## Leaving the fight. The run is already saved after every action, so this button is not what
## makes progress survive — it is what lets the player stop playing without killing the process.
## JS puts the same control behind a modal (client.html:7135) and so does this: a stray click on
## a bare "Quit" during a boss fight would cost a whole run, and the button sits next to
## Undo/Info/Log, which are all safe to press.
## In-run menu (L1 C3): Esc or the gear. Snapshots the fight into RunState.resume_combat (the same
## path CONTINUE RUN uses, so the engine is restored exactly, not re-rolled) and opens Settings in
## in-run mode; "Back to run" reloads this scene from that snapshot. The tutorial has no run, so it
## keeps the old leave-confirm.
func open_run_menu() -> void:
	if _tutorial or _combat == null or _result_shown:
		_on_quit_pressed()
		return
	if pause_menu_open():
		return
	var graph := RunMapGraph.from_data(RunState.map_graph)
	var node := graph.find_node(String(_setup.get("node_id", "")))
	var layer := CanvasLayer.new()
	layer.name = "PauseLayer"
	layer.layer = 40          # over the inspector (28) and the quit confirm (30)
	add_child(layer)
	var menu := RunPauseMenu.new()
	menu.build({"floor": node.row + 1 if node != null else 0, "total": graph.rows.size(),
		"ascension": RunState.ascension, "shards": RunState.shards_this_run})
	layer.add_child(menu)
	var close := func() -> void:
		if is_instance_valid(layer):
			if layer.get_parent() != null:
				layer.get_parent().remove_child(layer)
			layer.queue_free()
	menu.resumed.connect(close)
	menu.settings_requested.connect(open_settings_from_menu)
	menu.save_quit_confirmed.connect(_on_pause_save_quit)
	menu.abandon_confirmed.connect(func() -> void:
		SettingsView.abandon_current_run()
		LandNav.back_to_land())


## Save and quit from the pause plate: same save as the old leave-confirm, and the in-run Settings flags
## stay cleared so Settings opened later from the Land is not "in run".
func _on_pause_save_quit() -> void:
	pause_save_quit_state()
	get_tree().change_scene_to_file("res://scenes/main_menu/MainMenu.tscn")


## The state half of _on_pause_save_quit(), so a test can drive it without swapping scenes.
func pause_save_quit_state() -> void:
	_save_run_progress()
	SettingsView.in_run = false
	SettingsView.return_scene = ""


func pause_menu_open() -> bool:
	return find_child("RunPauseMenu", true, false) != null


## The Settings row of the pause plate: the in-run Settings screen; "Back to run" reloads this fight.
func open_settings_from_menu() -> void:
	prepare_run_menu()
	get_tree().change_scene_to_file("res://scenes/settings/Settings.tscn")


## The state half of open_run_menu(), split out so a test can drive it without swapping scenes.
func prepare_run_menu() -> void:
	_save_run_progress()
	RunState.resume_combat = _combat.to_data()
	SettingsView.in_run = true
	SettingsView.return_scene = "res://scenes/combat/Combat.tscn"


func _on_quit_pressed() -> void:
	if _quit_confirm != null and is_instance_valid(_quit_confirm):
		_quit_confirm.visible = true
		return
	_quit_confirm = _build_quit_confirm()


func _build_quit_confirm() -> Control:
	var layer := CanvasLayer.new()
	layer.layer = 30          # above the top bar and the dice tray, below nothing else here
	add_child(layer)

	var dim := ColorRect.new()
	dim.color = Color(0, 0, 0, 0.72)
	dim.set_anchors_preset(Control.PRESET_FULL_RECT)
	dim.mouse_filter = Control.MOUSE_FILTER_STOP   # swallows clicks aimed at the board behind it
	layer.add_child(dim)

	var center := CenterContainer.new()
	center.set_anchors_preset(Control.PRESET_FULL_RECT)
	dim.add_child(center)

	var panel := PanelContainer.new()
	# PANEL_DEEP, not PANEL: this sits on the painted plate with artwork around it, which is the
	# right for a HUD panel sitting over its own scene and wrong here — the board read straight
	# through this dialog, enemy nameplates and all (production/qa/evidence/
	# 2026-09-18_quit-confirm.png, before this line). A question the player must read needs an
	# opaque answer behind it.
	panel.add_theme_stylebox_override("panel", UI3Theme.flat(UI3Theme.color("panel"), UI3Theme.radius("l"), 0, Color.TRANSPARENT, Vector4(20, 13, 20, 13)))
	center.add_child(panel)

	var margin := MarginContainer.new()
	for side in ["left", "right", "top", "bottom"]:
		margin.add_theme_constant_override("margin_" + side, 16)
	panel.add_child(margin)

	var col := VBoxContainer.new()
	col.add_theme_constant_override("separation", 12)
	margin.add_child(col)

	var title := Label.new()
	title.text = "Leave this fight?"
	title.add_theme_font_size_override("font_size", 20)
	title.add_theme_color_override("font_color", UI3Theme.color("text"))
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(title)

	var body := Label.new()
	body.text = "Your run is saved. CONTINUE RUN on the main menu drops you back into this\nfight, on this turn."
	body.add_theme_font_size_override("font_size", 14)
	body.add_theme_color_override("font_color", UI3Theme.color("text_muted"))
	body.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(body)

	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", 12)
	row.alignment = BoxContainer.ALIGNMENT_CENTER
	col.add_child(row)

	var stay := UI3.button("Keep playing", &"secondary")
	stay.text = "Keep playing"
	stay.custom_minimum_size = Vector2(150, 44)
	stay.pressed.connect(func(): if is_instance_valid(_quit_confirm): _quit_confirm.visible = false)
	row.add_child(stay)

	var leave := UI3.button("Save & quit", &"primary")
	leave.text = "Save & quit"
	leave.custom_minimum_size = Vector2(150, 44)
	leave.pressed.connect(_on_quit_confirmed)
	row.add_child(leave)

	return dim


## Saves before leaving rather than trusting the last action's save: the player may have quit
## after something that does not go through an action handler, and a save here costs one file
## write on a path taken at most once per session.
func _on_quit_confirmed() -> void:
	_save_run_progress()
	get_tree().change_scene_to_file("res://scenes/main_menu/MainMenu.tscn")














