## CB-11 / CB-12 — committed incoming damage on a party member: what the enemies have ALREADY
## declared they will do to this unit this turn, which is what makes the at-risk slice and the
## incoming chip a telegraph rather than a guess.
##
## Faithfulness matters more here than anywhere else on the screen, because a telegraph that
## under-reports is worse than none: the player plans a turn around surviving it. This therefore
## walks the SAME order DamagePipeline.apply_damage() does, and takes only its DETERMINISTIC
## steps:
##   * attacker side — `CombatEngine._face_value()`, which already folds in growth, vital,
##     blind, weaken, overdrive, hiveMind and resonance;
##   * step 6, target-side `vulnerable` (x1.5);
##   * step 7, target-side relic damage reduction, party only.
## CRIT (step 5) is deliberately EXCLUDED — it is an RNG roll, and a telegraph that assumes a
## crit would over-report every turn it does not happen.
##
## KNOWN GAP, deliberate and small: `pierce` bypasses shield (step 8), and CB-11's formula
## subtracts shield unconditionally. A piercing intent against a shielded party member will
## therefore show a slightly SHORTER at-risk block than it should. Flagged rather than
## silently modelled, because CB-11 states its formula literally.
func _incoming_damage_for(target: Unit) -> int:
	if _combat == null or target.side != "p" or target.hp <= 0:
		return 0
	var total := 0.0
	for e in _combat.enemies:
		if e.hp <= 0 or e.intent.is_empty():
			continue
		if int(e.intent.get("target_uid", -1)) != target.uid:
			continue
		var fi := int(e.intent.get("face_index", -1))
		if fi < 0 or fi >= e.die.size():
			continue
		if String((e.die[fi] as Dictionary).get("type", "")) != "dmg":
			continue
		var v := float(_combat._face_value(e, fi))
		if int(target.status.get("vulnerable", 0)) > 0:
			v = ceil(v * 1.5)                                   # pipeline step 6
		var dr := RelicHooks.sum(_combat, "dr")
		if dr > 0.0:
			v = max(1.0, ceil(v * (1.0 - dr)))                  # pipeline step 7
		total += v
	return int(total)


## `hud_state()` — the REAL one the moment lane A ships it on CombatEngine, else the stub
## (production/l1-interfaces.md §3.2). Read once per rebuild and cached in `_hud`.
func _hud_state() -> Dictionary:
	if _combat == null:
		return {}
	if _combat.has_method("hud_state"):
		return _combat.call("hud_state")
	return HudStateStub.from_engine(_combat)


## Rule-based illegal-target reason for the selected die against `target` (README 3 "Targeting":
## only reasons the engine really has — a heal face cannot hit a monster; a blank face does
## nothing). "" = legal.
func _illegal_reason_for(target: Unit) -> String:
	if _selected_die_uid == -1 or _combat == null:
		return ""
	var src := _combat.by_uid(_selected_die_uid)
	if src == null or not src.has_rolled():
		return ""
	var fi := src.roll_face_index()
	if fi < 0 or fi >= src.die.size():
		return ""
	var t := String((src.die[fi] as Dictionary).get("type", ""))
	if t == "blank":
		return "Blank face: nothing to use"
	if t == "heal" and target.side == "e":
		return "Heal face: allies only"
	return ""


func _update_portrait(u: Unit) -> void:
	var p: UnitPortrait = _portraits.get(u.uid)
	if p == null:
		return
	p.set_incoming(_incoming_damage_for(u))
	p.update_stats(u.hp, u.max_hp, u.shield, u.status)
	_stage3d.set_alive(u.uid, u.hp > 0)
	if u.side == "e":
		_update_enemy_plate(p, u)

	var is_selected := (u.uid == _selected_die_uid)
	if not is_selected:
		# An armed relic active highlights only the SIDE it can legally hit; a selected die keeps
		# the old rule (anything alive) plus the rule-based illegal reasons above.
		var targetable := false
		var reason := ""
		if _selected_active_id != "":
			var adef: RelicDef = RelicRegistry.get_def(_selected_active_id)
			var want := adef.act_target() if adef != null else "none"
			targetable = u.hp > 0 and ((want == "ally" and u.side == "p")
				or (want == "enemy" and u.side == "e"))
		else:
			targetable = _selected_die_uid != -1 and u.hp > 0
			reason = _illegal_reason_for(u) if targetable else ""
			if reason != "":
				targetable = false
		p.set_targetable(targetable)
		p.set_illegal(reason if u.hp > 0 else "")
		_stage3d.set_targetable(u.uid, targetable)
	else:
		p.set_selected(false)
		p.set_illegal("")


## The enemy plate's R1 content: ONE merged intent number, the counter tab (spike or boss clock),
## the boss phase line and the acting state. Numbers come from `hud_state()`; nothing is summed
## here (README 3a).
func _update_enemy_plate(p: UnitPortrait, u: Unit) -> void:
	var hs: Dictionary = _hud if not _hud.is_empty() else _hud_state()
	var next: Dictionary = (hs.get("enemy_next", {}) as Dictionary).get(u.uid, {})
	var newcomer := bool(hs.get("newcomer", false))
	var intent := {"show": false}
	var fi := int(u.intent.get("face_index", -1)) if not u.intent.is_empty() else -1
	if u.hp > 0 and fi >= 0 and fi < u.die.size():
		var f: Dictionary = u.die[fi]
		var ftype := String(f.get("type", ""))
		var tgt_uid := int(u.intent.get("target_uid", -1))
		var num := int(next.get("dmg", _live_face_value(u, fi))) if ftype == "dmg" \
			else _live_face_value(u, fi)
		var clock: Dictionary = hs.get("clock", {})
		intent = {"show": true, "type": ftype, "num": num,
			"label": DangoTheme.face_type_label(ftype),
			"target": _unit_name(tgt_uid) if tgt_uid >= 0 else "",
			"boosted": u.is_boss and int(clock.get("stacks", 0)) > 0 and not newcomer}
	p.set_acting(_end_turn_acting_uid == u.uid)
	p.set_intent(intent)

	var tab := {}
	if u.hp > 0 and not newcomer:
		if u.is_boss and bool((hs.get("clock", {}) as Dictionary).get("active", false)):
			tab = HudKit.clock_tab(hs["clock"], int(hs.get("turn", _combat.turn)),
				int(intent.get("num", 0)))
		elif bool(next.get("spike", false)) and int(next.get("turns_to_spike", 0)) > 0:
			var n := int(next.get("turns_to_spike", 0))
			var hits := int(next.get("spike_dmg", int(round(float(next.get("dmg", 0)) * 2.5))))
			tab = {"bg": DangoTheme.GOLD_SOFT, "ink": DangoTheme.GOLD_INK,
				"icon": HudKit.icon("spike"), "text": "BIG HIT IN %d" % n,
				"right": "HITS %d" % hits, "pips": []}
	p.set_tab(tab)
	if u.is_boss:
		p.set_phase(int((hs.get("boss_phase", {}) as Dictionary).get(u.uid, {}).get("phase",
			int(u.custom_state.get("phase", 1)))))


























## Flip-on-use juice (review P1 #6). Detects the unused->used transition here (inside
## _update_dice_tray(), part of the sanctioned full-model-read path — same rationale
## _maybe_play_roll_juice() below already documents for why this isn't a signal handler).
func _maybe_play_die_used_flip(u: Unit, btn: Button) -> void:
	var used_now := u.hp > 0 and u.has_rolled() and u.roll_used()
	var was_used: bool = _last_die_used.get(u.uid, false)
	_last_die_used[u.uid] = used_now
	if used_now and not was_used:
		_play_die_flip(btn)


func _play_die_flip(btn: Button) -> void:
	if disable_juice_for_tests or not is_instance_valid(btn) or not btn.is_inside_tree():
		return
	btn.pivot_offset = btn.size * 0.5
	var tw := create_tween()
	tw.tween_property(btn, "scale:x", 0.0, _DIE_FLIP_DURATION * 0.5)
	tw.tween_property(btn, "scale:x", 1.0, _DIE_FLIP_DURATION * 0.5)


## Roll-bounce juice (unchanged from the pre-review pass — see original file history/report for
## why this lives here instead of a signal handler: EventBus has no dedicated "die just
## rolled" signal with the right payload).
func _maybe_play_roll_juice(u: Unit, btn: Button) -> void:
	if not u.has_rolled():
		_last_die_face.erase(u.uid)
		return
	var fi := u.roll_face_index()
	var prev = _last_die_face.get(u.uid, null)
	_last_die_face[u.uid] = fi
	if prev == null or prev == fi:
		return
	if _reroll_fx_active:
		return   # the reroll tray lands this card itself (RerollFX._land_card())
	_play_die_roll_bounce(btn)


func _play_die_roll_bounce(btn: Button) -> void:
	if disable_juice_for_tests:
		return
	if not is_instance_valid(btn) or not btn.is_inside_tree():
		return
	btn.pivot_offset = btn.size * 0.5
	var tw := create_tween()
	tw.tween_property(btn, "scale", Vector2(_ROLL_ANIM_SCALE, _ROLL_ANIM_SCALE), _ROLL_ANIM_DURATION * 0.5)
	tw.parallel().tween_property(btn, "rotation_degrees", randf_range(-8.0, 8.0), _ROLL_ANIM_DURATION * 0.5)
	tw.tween_property(btn, "scale", Vector2.ONE, _ROLL_ANIM_DURATION * 0.5)
	tw.parallel().tween_property(btn, "rotation_degrees", 0.0, _ROLL_ANIM_DURATION * 0.5)


## Hit-stop + screen shake (unchanged from the pre-review pass).
## Runs `fn` at the moment the blow lands — see `_IMPACT_DELAY`. Immediate when there is no
## delay to wait (tests), so the call graph is identical in that mode rather than merely fast.
##
## `fn` may run after this scene has been torn down (a killing blow calls _finish(), which
## changes scene), so every caller's body re-checks what it touches. The timer itself is
## created on the tree, not on this node, and is dropped with the scene.
func _after_impact(fn: Callable) -> void:
	var d := impact_delay()
	if d <= 0.0 or not is_inside_tree():
		fn.call()
		return
	get_tree().create_timer(d).timeout.connect(fn, CONNECT_ONE_SHOT)


func _play_hit_juice() -> void:
	if flashes_suppressed():
		return
	var end_anim := _begin_hit_animation()
	if is_inside_tree():
		await get_tree().create_timer(_HITSTOP_DURATION).timeout
	if is_instance_valid(_stage3d):
		await _stage3d.shake(_SHAKE_AMPLITUDE, _SHAKE_DURATION)
	end_anim.call()


## Input lock (unchanged from the pre-review pass).
func _begin_hit_animation() -> Callable:
	_hit_anim_count += 1
	_is_animating = true
	var released := false
	var release := func():
		if released:
			return
		released = true
		_hit_anim_count = maxi(_hit_anim_count - 1, 0)
		_is_animating = _hit_anim_count > 0
	if is_inside_tree():
		get_tree().create_timer(_INPUT_LOCK_FAILSAFE).timeout.connect(release)
	else:
		release.call()
	return release






func _wire_die_slot(idx: int) -> void:
	var btn: Button = _die_slot_buttons[idx]
	btn.pressed.connect(func(): _on_die_slot_pressed(idx))
	btn.mouse_entered.connect(func(): _on_die_slot_hover(idx, true))
	btn.mouse_exited.connect(func(): _on_die_slot_hover(idx, false))


## The scene ships five die slots because a roster is five Axies. A SUMMONED token is a sixth
## party member with a real die, and `tokenCap` allows up to four of them, so the tray has to
## be able to reach nine.
##
## Grown in code rather than placed in Combat.tscn: four permanently-hidden extra cards would
## be four more things every layout pass has to remember to skip, for a case most fights never
## reach.
##
## ONE ROW, ALWAYS. The grid is inside a CenterContainer in a 204px-tall bar, so a second row
## would be clipped rather than wrapped. `columns` therefore tracks the slot count and the
## cards narrow to fit: _DIE_SLOT_W_MAX down to _DIE_SLOT_W_MIN, which at nine slots is
## 9*128 + 8*14 = 1264px and still inside the zone the five 180px cards leave.
const _DIE_SLOT_W_MAX := 180.0
const _DIE_SLOT_W_MIN := 128.0
const _DIE_SLOT_H := 158.0


func _ensure_die_slots(count: int) -> void:
	var want := maxi(count, 5)         # never shrink below the roster's five
	if _tray_root == null:
		return
	while _die_slot_buttons.size() < want:
		var btn := Button.new()
		btn.name = "DieSlot%d" % _die_slot_buttons.size()
		btn.toggle_mode = true
		btn.text = ""
		btn.custom_minimum_size = Vector2(272, 176)
		_tray_root.add_child(btn)
		_die_slot_buttons.append(btn)
		_style_die_slot(btn)
		_die_slot_content.append(_build_die_slot_content(btn))
		_die_slot_lifted.append(false)
		_wire_die_slot(_die_slot_buttons.size() - 1)
	_layout_tray()


## Everyone in the party who gets a die card, in tray order.
##
## SUMMONED TOKENS ARE IN HERE NOW. They used to be filtered out by `roster_index >= 0` —
## a token is not in RunState.roster so it carries the default -1 — which meant a summoned
## Axie Egg rolled a die the player could never see or spend. Reported as "bỏ quên mất không
## làm ô cho Axie Egg".
##
## Roster heroes keep their roster order and stay leftmost, so a summon never shuffles the
## cards the player has been reading all fight. Tokens follow, oldest first: `uid` is handed
## out in spawn order, so that is arrival order without needing to store one.
func _party_dice_units() -> Array:
	var heroes: Array = []
	var tokens: Array = []
	for u in _combat.party:
		if u.roster_index >= 0:
			heroes.append(u)
		else:
			tokens.append(u)
	heroes.sort_custom(func(a, b): return a.roster_index < b.roster_index)
	tokens.sort_custom(func(a, b): return a.uid < b.uid)
	heroes.append_array(tokens)
	return heroes


## The VFX layer, built on demand. Kept out of Combat.tscn on purpose — see the field.
func _ensure_skill_vfx() -> SkillVfxLayer:
	if is_instance_valid(_skill_vfx):
		return _skill_vfx
	if not is_instance_valid(_unit_visuals_root):
		return null
	_skill_vfx = SkillVfxLayer.new()
	_skill_vfx.name = "SkillVfxLayer"
	_unit_visuals_root.add_child(_skill_vfx)
	_unit_visuals_root.move_child(_skill_vfx, 0)
	return _skill_vfx


## The Origins clip for a unit using a face, or "" when there is none. The voice class is
## CombatAudio's, so a monster with no class of its own picks the same family its sounds come
## from and the two cannot disagree.
func _vfx_key_for(uid: int, face_part: String, face_type: String) -> String:
	if _combat == null:
		return ""
	var u := _combat.by_uid(uid)
	if u == null:
		return ""
	var voice := CombatAudio.voice_class(u.cls, u.key, u.is_boss)
	return SkillVfxCatalog.clip_key(voice, face_part, face_type)


## Draws `clip_key` between the two units. Both screen positions come from the same projection
## and the same stage-offset rebasing _layout_unit_visuals() uses, so the effect sits in the
## overlay space the portraits already agree on. A face with no target (AoE, or a self-buff)
## aims at the attacker's own row-forward direction by borrowing the first live opponent, and
## failing that plays on the spot.
func _play_skill_vfx(uid: int, target_uid: int, clip_key: String) -> void:
	if clip_key == "" or not is_instance_valid(_stage3d):
		return
	var layer := _ensure_skill_vfx()
	if layer == null:
		return
	var offset: Vector2 = _stage3d.position
	var a := _stage3d.get_unit_screen_pos(uid, CombatStage3D.HEAD_HEIGHT)
	if a.x < 0.0:
		return
	var tgt := target_uid
	if tgt < 0 or tgt == uid:
		tgt = _first_opposing_uid(uid)
	var b := _stage3d.get_unit_screen_pos(tgt, CombatStage3D.HEAD_HEIGHT) if tgt >= 0 \
		else Vector2(-1, -1)
	if b.x < 0.0:
		b = a + Vector2(0.0, -120.0 if _combat_is_enemy_uid(uid) else 120.0)
	layer.play(clip_key, a + offset, b + offset)


## Somebody on the other side who is still alive, for a face that named no single target.
func _first_opposing_uid(uid: int) -> int:
	if _combat == null:
		return -1
	var want_enemy := not _combat_is_enemy_uid(uid)
	for other in _portraits.keys():
		var o := int(other)
		if _combat_is_enemy_uid(o) != want_enemy:
			continue
		var u := _combat.by_uid(o)
		if u != null and u.hp > 0:
			return o
	return -1


func _unit_name(uid: int) -> String:
	if _combat == null:
		return "?"
	var u := _combat.by_uid(uid)
	return u.n if u != null else "uid#%d" % uid


func _append_log(line: String) -> void:
	_log_lines.append(line)
	if _log_lines.size() > _MAX_LOG_LINES:
		_log_lines.pop_front()
	_log_panel.text = "\n".join(_log_lines)


# ===========================================================================
# Win/Lose — unchanged handoff contract from the skeleton stage (architecture plan §4).
# ===========================================================================

func _finish(won: bool) -> void:
	if _result_shown:
		return
	_result_shown = true
	# Embedded in the tutorial: the fixture owns what happens next. Stop BEFORE
	# apply_combat_result() and before any change_scene_to_file() — see `_tutorial`'s comment.
	# The victory march still plays, because that beat is part of what the tutorial is showing.
	if _tutorial:
		if won:
			await _play_victory_march()
		tutorial_combat_finished.emit(won)
		return
	if not won and not disable_juice_for_tests and _hud_frame != null:
		# R1: the defeat screen decides what happens next. The run result is applied only when
		# the player picks End run, so a Continue (lane A) can still resume the same fight.
		_show_defeat_panel()
		return
	RunState.apply_combat_result(_combat.get_result())   # unchanged position/ordering relative
		# to the pre-animation-pass code — only the win branch below now awaits the march before
		# its own overlay/scene-change lines; this call itself is not delayed.
	if won:
		# Juice pass B: let the surviving party actually march off the field before cutting to
		# RunMap, instead of the previous same-frame overlay-then-scene-change (which meant the
		# "BẠN THẮNG" overlay was never actually visible for a frame in practice). See
		# _play_victory_march()/CombatStage3D.play_victory_march().
		await _play_victory_march()
		if not disable_juice_for_tests and _hud_frame != null and RunState.phase != RunState.RunPhase.WON:
			await _show_victory_banner()
		_result_overlay.visible = true
		# apply_combat_result() (above) already decided WON vs. a normal win-with-rewards:
		# defeating the run's FINAL boss sets RunState.phase to WON directly (src/engine.js
		# finishCombat() never offers a reward on that path either) — that's the run-complete
		# screen, not the map. RunState.after_node() is deliberately NOT called here for the
		# ordinary-win case: src/engine.js's takeReward() advances s.pw/s.phase strictly AFTER
		# the player picks a reward, so after_node() now only runs from
		# RunMapController._on_reward_chosen(), once a card is actually picked (see
		# RunState._generate_post_combat_rewards()'s ordering-fix note). This scene only ever
		# changes scene; it never advances run state on the ordinary-win path.
		if RunState.phase == RunState.RunPhase.WON:
			_result_label.text = "YOU WIN: RUN COMPLETE"
			get_tree().change_scene_to_file("res://scenes/result/Result.tscn")
		else:
			_result_label.text = "YOU WIN"
			get_tree().change_scene_to_file("res://scenes/run_map/RunMap.tscn")
	else:
		_result_overlay.visible = true
		_result_label.text = "YOU LOSE"
		get_tree().change_scene_to_file("res://scenes/result/Result.tscn")


## Records a hit on the party for the defeat recap (newest last, last 12 kept).
func _record_recap(src_uid: int, tgt_uid: int, value: int) -> void:
	if _combat == null:
		return
	var t := _combat.by_uid(tgt_uid)
	var src := _combat.by_uid(src_uid)
	if t == null or t.side != "p" or src == null or src.side != "e":
		return
	_recap.append({"turn": _combat.turn, "what": "%s hits %s for %d" % [src.n, t.n, value],
		"result": "%s KO" % t.n if t.hp <= 0 else "", "uid": tgt_uid})
	if _recap.size() > 12:
		_recap.pop_front()


func _show_defeat_panel() -> void:
	if _defeat == null:
		_defeat = DefeatPanel.new()
		_defeat.name = "DefeatPanel"
		_defeat.z_index = 40
		_shell_root.add_child(_defeat)
		_defeat.end_run_pressed.connect(_on_defeat_end_run)
		_defeat.continue_pressed.connect(_on_defeat_continue)
	var hs: Dictionary = _hud if not _hud.is_empty() else _hud_state()
	var kind := String(_setup.get("kind", "battle"))
	var asc := RunState.ascension
	var boss_d := {}
	for e in _combat.enemies:
		if e.is_boss:
			var spike_in := int(((hs.get("enemy_next", {}) as Dictionary).get(e.uid, {}) as Dictionary).get("turns_to_spike", 0))
			boss_d = {"name": e.n, "hp": maxi(e.hp, 0), "max_hp": e.max_hp,
				"phase": int(e.custom_state.get("phase", 1)), "phases": 3, "spike_in": spike_in}
	# Final-turn rows, tinted.
	var last_turn := _combat.turn
	var rows: Array = []
	for r in _recap:
		rows.append({"turn": int(r["turn"]), "what": String(r["what"]), "result": String(r["result"]),
			"final": int(r["turn"]) == last_turn})
	rows = rows.slice(maxi(rows.size() - 5, 0))
	var party: Array = []
	for u in _combat.party:
		if u.roster_index >= 0:
			party.append({"name": u.n, "max_hp": u.max_hp})
	var newcomer := bool(hs.get("newcomer", false))
	var co := AidPurchase.offer("continue", _combat, _tutorial)
	var boss_fight := kind == "boss"
	var price := AidPurchase.list_price("R1", boss_fight)
	var usd := "%s %.2f USD" % [HudKit.glyph(0x2248, "~"), float(price) / 90.0]
	var variant := "paid"
	var was := 0
	var moon := bool(co.get("show", false)) and int(co["price"]) != price and int(co["price"]) > 0
	if moon:
		was = price
		price = int(co["price"])
		variant = "moon"
		usd = "%s %.2f USD" % [HudKit.glyph(0x2248, "~"), float(price) / 90.0]
	if not bool(co["enabled"]):
		usd = AidPurchase.reason_text(String(co["reason"]))
	var gift := bool(co.get("show", false)) and bool(co["enabled"]) and int(co["price"]) == 0
	if gift:
		price = 0
		variant = "gift"
		usd = "free sample"
	var keep := ""
	if not boss_d.is_empty():
		keep = "Boss stays at %d HP, phase %d.%s" % [int(boss_d["hp"]), int(boss_d["phase"]),
			(" Big hit in %d is kept." % int(boss_d["spike_in"])) if int(boss_d["spike_in"]) > 0 else ""]
	else:
		keep = "Enemies keep their HP."
	var clock_on := bool((hs.get("clock", {}) as Dictionary).get("active", false))
	_defeat.show_defeat({
		"title_line": "%s %s A%d %s your party fell on turn %d" % [
			"Boss fight" if boss_fight else ("Elite fight" if kind == "elite" else "Fight"),
			HudKit.dot(), asc, HudKit.dot(), _combat.turn],
		"boss": boss_d, "recap": rows, "aid_used": int(co["used"]), "aid_cap": int(co["cap"]),
		"continue_left": 1, "heal_pct": 25 if asc >= 6 else 40, "party": party,
		"keep_line": keep,
		"enrage_reset_line": "Enrage resets to 'Enrage in 10'." if clock_on else "",
		"attrition_reset_line": "" if newcomer else "Attrition resets to 0%.",
		"price": price, "price_was": was, "usd": usd, "variant": variant,
		"continue_show": bool(co.get("show", false)) and not _tutorial, "continue_enabled": bool(co["enabled"]),
		"continue_reason": AidPurchase.reason_text(String(co["reason"])),
		"foot": "Continue is offered once per run." if not gift else "This gift is offered once per account and is used as the run's Continue."})


func _on_defeat_continue() -> void:
	var res := AidPurchase.buy("continue", _combat, [], _tutorial)
	_append_log("[aid] continue : %s" % ("ok (-%d Gem)" % int(res["charged"]) if bool(res["ok"]) else String(res["code"])))
	if not bool(res["ok"]):
		return
	if _defeat != null:
		_defeat.visible = false
	_rebuild_all()
	_save_run_progress()


func _on_defeat_end_run() -> void:
	RunState.apply_combat_result(_combat.get_result())
	_result_overlay.visible = true
	_result_label.text = "YOU LOSE"
	get_tree().change_scene_to_file("res://scenes/result/Result.tscn")


