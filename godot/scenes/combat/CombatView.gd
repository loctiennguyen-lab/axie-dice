## 3D throw for freshly rolled dice (DiceRoller3D). Visual only: values are the engine's. Skipped
## in tests, headless and with Reduce flashing on, so those paths are unchanged.
func _start_dice_throw(fresh: Array) -> void:
	if fresh.is_empty():
		return
	if disable_juice_for_tests or not is_instance_valid(_stage3d):
		_reroll_prev.clear()
		return
	var entries: Array = []
	var slots: Array = []
	var info: Array = []
	for f in fresh:
		var u: Unit = f["u"]
		var fi := u.roll_face_index()
		if fi < 0 or fi >= u.die.size():
			continue
		slots.append(int(f["slot"]))
		var faces: Array = []
		for k in u.die.size():
			faces.append({"type": String((u.die[k] as Dictionary).get("type", "blank")),
				"value": _live_face_value(u, k)})
		info.append({"uid": u.uid, "slot": int(f["slot"]), "faces": faces, "final": fi,
			"prev": int(_reroll_prev.get(u.uid, -1)), "small": u.is_token})
		entries.append({"slot_node": _stage3d.slot_node_of(u.uid), "faces": faces, "result_index": fi,
			"face_type": String((u.die[fi] as Dictionary).get("type", "blank")),
			"value": _live_face_value(u, fi), "crit": u.roll_crit_now(), "small": u.is_token,
			"uid": u.uid})
	var rerolled := false
	for i in info:
		rerolled = rerolled or int(i["prev"]) >= 0
	_reroll_prev.clear()
	if entries.is_empty():
		return
	if _pre_throw_uids.is_empty():
		_dm_audio.play("dm_roll")   # a pre-thrown roll already played it when the dice went up
	last_throw = {"uids": entries.map(func(e): return int(e["uid"])), "reroll": rerolled}
	var roller := _stage3d.get_dice_roller()
	if MetaState.reduce_flash or UI3Motion.reduced() or roller == null or roller.will_skip():
		# No throw: the cards are already showing, the tags still go up.
		for i in info:
			_show_reroll_tags(i)
		return
	var live_pre := _pre_throw_matches(entries)
	if not live_pre:
		_cancel_pre_throw()
		_land_dice_now()   # an older roll still in the air lands first (its arrivals reach the handler)
	for i in info:
		_dice_pending[int(i["uid"])] = true
	if roller.die_arrived.is_connected(_on_throw_arrived):
		roller.die_arrived.disconnect(_on_throw_arrived)
	_throw_uids.clear()
	for e in entries:
		_throw_uids.append(int(e["uid"]))
	_throw_slots = slots
	_throw_info = info
	for sl in slots:
		(_die_slot_buttons[int(sl)] as Button).modulate.a = 0.0
	roller.die_arrived.connect(_on_throw_arrived)
	if live_pre:
		_pre_throw_uids.clear()
		roller.resolve(entries)   # the dice are already in the air: they now get their faces
	else:
		roller.roll(entries, _throw_tray_target)


## SR0 (PB, Liam 26/10): "throw first, decide later". Last pre-throw, read by tests:
## {uids, thrown (a real 3D throw went up, false headless / reduced motion)}.
var last_pre_throw: Dictionary = {}
var _pre_throw_uids: Array = []   # uids of the dice in the air waiting for their seed; empty = none


## Starts the 3D throw of `uids` before their seed is back. Only with an epoch source (the online path):
## the local path has no wait. Visual only: the engine is untouched until the seed arrives, and
## `_start_dice_throw` then hands the real faces to the SAME dice (DiceRoller3D.resolve), so the end
## state and the action log are exactly what a seed that came at once would give.
func _begin_pre_throw(uids: Array, rmode: int) -> void:
	last_pre_throw = {}
	_pre_throw_uids.clear()
	if _combat._epoch == null or not _combat.can_reroll(uids, false, rmode):
		return
	var units: Array = []
	var slots: Array = []
	var party := _party_dice_units()
	for i in party.size():
		var u: Unit = party[i]
		if uids.has(u.uid) and u.die.size() >= 1:
			units.append(u)
			slots.append(i)
	if units.is_empty():
		return
	var entries: Array = []
	for u in units:
		var faces: Array = []
		for k in (u as Unit).die.size():
			faces.append({"type": String(((u as Unit).die[k] as Dictionary).get("type", "blank")),
				"value": _live_face_value(u, k)})
		entries.append({"slot_node": _stage3d.slot_node_of(u.uid) if is_instance_valid(_stage3d) else null,
			"faces": faces, "result_index": 0, "face_type": String(faces[0]["type"]),
			"value": int(faces[0]["value"]), "small": (u as Unit).is_token, "uid": u.uid})
	last_pre_throw = {"uids": units.map(func(u): return (u as Unit).uid), "thrown": false}
	if disable_juice_for_tests or not is_instance_valid(_stage3d) or MetaState.reduce_flash or UI3Motion.reduced():
		return
	var roller := _stage3d.get_dice_roller()
	if roller == null or roller.will_skip():
		return
	_land_dice_now()
	_dm_audio.play("dm_roll")
	for u in units:
		_dice_pending[(u as Unit).uid] = true
	if roller.die_arrived.is_connected(_on_throw_arrived):
		roller.die_arrived.disconnect(_on_throw_arrived)
	_throw_uids = units.map(func(u): return (u as Unit).uid)
	_throw_slots = slots
	_throw_info = []
	for sl in slots:
		(_die_slot_buttons[int(sl)] as Button).modulate.a = 0.0
	roller.die_arrived.connect(_on_throw_arrived)
	_pre_throw_uids = _throw_uids.duplicate()
	last_pre_throw["thrown"] = true
	roller.roll_pending(entries, _throw_tray_target)


## True when the dice in the air are exactly the ones `entries` is about (same uids, same order).
func _pre_throw_matches(entries: Array) -> bool:
	if _pre_throw_uids.is_empty() or entries.size() != _pre_throw_uids.size():
		return false
	if not is_instance_valid(_stage3d) or _stage3d.get_dice_roller() == null or not _stage3d.get_dice_roller().is_rolling():
		return false
	for i in entries.size():
		if int(entries[i]["uid"]) != int(_pre_throw_uids[i]):
			return false
	return true


## The seed failed (or the throw does not match): the waiting dice land at once, their cards come back.
func _cancel_pre_throw() -> void:
	if _pre_throw_uids.is_empty():
		return
	_pre_throw_uids.clear()
	_land_dice_now()


func _throw_tray_target(i: int) -> Vector2:
	return _dd()._throw_tray_target(i)


func _on_throw_arrived(i: int) -> void:
	_dm_audio.play("dm_land")
	if i >= 0 and i < _throw_uids.size():
		_dice_pending.erase(_throw_uids[i])
		if i < _throw_slots.size() and int(_throw_slots[i]) < _die_slot_buttons.size():
			(_die_slot_buttons[int(_throw_slots[i])] as Button).modulate.a = 1.0
		if i < _throw_info.size():
			_show_reroll_tags(_throw_info[i])
	if is_inside_tree() and _combat != null:
		_update_dice_tray()
	if _dice_pending.is_empty():
		_maybe_dm_pair()


var _dm_pair_turn := -1

## One "pair" pling per turn: two dice on the same part and no Set (3+) showing. UI only, reads the rolled faces.
func _maybe_dm_pair() -> void:
	if _combat == null or _dm_pair_turn == _combat.turn:
		return
	var parts := {}
	for u in _party_dice_units():
		if u.hp > 0 and u.has_rolled() and not u.is_token:
			var fi: int = u.roll_face_index()
			parts[fi] = int(parts.get(fi, 0)) + 1
	var pair := false
	for k in parts:
		if int(parts[k]) >= 3:
			return
		pair = pair or int(parts[k]) == 2
	if pair:
		_dm_pair_turn = _combat.turn
		_dm_audio.play("dm_pair")


## Any HUD action while dice are still flying lands them first.
func _land_dice_now() -> void:
	if is_instance_valid(_stage3d) and _stage3d.get_dice_roller() != null:
		_stage3d.get_dice_roller().skip()
	_dice_pending.clear()
	for btn in _die_slot_buttons:
		(btn as Button).modulate.a = 1.0


func _play_die_roll_bounce(btn: Button) -> void:
	_dd()._play_die_roll_bounce(btn)


## Hit-stop + screen shake (unchanged from the pre-review pass).
## Runs `fn` at the moment the blow lands — see `_IMPACT_DELAY`. Immediate when there is no
## delay to wait (tests), so the call graph is identical in that mode rather than merely fast.
##
## `fn` may run after this scene has been torn down (a killing blow calls _finish(), which
## changes scene), so every caller's body re-checks what it touches. The timer itself is
## created on the tree, not on this node, and is dropped with the scene.
func _after_impact(fn: Callable) -> void:
	var d := impact_delay()
	if d <= 0.0 or not is_inside_tree():
		fn.call()
		return
	get_tree().create_timer(d).timeout.connect(fn, CONNECT_ONE_SHOT)


## UI-05 lane E: the shake is the moment's table row (motion_ui3.json hit 4/120, crit 6/160, big_hit 10/220). The
## hit-stop is the real one U5Moments.on_hit plays (crit 40 ms, big hit 60 ms), so the old fixed wait is gone.
func _play_hit_juice(mid := "hit") -> void:
	if motion_suppressed():
		return
	var end_anim := _begin_hit_animation()
	var sh := UI3Motion.screen_shake(mid)
	if is_instance_valid(_stage3d):
		await _stage3d.shake(float(sh.get("px", _SHAKE_AMPLITUDE)), float(sh.get("ms", _SHAKE_DURATION * 1000.0)) / 1000.0)
	end_anim.call()


## Input lock (unchanged from the pre-review pass).
func _begin_hit_animation() -> Callable:
	_hit_anim_count += 1
	_is_animating = true
	var released := false
	var release := func():
		if released:
			return
		released = true
		_hit_anim_count = maxi(_hit_anim_count - 1, 0)
		_is_animating = _hit_anim_count > 0
	if is_inside_tree():
		get_tree().create_timer(_INPUT_LOCK_FAILSAFE).timeout.connect(release)
	else:
		release.call()
	return release






func _wire_die_slot(idx: int) -> void:
	_dd()._wire_die_slot(idx)


## The scene ships five die slots because a roster is five Axies. A SUMMONED token is a sixth
## party member with a real die, and `tokenCap` allows up to four of them, so the tray has to
## be able to reach nine.
##
## Grown in code rather than placed in Combat.tscn: four permanently-hidden extra cards would
## be four more things every layout pass has to remember to skip, for a case most fights never
## reach.
##
## ONE ROW, ALWAYS. The grid is inside a CenterContainer in a 204px-tall bar, so a second row
## would be clipped rather than wrapped. `columns` therefore tracks the slot count and the
## cards narrow to fit: _DIE_SLOT_W_MAX down to _DIE_SLOT_W_MIN, which at nine slots is
## 9*128 + 8*14 = 1264px and still inside the zone the five 180px cards leave.
const _DIE_SLOT_W_MAX := 180.0
const _DIE_SLOT_W_MIN := 128.0
const _DIE_SLOT_H := 158.0


func _ensure_die_slots(count: int) -> void:
	_dd()._ensure_die_slots(count)


## Everyone in the party who gets a die card, in tray order.
##
## SUMMONED TOKENS ARE IN HERE NOW. They used to be filtered out by `roster_index >= 0` —
## a token is not in RunState.roster so it carries the default -1 — which meant a summoned
## Axie Egg rolled a die the player could never see or spend. Reported as "bỏ quên mất không
## làm ô cho Axie Egg".
##
## Roster heroes keep their roster order and stay leftmost, so a summon never shuffles the
## cards the player has been reading all fight. Tokens follow, oldest first: `uid` is handed
## out in spawn order, so that is arrival order without needing to store one.
func _party_dice_units() -> Array:
	var heroes: Array = []
	var tokens: Array = []
	for u in _combat.party:
		if u.roster_index >= 0:
			heroes.append(u)
		else:
			tokens.append(u)
	heroes.sort_custom(func(a, b): return a.roster_index < b.roster_index)
	tokens.sort_custom(func(a, b): return a.uid < b.uid)
	heroes.append_array(tokens)
	return heroes


## The VFX layer, built on demand. Kept out of Combat.tscn on purpose — see the field.
func _ensure_skill_vfx() -> SkillVfxLayer:
	if is_instance_valid(_skill_vfx):
		return _skill_vfx
	if not is_instance_valid(_unit_visuals_root):
		return null
	_skill_vfx = SkillVfxLayer.new()
	_skill_vfx.name = "SkillVfxLayer"
	_unit_visuals_root.add_child(_skill_vfx)
	_unit_visuals_root.move_child(_skill_vfx, 0)
	return _skill_vfx


## The Origins clip for a unit using a face, or "" when there is none. The voice class is
## CombatAudio's, so a monster with no class of its own picks the same family its sounds come
## from and the two cannot disagree.
func _vfx_key_for(uid: int, face_part: String, face_type: String) -> String:
	if _combat == null:
		return ""
	var u := _combat.by_uid(uid)
	if u == null:
		return ""
	var voice := CombatAudio.voice_class(u.cls, u.key, u.is_boss)
	return SkillVfxCatalog.clip_key(voice, face_part, face_type)


## Draws `clip_key` between the two units. Both screen positions come from the same projection
## and the same stage-offset rebasing _layout_unit_visuals() uses, so the effect sits in the
## overlay space the portraits already agree on. A face with no target (AoE, or a self-buff)
## aims at the attacker's own row-forward direction by borrowing the first live opponent, and
## failing that plays on the spot.
const _SELF_VFX_TYPES := ["mana", "buff", "heal", "shield"]


func _play_skill_vfx(uid: int, target_uid: int, clip_key: String, face_type := "") -> void:
	if clip_key == "" or not is_instance_valid(_stage3d):
		return
	var layer := _ensure_skill_vfx()
	if layer == null:
		return
	var offset: Vector2 = _stage3d.position
	var a := _stage3d.get_unit_screen_pos(uid, CombatStage3D.HEAD_HEIGHT)
	if a.x < 0.0:
		return
	# A face with no opposing target that is about the caster (mana, buff, heal, shield) plays ON the
	# caster. Borrowing the first enemy sent the clip across the whole arena as a screen-sized glow.
	if (target_uid < 0 or target_uid == uid) and _SELF_VFX_TYPES.has(face_type):
		layer.play_on_unit(clip_key, a + offset)
		return
	var tgt := target_uid
	if tgt < 0 or tgt == uid:
		tgt = _first_opposing_uid(uid)
	var b := _stage3d.get_unit_screen_pos(tgt, CombatStage3D.HEAD_HEIGHT) if tgt >= 0 \
		else Vector2(-1, -1)
	if b.x < 0.0:
		b = a + Vector2(0.0, -120.0 if _combat_is_enemy_uid(uid) else 120.0)
	layer.play(clip_key, a + offset, b + offset)


## Somebody on the other side who is still alive, for a face that named no single target.
func _first_opposing_uid(uid: int) -> int:
	if _combat == null:
		return -1
	var want_enemy := not _combat_is_enemy_uid(uid)
	for other in _portraits.keys():
		var o := int(other)
		if _combat_is_enemy_uid(o) != want_enemy:
			continue
		var u := _combat.by_uid(o)
		if u != null and u.hp > 0:
			return o
	return -1


func _unit_name(uid: int) -> String:
	if _combat == null:
		return "?"
	var u := _combat.by_uid(uid)
	if u != null and String(u.custom_state.get("nick", "")) != "":
		return String(u.custom_state["nick"])
	if u != null and u.side == "e" and _enemy_disp.has(uid):
		return String(_enemy_disp[uid])
	return u.n if u != null else "uid#%d" % uid


func _append_log(line: String) -> void:
	_log_lines.append(line)
	if _log_lines.size() > _MAX_LOG_LINES:
		_log_lines.pop_front()
	_log_panel.text = "\n".join(_log_lines)


# ===========================================================================
# Win/Lose — unchanged handoff contract from the skeleton stage (architecture plan §4).
# ===========================================================================

func _finish(won: bool) -> void:
	if _result_shown:
		return
	_result_shown = true
	# Embedded in the tutorial: the fixture owns what happens next. Stop BEFORE
	# apply_combat_result() and before any change_scene_to_file() — see `_tutorial`'s comment.
	# The victory march still plays, because that beat is part of what the tutorial is showing.
	if _tutorial:
		if won:
			await _play_victory_march()
		tutorial_combat_finished.emit(won)
		return
	if not won and not disable_juice_for_tests and _hud_frame != null:
		# R1: the defeat screen decides what happens next. The run result is applied only when
		# the player picks End run, so a Continue (lane A) can still resume the same fight.
		_show_defeat_panel()
		U5Moments.defeat(self)   # UI-05 lane E: red tint pulse under the panel (motion row defeat)
		return
	var applied: Dictionary = await RunState.request_apply_combat_result(_combat.get_result())
		# (was a sync apply_combat_result: the `reward` epoch may need a remote reply now)
	if not bool(applied["ok"]):
		# Nothing was applied: re-arm for EVERY code so the same result can be tried again (RETRY), or, when
		# the session is gone, NetNotice offers SIGN IN / BACK TO MENU. Never a dead screen.
		_result_shown = false
		NetNotice.show(self, String(applied["code"]), func(): _finish(won), "Could not save the fight result")
		return
	if won:
		# Juice pass B: let the surviving party actually march off the field before cutting to
		# RunMap, instead of the previous same-frame overlay-then-scene-change (which meant the
		# "BẠN THẮNG" overlay was never actually visible for a frame in practice). See
		# _play_victory_march()/CombatStage3D.play_victory_march().
		await _play_victory_march()   # runs through the gate, flash, straight on: no mid-screen banner
		_result_overlay.visible = true
		# apply_combat_result() (above) already decided WON vs. a normal win-with-rewards:
		# defeating the run's FINAL boss sets RunState.phase to WON directly (src/engine.js
		# finishCombat() never offers a reward on that path either) — that's the run-complete
		# screen, not the map. RunState.after_node() is deliberately NOT called here for the
		# ordinary-win case: src/engine.js's takeReward() advances s.pw/s.phase strictly AFTER
		# the player picks a reward, so after_node() now only runs from
		# RunMapController._on_reward_chosen(), once a card is actually picked (see
		# RunState._generate_post_combat_rewards()'s ordering-fix note). This scene only ever
		# changes scene; it never advances run state on the ordinary-win path.
		if RunState.phase == RunState.RunPhase.WON:
			_result_label.text = "YOU WIN: RUN COMPLETE"
			get_tree().change_scene_to_file("res://scenes/result/Result.tscn")
		else:
			_result_label.text = "YOU WIN"
			get_tree().change_scene_to_file("res://scenes/run_map/RunMap.tscn")
	else:
		_result_overlay.visible = true
		_result_label.text = "YOU LOSE"
		get_tree().change_scene_to_file("res://scenes/result/Result.tscn")


## Records a hit on the party for the defeat recap (newest last, last 12 kept).
func _record_recap(src_uid: int, tgt_uid: int, value: int) -> void:
	if _combat == null:
		return
	var t := _combat.by_uid(tgt_uid)
	var src := _combat.by_uid(src_uid)
	if t == null or t.side != "p" or src == null or src.side != "e":
		return
	_recap.append({"turn": _combat.turn, "what": "%s hits %s for %d" % [src.n, t.n, value],
		"result": "%s KO" % t.n if t.hp <= 0 else "", "uid": tgt_uid})
	if _recap.size() > 12:
		_recap.pop_front()


func _show_defeat_panel() -> void:
	if _defeat == null:
		_defeat = DefeatPanel.new()
		_defeat.name = "DefeatPanel"
		_defeat.z_index = 40
		_shell_root.add_child(_defeat)
		_defeat.end_run_pressed.connect(_on_defeat_end_run)
		_defeat.continue_pressed.connect(_on_defeat_continue)
	var hs: Dictionary = _hud if not _hud.is_empty() else _hud_state()
	var kind := String(_setup.get("kind", "battle"))
	var asc := RunState.ascension
	var boss_d := {}
	for e in _combat.enemies:
		if e.is_boss:
			var spike_in := int(((hs.get("enemy_next", {}) as Dictionary).get(e.uid, {}) as Dictionary).get("turns_to_spike", 0))
			boss_d = {"name": e.n, "hp": maxi(e.hp, 0), "max_hp": e.max_hp,
				"phase": int(e.custom_state.get("phase", 1)), "phases": 2 if (e.custom_state.has("max_hp2") or e.custom_state.has("hp2")) else 1, "spike_in": spike_in,
				"marks": (ContentDB.combat_tune.get("phase_thresholds", []) as Array).map(
					func(x): return float(x) / 100.0)}
	# Final-turn rows, tinted.
	var last_turn := _combat.turn
	var rows: Array = []
	for r in _recap:
		rows.append({"turn": int(r["turn"]), "what": String(r["what"]), "result": String(r["result"]),
			"final": int(r["turn"]) == last_turn})
	rows = rows.slice(maxi(rows.size() - 5, 0))
	var party: Array = []
	for u in _combat.party:
		if u.roster_index >= 0:
			party.append({"name": u.n, "max_hp": u.max_hp})
	var newcomer := bool(hs.get("newcomer", false))
	var co := AidPurchase.offer("continue", _combat, _tutorial)
	var boss_fight := kind == "boss"
	var price := AidPurchase.list_price("R1", boss_fight)
	var usd := "%s %.2f USD" % [HudKit.glyph(0x2248, "~"), float(price) / 90.0]
	var variant := "paid"
	var was := 0
	var moon := bool(co.get("show", false)) and int(co["price"]) != price and int(co["price"]) > 0
	if moon:
		was = price
		price = int(co["price"])
		variant = "moon"
		usd = "%s %.2f USD" % [HudKit.glyph(0x2248, "~"), float(price) / 90.0]
	if not bool(co["enabled"]):
		usd = AidPurchase.reason_text(String(co["reason"]))
	var gift := bool(co.get("show", false)) and bool(co["enabled"]) and int(co["price"]) == 0
	if gift:
		price = 0
		variant = "gift"
		usd = "free sample"
	var keep := ""
	if not boss_d.is_empty():
		keep = "Boss stays at %d HP, phase %d.%s" % [int(boss_d["hp"]), int(boss_d["phase"]),
			(" Big hit in %d is kept." % int(boss_d["spike_in"])) if int(boss_d["spike_in"]) > 0 else ""]
	else:
		keep = "Enemies keep their HP."
	var clock_on := bool((hs.get("clock", {}) as Dictionary).get("active", false))
	_defeat.show_defeat({
		"title_line": "%s %s A%d %s %d Axies" % [_fight_title(), HudKit.dot(), asc, HudKit.dot(), party.size()],
		"boss": boss_d, "recap": rows, "turn": _combat.turn, "enemies_left": _combat.alive_enemies().size(), "aid_used": int(co["used"]), "aid_cap": int(co["cap"]),
		"asc": asc, "kind_label": "Boss" if boss_fight else ("Elite" if kind == "elite" else "Fight"),
		"continue_left": 1, "heal_pct": 25 if asc >= 6 else 40, "party": party,
		"keep_line": keep,
		"enrage_reset_line": "Enrage resets to 'Enrage in 10'." if clock_on else "",
		"attrition_reset_line": "" if newcomer else "Attrition resets to 0%.",
		"price": price, "price_was": was, "usd": usd, "variant": variant,
		"continue_show": bool(co.get("show", false)) and not _tutorial, "continue_enabled": bool(co["enabled"]),
		"continue_reason": AidPurchase.reason_text(String(co["reason"])),
		"mission": String(co["reason"]) == "mission_run",
		"need_more": maxi(price - MetaState.gem_wallet().balance(), 0) if String(co["reason"]) == "no_gems" else 0,
		# UI-05 30-defeat normal: Get Gem. No in-run Gem shop exists and USD buying is off in the playtest, so the
		# button is drawn disabled and says why (open question for Liam: where Get Gem should lead).
		"get_gem_reason": StoreScreen.USD_REASON,
		"foot": "Continue is offered once per run." if not gift else "This gift is offered once per account and is used as the run's Continue."})


func _on_defeat_continue() -> void:
	if _combat.epoch_pending:
		return
	if _defeat != null:
		_defeat.set_busy(true)
	var res: Dictionary = await AidPurchase.buy("continue", _combat, [], _tutorial)
	if is_inside_tree() and _defeat != null:
		_defeat.set_busy(false)
	if is_inside_tree() and not bool(res["ok"]) and String(res["code"]) == "net":
		NetNotice.show(self, String(res.get("net_code", "offline")), _on_defeat_continue, "Could not use Continue")
	_append_log("[aid] continue : %s" % ("ok (-%d Gem)" % int(res["charged"]) if bool(res["ok"]) else String(res["code"])))
	if not bool(res["ok"]):
		return
	if _defeat != null:
		_defeat.visible = false
	_rebuild_all()
	_save_run_progress()


func _on_defeat_end_run() -> void:
	RunState.apply_combat_result(_combat.get_result())   # a lost fight draws no epoch
	_result_overlay.visible = true
	_result_label.text = "YOU LOSE"
	get_tree().change_scene_to_file("res://scenes/result/Result.tscn")


## Gathers the currently-alive party (dead members already faded out via play_death() and should
## not un-hide/move) and hands their uids to CombatStage3D's actual Tween/anim-clip logic.
func _play_victory_march() -> void:
	if not is_instance_valid(_stage3d) or _combat == null:
		return
	var uids: Array = []
	for u in _combat.party:
		if u.hp > 0:
			uids.append(u.uid)
	_exit_running = true
	# UI-03 45: only the 3D stage + title + Skip. Restored below in case the scene stays in combat.
	var hidden: Array[CanvasItem] = []
	var to_hide: Array = [_hud_frame, _aid, _tray_root, _dock_plate]
	to_hide.append_array(_portraits.values())   # enemy plates + status chips
	for n in to_hide:
		if is_instance_valid(n) and (n as CanvasItem).visible:
			(n as CanvasItem).visible = false
			hidden.append(n)
	var march_ui := _build_march_overlay()
	U5Moments.adopt_march_overlay(self, march_ui)   # UI-05 lane E: the Victory band replaces the title plate + Skip
	await _stage3d.play_victory_march(uids, _VICTORY_MARCH_DISTANCE,
		_VICTORY_RUN_DURATION if _stage3d.has_gate() else _VICTORY_MARCH_DURATION)
	_exit_running = false
	for n in hidden:
		if is_instance_valid(n):
			n.visible = true
	if is_instance_valid(march_ui):
		march_ui.queue_free()
	U5Moments.end_victory(self)


## UI-03 45: title plate (top centre) + Skip chip (bottom right, focused). Visual only: Esc / Space /
## Enter / click already skip through _input(); the button just makes that visible and focusable.
func _build_march_overlay() -> CanvasLayer:
	var layer := CanvasLayer.new()
	layer.name = "VictoryMarchUI"
	layer.layer = 20
	add_child(layer)
	var root := Control.new()
	root.set_anchors_preset(Control.PRESET_FULL_RECT)
	root.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.add_child(root)
	var top := VBoxContainer.new()
	top.set_anchors_preset(Control.PRESET_TOP_WIDE)
	top.offset_top = 48
	top.alignment = BoxContainer.ALIGNMENT_BEGIN
	top.add_theme_constant_override("separation", 12)
	top.mouse_filter = Control.MOUSE_FILTER_IGNORE
	root.add_child(top)
	var plate := UI3.plate()
	plate.mouse_filter = Control.MOUSE_FILTER_IGNORE
	plate.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	var m := MarginContainer.new()
	for side in ["left", "right"]:
		m.add_theme_constant_override("margin_" + side, 32)
	for side in ["top", "bottom"]:
		m.add_theme_constant_override("margin_" + side, 12)
	m.mouse_filter = Control.MOUSE_FILTER_IGNORE
	plate.add_child(m)
	var title := UI3.label("Victory!", "LabelScreenTitle")
	title.name = "MarchTitle"
	m.add_child(title)
	top.add_child(plate)
	var skip := UI3.button("Skip  " + KeyBindings.text(KeyBindings.MENU_BACK), &"secondary", &"S")
	skip.name = "MarchSkip"
	skip.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	skip.pressed.connect(func() -> void: _stage3d.skip_victory_march())
	top.add_child(skip)
	skip.grab_focus()
	return layer


# ---- Depth v4 BO (combat-v4.md 1) ------------------------------------------------------------------------
var _bo_layer: BoLayer = null


## Part chip, SET ring and SET preview for one tray card (UI-05 DieCard). Every number is the engine's (SetPreview): before =
## _face_base (floored at 0), after = _live_face_value, the same number the die face shows and deals.
func _v4_card_data(u: Unit) -> Dictionary:
	var out := {"part_text": "", "part_word": "", "part_tex": null, "set_key": "", "set_before": 0, "set_after": 0, "set_show": false,
		"cracked": u.cracked and _combat.depth_stage >= 2, "rr_tick": _rr_mode and _rr_sel.has(u.uid)}
	if _rr_mode:
		var why := _rr_die_why(u)
		if why != "":
			out["tip"] = "%s\n%s" % [why, _tray_tooltip(u)]
		out["legal_target"] = bool(out["rr_tick"])
	if _wild_mode:
		out["legal_target"] = _wild_valid(u.uid) or u.uid == _wild_uid
		if _wild_uid == u.uid:
			out["rr_tick"] = false
		elif not _wild_valid(u.uid) and u.roll_used():
			out["tip"] = "%s\n%s" % [TranslationServer.translate("Used"), _tray_tooltip(u)]
	out["wild_text"] = V4Ui.part_name(u.wild_slot) if u.wild_slot >= 0 else ""
	if bool(out["cracked"]):
		out["tip"] = "%s\n%s" % [_tray_tooltip(u), TranslationServer.translate("Cracked: half value, out of the Set. Ends next turn.")]
	if u.hp <= 0 or not u.has_rolled() or _combat == null:
		return out
	var fi := u.roll_face_index()
	# A Temp Face (Wild) counts as its new part: the chip shows that part (HTML set-4: Puffy's die reads "Mouth").
	var slot := u.wild_slot if u.wild_slot >= 0 else clampi(fi, 0, 5)
	var part := String(V4Ui.SLOT_ORDER[slot])
	out["part_text"] = V4Ui.part_name(slot)
	out["part_word"] = SetBanner.part_word(slot)
	var face_part := part if u.wild_slot >= 0 else String((u.die[fi] as Dictionary).get("part", part))
	out["part_tex"] = _part_icon_for(face_part, u.cls)
	var pv := SetPreview.for_die(self, u)
	out["set_key"] = pv["key"]
	out["set_before"] = pv["before"]
	out["set_after"] = pv["after"]
	out["set_show"] = pv["show"]
	return out


func _card_rects() -> Dictionary:
	var rects := {}
	var units := _party_dice_units()
	for i in mini(units.size(), _die_slot_buttons.size()):
		var b: Button = _die_slot_buttons[i]
		if b.visible:
			var gr := b.get_global_rect()
			var inv := _bo_layer.get_global_transform().affine_inverse() if _bo_layer != null else Transform2D.IDENTITY
			rects[(units[i] as Unit).uid] = Rect2(inv * gr.position, gr.size)
	return rects


## Real M of a Set group for the SetBanner: the engine's group value (Anchor add, Core set_add, Overcast, cap). Per-die extras
## (a carried Embers die) stay on the die's own number via m100_for, so one die never decides the whole SET's banner.
func _bo_group_m100(g: Dictionary) -> int:
	return SetPreview.group_m100(_combat, g)


## SetBanner extras for an engine group: the part glyph (class of the first die in it), the OVERCAST mark, and the tooltip. When
## Overcast can be used on this SET now, the tooltip adds the ESTIMATE of one more Overcast (SetPreview.overcast_estimate).
func _bo_group_info(g: Dictionary) -> Dictionary:
	var out := {"tex": null, "overcast": false, "tip": ""}
	if _combat == null:
		return out
	var uids: Array = g["uids"]
	var part := int(g["part"])
	var m100 := _bo_group_m100(g)
	var lines := PackedStringArray([TranslationServer.translate("%s: every die in this SET is multiplied by %s.") % [
		SetBanner.text_for(int(g["size"]), m100, part), V4Ui.mult_text(m100)]])
	var oc_ok := false
	for id in uids:
		var d: Unit = _combat.by_uid(int(id))
		if d == null:
			continue
		if out["tex"] == null:
			out["tex"] = _part_icon_for(String(V4Ui.SLOT_ORDER[clampi(part, 0, 5)]), d.cls)
		if d.overcast:
			out["overcast"] = true
		if not oc_ok and _combat.overcast_block_reason(d.uid) == "":
			oc_ok = true
	if oc_ok:
		var est := PackedStringArray()
		for id in uids:
			var d: Unit = _combat.by_uid(int(id))
			if d == null or d.roll_used():
				continue
			var b := SetPreview.before_value(_combat, d, d.roll_face_index())
			if b > 0:
				est.append(SetPreview.delta_text(b, SetPreview.overcast_estimate(_combat, g, b)))
		lines.append(TranslationServer.translate("With Overcast, about %s: %s") % [
			V4Ui.mult_text(SetPreview.overcast_m100(_combat, g)), " · ".join(est)])
	out["tip"] = "\n".join(lines)
	return out


func _refresh_bo_layer() -> void:
	if _bo_layer == null or _combat == null:
		return
	_bo_layer.refresh(_combat.bo)


func _on_bo_changed(groups: Array) -> void:
	if _bo_layer == null or _combat == null:
		return
	_refresh_bo_layer()
	_dd()._refresh_set_marks()
	var tray_top := TrayColumn.dock_top(get_viewport_rect().size.y)
	_bo_layer.announce(groups, tray_top)
	_log_bo_changes(groups)
	_sync_row_labels()


var _bo_logged: Dictionary = {}   # part -> size already written to the log this turn


## One log line per NEW or HIGHER Set ("[set] HORN x4  ×1.8"), never repeated for the same size.
func _log_bo_changes(groups: Array) -> void:
	var live := {}
	for g in groups:
		var part := int(g["part"])
		var sz := int(g["size"])
		live[part] = sz
		if sz > int(_bo_logged.get(part, 0)):
			_dm_audio.play("dm_set%d" % clampi(sz, 3, 5))
			_append_log("[set] %s x%d  %s" % [V4Ui.part_name(part), sz, V4Ui.mult_text(int(g["m100"]))])
	_bo_logged = live


## UI-05: the SET banners have their own row above the FRONT / BACK header, so the words always show.
func _sync_row_labels() -> void:
	if _row_strip == null or _combat == null:
		return
	for c in _row_strip.get_children():
		if c is Label:
			c.visible = true


# ---- Depth v4 Wild face (combat-v4.md 3) ---------------------------------------------------------------------
var _wild_mode := false
var _wild_uid := -1
var _wild_picker: WildPicker = null


func _wild_valid(uid: int) -> bool:
	for slot in 6:
		if _combat.can_wild_face(uid, slot):
			return true
	return false


func _wild_any_valid() -> bool:
	for u in _party_dice_units():
		if _wild_valid((u as Unit).uid):
			return true
	return false


func _wild_state(executing: bool) -> Dictionary:
	var used: bool = _combat.wild_used >= _combat.wild_per_battle()
	var d := V4Ui.wild_button(_combat.depth_stage >= 2, used, _combat.mana, _combat.wild_cost(), _wild_any_valid())
	if not executing:
		d["enabled"] = false
		d["tip"] = TranslationServer.translate("Only on your turn.")
	d["show"] = _combat.depth_stage >= 2
	return d


func _enter_wild_mode() -> void:
	_coach_hide()
	_land_dice_now()
	if _is_animating or _gated("wild") or not _wild_any_valid():
		return
	_rr_mode = false
	_rr_sel.clear()
	_selected_die_uid = -1
	_wild_mode = true
	_wild_uid = -1
	_rebuild_all()


func _exit_wild_mode() -> void:
	if not _wild_mode:
		return
	_wild_mode = false
	_wild_uid = -1
	_rebuild_all()


func _wild_pick_die(uid: int) -> void:
	if not _wild_valid(uid):
		return
	_wild_uid = uid
	_rebuild_all()


func _on_wild_chosen(slot: int) -> void:
	# SR0: one seed request in flight = no other dice action (never queue a second action on an unknown result)
	if _combat.epoch_pending:
		return
	if not _wild_mode or _wild_uid == -1:
		return
	if _combat.wild_face(_wild_uid, slot):
		_append_log("[input] wild face")
		_wild_mode = false
		_wild_uid = -1
		_rebuild_all()
		_save_run_progress()


func _update_wild_picker() -> void:
	if _combat == null or _hud_frame == null:
		return
	if _wild_mode and not (_combat.phase == CombatPhase.EXECUTE and not (_combat.won or _combat.lost)):
		_wild_mode = false
		_wild_uid = -1
	if _wild_picker == null:
		_wild_picker = WildPicker.new()
		_wild_picker.z_index = 9
		_shell_root.add_child(_wild_picker)
		_wild_picker.picked.connect(_on_wild_chosen)
	_wild_picker.visible = _wild_mode and _wild_uid != -1
	if _wild_mode:
		for b in [_hud_frame.undo_button, _hud_frame.reroll_button, _hud_frame.hold_button, _hud_frame.overcast_button, _hud_frame.wild_button]:
			(b as Control).visible = false
	if not _wild_picker.visible:
		return
	var cur := V4Ui.group_of(_combat.bo, _wild_uid)
	var rows: Array = []
	var best := -1
	var best_key := 0
	for slot in 6:
		var pv: Dictionary = _combat.preview_wild(_wild_uid, slot)
		var line := V4Ui.wild_line(pv, _wild_uid, cur)
		var key := 0
		if bool(pv["ok"]) and line.begins_with("→"):
			var g := V4Ui.group_of(pv["groups"], _wild_uid)
			key = int(g["size"]) * 1000 + int(g["m100"])
		if key > best_key:
			best_key = key
			best = slot
		var wu: Unit = _combat.by_uid(_wild_uid)
		rows.append({"ok": bool(pv["ok"]), "label": line, "best": false,
			"tex": _part_icon_for(String(V4Ui.SLOT_ORDER[slot]), wu.cls if wu != null else "")})
	if best >= 0:
		rows[best]["best"] = true
	_wild_picker.update(rows)
	var vs := get_viewport_rect().size
	var tray_top := TrayColumn.dock_top(vs.y)
	_wild_picker.position = Vector2((vs.x - _wild_picker.size.x) * 0.5, tray_top - _wild_picker.size.y - 12.0)


# ---- Depth v4 coach (combat-v4.md 5.3) -----------------------------------------------------------------------
var _coach_box: PanelContainer = null
var _coach_label: Label = null
var _coach_turn := -1
var coach_shown_id := ""                 # test hook


func _coach_hide() -> void:
	if _coach_box != null:
		_coach_box.visible = false


func _update_coach() -> void:
	if _combat == null or _shell_root == null:
		return
	if CombatView.disable_juice_for_tests and not V4Coach.enabled_in_tests:
		return
	if _tutorial or not V4Coach.enabled:
		return
	var banner_up: bool = _bo_layer != null and _bo_layer.banner_up()
	var executing := _combat.phase == CombatPhase.EXECUTE and not (_combat.won or _combat.lost)
	if not executing or _rr_mode or _wild_mode or banner_up or _dice_in_air():
		_coach_hide()
		return
	if _coach_turn == _combat.turn:
		return   # one bubble per turn (it stays until the turn changes, an action opens a mode, or it is skipped)
	var parts := {}
	var rolled := false
	for u in _party_dice_units():
		if u.hp > 0 and u.has_rolled() and not u.is_token:
			rolled = true
			var fi: int = u.roll_face_index()
			parts[fi] = int(parts.get(fi, 0)) + 1
	var pair := false
	var set3 := false
	for k in parts:
		if int(parts[k]) == 2:
			pair = true
		if int(parts[k]) == 3:
			set3 = true
	var has_shell := false
	for e in _combat.enemies:
		if e.hp > 0 and int(e.custom_state.get("shell", 0)) > 0:
			has_shell = true
	var id := V4Coach.next_id({"shell": has_shell, "stage": _combat.depth_stage, "rolled": rolled, "pair": pair, "set3": set3, "bo": not _combat.bo.is_empty(),
		"free_left": _combat.rerolls, "payable": _combat.reroll_is_payable(), "mana": _combat.mana,
		"reroll_cost": _combat.reroll_mana_cost(false, 1), "wild_cost": _combat.wild_cost(), "oc_cost": _combat.overcast_cost()})
	if id == "":
		return
	V4Coach.mark(id)
	_coach_turn = _combat.turn
	coach_shown_id = id
	if _coach_box == null:
		_coach_box = UI3.plate(&"plate")
		_coach_box.name = "V4Coach"
		_coach_box.z_index = 9
		var row := HBoxContainer.new()
		row.add_theme_constant_override("separation", 16)
		_coach_label = UI3.label("")
		_coach_label.add_theme_font_size_override("font_size", UI3Theme.size_of("text_body"))
		_coach_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		_coach_label.custom_minimum_size = Vector2(520, 0)
		row.add_child(_coach_label)
		var skip := UI3.button(TranslationServer.translate("Skip"), &"quiet")
		skip.pressed.connect(_coach_hide)
		row.add_child(skip)
		_coach_box.add_child(row)
		_shell_root.add_child(_coach_box)
	_coach_label.text = V4Coach.text_for(id)
	_coach_box.visible = true
	_coach_box.size = Vector2.ZERO
	var vs := get_viewport_rect().size
	var w := _coach_box.get_combined_minimum_size().x
	_coach_box.position = Vector2((vs.x - w) * 0.5, TrayColumn.dock_top(vs.y) - 190.0)
