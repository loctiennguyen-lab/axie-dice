## Hit / crit / big hit (>= 25% of the target's max HP, or a knockout; client-side).
func _hit_moment_id(uid: int, value: int, crit: bool) -> String:
	var t := _combat.by_uid(uid) if _combat != null else null
	if t != null and value > 0 and (t.hp <= 0 or float(value) >= 0.25 * float(maxi(t.max_hp, 1))):
		return "big_hit"
	return "crit" if crit else "hit"


var _last_shield: Dictionary = {}   ## uid -> shield seen at the last hp_changed (shield-gained detection)


func _on_hit_landed(src_uid: int, uid: int, value: int, crit: bool) -> void:
	# The log line is NOT deferred. It is a transcript, its order is the engine's, and
	# interleaving it with animation timing is how a log stops matching the run it describes.
	_append_log("[hit] %s -> %s : %d%s" % [_unit_name(src_uid), _unit_name(uid), value, " CRIT" if crit else ""])
	_record_recap(src_uid, uid, value)
	_after_impact(func():
		if is_instance_valid(_stage3d):
			_stage3d.play_hit_reaction(uid)   # `uid` is whoever just TOOK this hit — see
				# CombatStage3D.play_hit_reaction()'s own comment for the damage_pipeline.gd cross-check
		var mid := _hit_moment_id(uid, value, crit)
		U5Moments.on_hit(self, uid, mid)   # UI-05 lane E: tag, flash, sweep, sparks, hit-stop (motion rows hit/crit/big_hit)
		_play_hit_juice(mid))

func _on_unit_died(uid: int) -> void:
	_append_log("[death] %s" % _unit_name(uid))
	var p: UnitPortrait = _portraits.get(uid)
	var dead := _combat.by_uid(uid) if _combat != null else null
	if dead != null and dead.side == "p":
		U5Moments.axie_ko(self, uid)   # UI-05 lane E (motion row axie_ko)
	if p != null:
		p.play_death_fade()
	if is_instance_valid(_stage3d):
		_stage3d.play_death(uid)   # plays the real Dead clip first, THEN the scale-to-zero fade
			# once that clip's own on_complete callback fires — see CombatStage3D.play_death()
	_rebuild_all()

func _on_face_used(uid: int, _side: String, target_uid: int, aoe: bool, face_part: String, _face_name: String, face_type: String) -> void:
	# Cached so _on_hit_landed() (whose own payload has no face_part) can build a player-facing
	# sentence — see _player_hit_line(). Raw debug line below is UNCHANGED from the pre-review
	# pass (t_face_used_log_tag.gd regression-tests its exact "[AOE]" tagging logic).
	_last_face_used_by_uid[uid] = {"part": face_part, "type": face_type}
	var tgt := _unit_name(target_uid) if target_uid >= 0 else "-"
	var show_aoe_tag := aoe and face_type != "mana" and face_type != "summon"
	_append_log("[use] %s -> %s (%s/%s)%s" % [_unit_name(uid), tgt, face_part, face_type, " [AOE]" if show_aoe_tag else ""])
	if is_instance_valid(_stage3d):
		# The clip is resolved HERE, not in the stage: this is the side that can see the Unit
		# (class, key, boss flag) and the face's body part. The stage only needs to know
		# whether it came out ranged, which decides lunge vs plant-and-fire.
		var vfx_key := _vfx_key_for(uid, face_part, face_type)
		_stage3d.play_action(uid, face_type, target_uid, vfx_key)   # "ra chiêu" — clip/pace
			# varies by face_type (_ACTION_ANIM_BY_TYPE), and `target_uid` is what lets the
			# lunge aim at the unit being hit instead of just stepping forward
		_play_skill_vfx(uid, target_uid, vfx_key, face_type)

