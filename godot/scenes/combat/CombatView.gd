## Body-part icon for the die tray (review-uiux-godot-vs-web.md P1 #3) — web/part/<slot>_<class>
## .svg, the same files godot/tests/t_assets.gd gates for all 6 slots x 6 classes. Returns null
## for a class with no matching file (non-hero enemies have cls=="" and never appear in the die
## tray — _party_dice_units() only returns units with roster_index >= 0 — so in practice this
## null path is unreachable from the die tray itself, but stays a safe no-icon fallback rather
## than an error if that ever changes).
## Rendered from the class's own 3D rig by tools/render_portraits.tscn. Returns null for a
## unit with no class (every non-hero enemy), which the TextureRect draws as nothing — those
## never appear in the dice tray anyway.
func _class_portrait(cls: String) -> Texture2D:
	if cls == "":
		return null
	var key := "portrait_%s" % cls
	if not _part_icon_cache.has(key):
		var path := "res://assets/portraits/%s.png" % cls
		_part_icon_cache[key] = load(path) if ResourceLoader.exists(path) else null
	return _part_icon_cache[key]


## The six body-part icons, per class. Returns null when there is no icon for this
## part/class pair, and the caller draws the card without one.
##
## The existence check is not defensive padding: the set on disk is exactly six slots x six
## classes, and a SUMMONED TOKEN's faces carry part "m" — the same placeholder every enemy
## face uses — so "m_aqua" has never existed. Until tokens got a die card nothing ever asked
## for it. `load()` on a missing path logs a red engine error every rebuild, several times a
## second, which is noise that buries real ones.
func _part_icon_for(part: String, cls: String) -> Texture2D:
	if cls == "":
		return null
	var slot := String(_PART_ICON_SLOT.get(part, part))
	var key := "%s_%s" % [slot, cls]
	if not _part_icon_cache.has(key):
		var path := "res://assets/icons/web/part/%s.svg" % key
		_part_icon_cache[key] = load(path) if ResourceLoader.exists(path) else null
	return _part_icon_cache[key]


# ===========================================================================
# Unit inspector (src/client.html scUnitInfo(), :6945)
#
# The gap this closes: a player could read their OWN dice off the tray cards, but an enemy's
# die was not readable anywhere. Twenty-one monsters and six bosses, each with six faces, and
# the only way to learn any of it was to be hit by it. That is not difficulty, it is hidden
# information in a game whose own rule spec calls for "minh bạch triệt để" — total transparency.
# ===========================================================================

## Opens the inspector for `uid`. Built fresh each time rather than kept and repainted: it is
## a modal the player dismisses, the data behind it is a snapshot of one moment, and a stale
## panel showing last turn's HP would be worse than no panel.
func _open_unit_inspect(uid: int) -> void:
	if _combat == null:
		return
	var u := _combat.by_uid(uid)
	if u == null:
		return
	_close_unit_inspect()
	_inspect_panel = _build_unit_inspect(u, false)
	if not _inspect_fits:
		# Too tall for the free space beside this unit: rebuild once with tighter spacing (and, if that is
		# still too tall, the plate scrolls inside the free space, see _place_unit_inspect).
		_close_unit_inspect()
		_inspect_panel = _build_unit_inspect(u, true)


## I: the unit under the cursor, else the first living enemy (keyboard-only play). I again closes it.
func _inspect_hotkey() -> void:
	if _inspect_panel != null and is_instance_valid(_inspect_panel):
		_close_unit_inspect()
		return
	if _combat == null or _aid != null and _aid.modal_open():
		return
	var uid := _stage3d.pick_unit_at_global(get_viewport().get_mouse_position())
	if uid == -1:
		var foes := _combat.alive_enemies()
		if foes.is_empty():
			return
		uid = foes[0].uid
	_open_unit_inspect(uid)


func _close_unit_inspect() -> void:
	if _inspect_panel != null and is_instance_valid(_inspect_panel):
		var layer := _inspect_panel.get_parent()
		# Detach BEFORE queue_free(). queue_free() is deferred to the end of the frame, so a
		# panel closed and reopened within one frame — which is exactly what _open_unit_inspect()
		# does — would leave the old full-screen click blocker in the tree, still swallowing
		# input, behind the new one. Removing it first makes the close immediate.
		if layer != null and layer.get_parent() != null:
			layer.get_parent().remove_child(layer)
		if layer != null:
			layer.queue_free()
	_inspect_panel = null


## The unit inspector (UI-03 round 2 screen 42): a 520 wide wood plate beside the unit (flips to the other
## side at the screen edge). It reads state and changes none: no scrim, no input capture outside the plate, so
## a die can stay selected while it is open. Openers: right-click (stage or nameplate), I, long-press 500 ms
## on a unit (touch, see CombatStage3D). Esc closes. Focus starts on the plate; Tab walks the face rows.
## Header: name + HP, bar. Rows: statuses, next move (enemy), passive, then all six faces with LIVE values
## (CombatEngine._face_value: growth, weaken, blind and overdrive are in the number).
## States: enemy, party Axie, egg (a summoned token, roster_index < 0).
const INSPECT_W := 520.0
## Top of the party-row zone (heads, chips, dice tray). The plate never covers anything below this line
## between the first and last party column (also the line the Axie status chips are clamped to).
const PARTY_ZONE_TOP := 622.0
var _inspect_compact := false
var _inspect_fits := true


func _build_unit_inspect(u: Unit, compact := false) -> Control:
	_inspect_compact = compact
	var layer := CanvasLayer.new()
	layer.layer = 28          # under the quit confirm (30), over the HUD
	add_child(layer)
	var plate := UI3.plate(&"dialog")
	plate.name = "UnitInspector"
	plate.custom_minimum_size = Vector2(INSPECT_W, 0)
	plate.focus_mode = Control.FOCUS_ALL
	layer.add_child(plate)
	var col := VBoxContainer.new()
	col.name = "InspectCol"
	col.add_theme_constant_override("separation", 6 if compact else UI3Theme.space("16"))
	plate.add_child(col)

	var is_egg := u.side == "p" and u.roster_index < 0
	var head := HBoxContainer.new()
	col.add_child(head)
	var nm := UI3.label(u.n, "LabelTitle")
	nm.name = "UnitName"
	nm.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	nm.clip_text = true
	head.add_child(nm)
	var tag := "Egg" if is_egg else ("Boss" if (u.side == "e" and u.is_boss) else ("Enemy" if u.side == "e" else "Axie"))
	var hp_l := UI3.label("%s · %d / %d HP" % [TranslationServer.translate(tag), maxi(u.hp, 0), maxi(u.max_hp, 1)], "LabelDisplay")
	hp_l.add_theme_font_size_override("font_size", UI3Theme.size_of("text_body"))
	head.add_child(hp_l)
	col.add_child(UI3.hp_bar(maxi(u.hp, 0), maxi(u.max_hp, 1), maxi(u.shield, 0), int(u.status.get("poison", 0)),
		&"enemy" if u.side == "e" else &"axie"))

	var chips := HFlowContainer.new()
	chips.name = "Statuses"
	chips.add_theme_constant_override("h_separation", 8)
	chips.add_theme_constant_override("v_separation", 8)
	if u.shield > 0:
		chips.add_child(UI3.status_label_chip("shield", u.shield))
	for key in u.status.keys():
		if int(u.status[key]) > 0:
			chips.add_child(UI3.status_label_chip(String(key), int(u.status[key])))
	if chips.get_child_count() > 0:
		col.add_child(chips)

	_inspect_rows(col, u)
	_inspect_faces(col, u)
	col.add_child(_inspect_close_hint())
	_place_unit_inspect(plate, u)
	_focus_inspect_plate.call_deferred(plate)
	return plate


func _focus_inspect_plate(plate: Control) -> void:
	if is_instance_valid(plate) and plate.is_inside_tree():
		plate.grab_focus()


func _inspect_close_hint() -> Control:
	var row := HBoxContainer.new()
	row.name = "CloseHint"
	row.alignment = BoxContainer.ALIGNMENT_END
	row.add_theme_constant_override("separation", UI3Theme.space("8"))
	row.add_child(UI3.label(TranslationServer.translate("Close"), "LabelMuted"))
	row.add_child(UI3.key_hint(KeyBindings.text(KeyBindings.MENU_BACK)))
	return row


## One labelled text row on a wood-2 cell: muted label over wrapped value (max 120 chars, ~320 wide).
func _cell_pad(cell: Control, inner: Control) -> void:
	var pad := MarginContainer.new()
	for side in ["left", "right", "top", "bottom"]:
		var m := 12
		if _inspect_compact and (side == "top" or side == "bottom"):
			m = 4
		pad.add_theme_constant_override("margin_" + side, m)
	cell.add_child(pad)
	pad.add_child(inner)


func _inspect_info_row(label_text: String, value: String) -> Control:
	var cell := UI3.plate(&"row")
	cell.name = "InfoRow"
	cell.focus_mode = Control.FOCUS_ALL
	UI3.attach_focus_ring(cell)
	var v := VBoxContainer.new()
	v.add_theme_constant_override("separation", 0)
	_cell_pad(cell, v)
	v.add_child(UI3.label(TranslationServer.translate(label_text), "LabelMuted"))
	var b := UI3.label(value)
	b.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	b.custom_minimum_size = Vector2(INSPECT_W - 100.0, 0)
	v.add_child(b)
	return cell


func _inspect_rows(col: VBoxContainer, u: Unit) -> void:
	if u.side == "e":
		var ri: int = u.roll_face_index()
		if ri >= 0 and ri < u.die.size():
			var f: Dictionary = u.die[ri]
			var ft := String(f.get("type", ""))
			var txt: String = TranslationServer.translate("Does nothing") if ft == "blank" else _face_description(
				ft, _live_face_value(u, ri), _face_has_kw(f, "aoe"), f)
			col.add_child(_inspect_info_row("Next move", txt))
		var role := String(u.role)
		col.add_child(_inspect_info_row("Passive" if role == "" else role.capitalize(),
			"It rolls and commits before you act. The plate over its head shows this turn's move."))
	elif u.side == "p" and not (u.roster_index < 0) and ContentDB.CLASS_PASSIVE.has(u.cls):
		var pas: Dictionary = ContentDB.CLASS_PASSIVE[u.cls]
		col.add_child(_inspect_info_row("Passive · %s" % String(pas.get("n", "")), String(pas.get("d", ""))))
	elif u.roster_index < 0:
		col.add_child(_inspect_info_row("Egg", "A summoned token. It rolls a small die and falls when its HP runs out."))


## Maps a game face type to the UI3 face key (dmg is "attack"; debuff is "weaken").
static func _ui3_face(game_type: String) -> StringName:
	return UI3.face_key(game_type)


## Rects the plate must not cover: the party row with the dice tray under it (from the first to the last
## column, y from PARTY_ZONE_TOP down), the Aid zone bottom-left, the reroll / undo / End turn cluster.
func _inspect_blockers() -> Array[Rect2]:
	var out: Array[Rect2] = []
	var vs := get_viewport_rect().size
	var x0 := INF
	var x1 := -INF
	for pu in _combat.alive_party():
		var at := _stage3d.get_unit_screen_pos(pu.uid, CombatStage3D.FEET_HEIGHT)
		if at.x >= 0.0:
			var gx := _stage3d.get_global_rect().position.x + at.x
			x0 = minf(x0, gx - 90.0)
			x1 = maxf(x1, gx + 90.0)
	for b in _die_slot_buttons:
		if (b as Control).visible:
			var r := (b as Control).get_global_rect()
			x0 = minf(x0, r.position.x)
			x1 = maxf(x1, r.end.x)
	if x1 > x0:
		# the status chips float just above PARTY_ZONE_TOP (up to ~36 px): keep them readable too
		out.append(Rect2(x0, PARTY_ZONE_TOP - 30.0, x1 - x0, vs.y - PARTY_ZONE_TOP + 30.0))
	if _aid != null and _aid.enabled:
		var t := _aid.top_y()
		out.append(Rect2(0.0, t - 8.0, AidPanel.TRAY_W + 2.0 * AidPanel.EDGE, vs.y - t + 8.0))
	var cluster := Rect2()
	var first := true
	var cluster_btns: Array = [_reroll_button, _undo_button, _end_turn_button]
	if _hud_frame != null:
		cluster_btns.append_array([_hud_frame.hold_button, _hud_frame.wild_button, _hud_frame.overcast_button])
	for c in cluster_btns:
		if c != null and (c as Control).visible:
			var r := (c as Control).get_global_rect()
			cluster = r if first else cluster.merge(r)
			first = false
	if not first:
		out.append(cluster.grow(8.0))
	return out


## Puts the plate beside the unit: right of it when that side has room, else left, clamped inside the screen
## and never over a blocker (see _inspect_blockers). When the free height is short (a party Axie sits IN the
## row, so the plate lives above the row) the caller rebuilds compact, and a plate that still does not fit
## scrolls inside the free space (fit-or-scroll). Sets _inspect_fits.
func _place_unit_inspect(plate: Control, u: Unit) -> void:
	var vp := get_viewport_rect().size
	var at := _stage3d.get_unit_screen_pos(u.uid, 1.0)
	var origin := _stage3d.get_global_rect().position + (at if at.x >= 0.0 else _stage3d.size * 0.5)
	var blockers := _inspect_blockers()
	var ph := plate.get_combined_minimum_size().y
	var pw := maxf(INSPECT_W, plate.get_combined_minimum_size().x)
	var best_x := 16.0
	var best_cap := -1.0
	for side in [1.0, -1.0]:
		var x: float = origin.x + 110.0 if side > 0.0 else origin.x - 110.0 - pw
		x = clampf(x, 16.0, maxf(vp.x - pw - 16.0, 16.0))
		var cap_bottom := vp.y - 16.0
		for r in blockers:
			if x < r.end.x and x + pw > r.position.x:
				cap_bottom = minf(cap_bottom, r.position.y - 12.0)
		var cap := cap_bottom - 16.0
		if cap > best_cap:
			best_cap = cap
			best_x = x
		if best_cap >= ph:
			break
	var cap_bottom_final := 16.0 + best_cap
	_inspect_fits = ph <= best_cap
	if not _inspect_fits and _inspect_compact:
		var col: Control = plate.get_node("InspectCol")
		var chrome := ph - col.get_combined_minimum_size().y
		plate.remove_child(col)
		var sc := ScrollContainer.new()
		sc.name = "InspectScroll"
		sc.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
		sc.follow_focus = true
		sc.custom_minimum_size = Vector2(0, maxf(best_cap - chrome, 120.0))
		col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		sc.add_child(col)
		plate.add_child(sc)
		ph = plate.get_combined_minimum_size().y
		_inspect_fits = true
	var y := clampf(origin.y - ph * 0.5, 16.0, maxf(cap_bottom_final - ph, 16.0))
	plate.position = Vector2(best_x, y)
	plate.size = Vector2(pw, ph)


## THE number a face will actually produce — and the ONLY one the player should ever be shown.
##
## `u.die[fi].value` is the face's PRINTED value and it is not what happens. CombatEngine folds
## growth, vital-at-full-HP, blind, weaken, boss overdrive, the Aqua CONDUIT passive and the
## hiveMind relic on top of it in `_face_value()`, and that is what `_do_face()` then deals. The
## unit inspector has always shown that number; the die card, the damage preview and the enemy
## intent badge were all reading the printed one, so a grown Axie's card said 3 while its own
## inspector said 4 and it hit for 4 (bug report 2026-09-21). One number, one source, five call
## sites.
##
## FLAGGED: `_face_value()` is private on CombatEngine and this is a reach-through. It is the
## SAME reach-through _inspect_faces() has always made — this function exists so there is one
## of them in this file rather than five. The better shape is a public read-only `face_value()`
## on CombatEngine; it was not taken here because `scripts/core` is fingerprinted by
## t_rules_version.gd and moving that fingerprint for a pure display fix buys nothing. Worth
## doing the next time that file is opened for a real reason.
func _live_face_value(u: Unit, fi: int) -> int:
	if _combat == null or u == null or fi < 0 or fi >= u.die.size():
		return 0
	return FaceAmount.display_value(u.die[fi] as Dictionary, _combat._face_value(u, fi))


## All six faces, live values. Each row (focusable, named FaceRow): face word in its colour, value (Rowdies 24),
## part and keyword caption, "Rolled" on the face showing now. Colour never carries it alone: the word does.
func _inspect_faces(col: VBoxContainer, u: Unit) -> void:
	col.add_child(UI3.label(TranslationServer.translate("All six faces · live values"), "LabelMuted"))
	var list := VBoxContainer.new()
	list.add_theme_constant_override("separation", 4 if _inspect_compact else UI3Theme.space("8"))
	col.add_child(list)
	var rolled_index: int = u.roll_face_index()
	for i in u.die.size():
		var f: Dictionary = u.die[i]
		var face_type := String(f.get("type", ""))
		var fk := _ui3_face(face_type)
		var cell := UI3.plate(&"row")
		cell.name = "FaceRow"
		cell.add_to_group("inspect_face_row")
		cell.focus_mode = Control.FOCUS_ALL
		UI3.attach_focus_ring(cell)
		var row := HBoxContainer.new()
		row.add_theme_constant_override("separation", UI3Theme.space("16"))
		_cell_pad(cell, row)
		var ic := TextureRect.new()
		ic.texture = UI3.icon(String(UI3.FACE_ICON[fk]))
		var icon_px := 26.0 if _inspect_compact else 32.0
		ic.custom_minimum_size = Vector2(icon_px, icon_px)
		ic.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		ic.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		row.add_child(ic)
		var value := UI3.label("–" if face_type == "blank" else str(_live_face_value(u, i)), "LabelDisplay")
		value.add_theme_font_size_override("font_size", UI3Theme.size_of("text_title"))
		value.custom_minimum_size = Vector2(36, 0)
		row.add_child(value)
		var word := UI3.label(UI3.face_word(fk), "LabelDisplay")
		word.add_theme_font_size_override("font_size", UI3Theme.size_of("text_body"))
		word.add_theme_color_override("font_color", UI3Theme.color(String(UI3.FACE_WORD_COLOR[fk])))
		word.custom_minimum_size = Vector2(88, 0)
		row.add_child(word)
		var raw_part := String(f.get("part", ""))
		var text := String(_PART_LABEL.get(raw_part, "")).capitalize() if _PART_LABEL.has(raw_part) else ""
		var names: Array = []
		for k in (f.get("keywords", []) as Array):
			var base_kw := String(k).split(":")[0]
			names.append(String(_KEYWORD_LABEL.get(base_kw, base_kw.to_upper())))
		if not names.is_empty():
			text += ("  ·  " if text != "" else "") + " ".join(PackedStringArray(names))
		var cap := UI3.label(text, "LabelMuted")
		cap.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		cap.clip_text = true
		row.add_child(cap)
		if i == rolled_index:
			var mark := UI3.label(TranslationServer.translate("Rolled"), "LabelDisplay")
			mark.add_theme_font_size_override("font_size", UI3Theme.size_of("text_body"))
			mark.add_theme_color_override("font_color", UI3Theme.color("success_text"))
			row.add_child(mark)
		list.add_child(cell)


## A unit joined the fight. Goes through the full rebuild, not just the reconcile: building the
## nameplate is only half of it, and a nameplate that has not been painted yet shows 0/0 with an
## empty bar — which reads as a monster that spawned dead. (Seen in
## production/qa/evidence/2026-09-18_midcombat-spawn.png before this call was widened; the
## engine had the unit at full HP the whole time.)
func _on_unit_spawned(_uid: int) -> void:
	if _combat == null:
		return
	_rebuild_all()


## Makes the visuals match the engine's roster: builds a portrait, head HUD, 3D slot and audio
## voice for any unit that does not have them yet, then re-seats both rows.
##
## THIS IS THE SOURCE OF TRUTH, not `unit_spawned`. The bug it fixes was "there is a place that
## adds a unit and nothing tells the view" — there were five such places, one of them in
## `relic_hooks.gd`, a different file entirely. A fix that relies on every future spawn site
## remembering to announce itself would be the same bug waiting to happen, so the signal is
## treated as an optimisation and this comparison as the guarantee.
##
## Idempotent by construction: it only ever acts on uids it has not seen, so calling it from
## `_ready()`, from the signal, and from every `_rebuild_all()` is safe and cheap (a board is
## at most ~12 units).
func _sync_unit_visuals() -> void:
	var party_uids: Array = []
	var enemy_uids: Array = []
	for i in _combat.party.size():
		var u: Unit = _combat.party[i]
		party_uids.append(u.uid)
		if not _portraits.has(u.uid):
			_spawn_portrait(u, false, i, _combat.party.size())
	for i in _combat.enemies.size():
		var e: Unit = _combat.enemies[i]
		enemy_uids.append(e.uid)
		if not _portraits.has(e.uid):
			_spawn_portrait(e, true, i, _combat.enemies.size())

	# Every spawn shifts its whole row: `spawn_unit()` fixes a slot's position from the
	# slot_count it was given, so without this the newcomer sits on top of someone.
	if is_instance_valid(_stage3d):
		_stage3d.reseat_side(party_uids, false)
		_stage3d.reseat_side(enemy_uids, true)


func _spawn_portrait(u: Unit, is_enemy: bool, slot_index: int, slot_count: int) -> void:
	_ec()._spawn_portrait(u, is_enemy, slot_index, slot_count)


# ===========================================================================
# Per-frame overlay positioning (Nameplate at the feet, UnitHeadHUD above the head; all
# world->screen via CombatStage3D). Not an EventBus handler — see file-level "STATE-READ
# DISCIPLINE" comment for why this one function is allowed to re-read _combat/CombatStage3D every
# frame anyway (camera-space follow only).
#
# v2 UI redesign REMOVES two things that used to live here — TargetLines (the dashed
# attacker->target curves) and the dynamic vignette re-target — per design_handoff_axie_dice_ui's
# own treeNotes: "the intent plate names the target and the target's own plate carries the number
# plus the at-risk slice on its bar, so the lines were a third copy of information already on
# screen twice", and the vignette is superseded by the new static directional scrim (see
# _build_stage_background()'s comment for the full reasoning). Positioning nameplates/HUDs off
# the live 3D projection is UNCHANGED — CombatStage3D.gd (camera + per-slot world positions) is
# not a file this pass owns, so the v2 redline's "party columns at a fixed 194px pitch centred on
# x=960" is only partly landed: the DIE TRAY (fully owned here) now sits at that exact pitch, but
# the party nameplates above still follow wherever CombatStage3D's fixed camera projects them,
# which may not land on the identical pixel grid — see the task report for the follow-up this
# needs.
# ===========================================================================

## Enemy nameplate spacing. The per-plate WIDTH CAP that used to live here is GONE (FIX-PASS-03
## CB-09): every nameplate in combat is exactly 176 wide, both sides, "regardless of how long the
## name is. No text-measured widths." A cap that shrinks a plate when its neighbour is close is a
## variable width by another name.
##
## ⚠ FLAGGED FOR DESIGN — this is FIX-PASS-03 §11.2 territory, please read. The cap was not
## decorative: ENEMY_WIDTH=176 can exceed this fight's REAL projected on-screen slot pitch, which
## is NOT the same number as CombatStage3D's `_ROW_SPACING_ENEMY` world-space constant, because
## perspective projection does not map world spacing to screen pixels 1:1. With the cap removed,
## a fight whose enemies project closer together than 176 + a gap will have TOUCHING OR
## OVERLAPPING nameplates. CB-09 is unambiguous that the width may not move, so the remedy has to
## be on the other side of the relationship — the stage's slot pitch, or the anchor rule — and
## that is a design decision, not something to quietly re-cap here.
## `_ENEMY_PLATE_GAP` is retained: it is a real screen-pixel gap, still used for spacing checks,
## and is deliberately NOT the v2 mockup's 104 (that number lives in the mockup's flat 2D space,
## which this 3D-projected layout does not share).
const _ENEMY_PLATE_GAP := 16.0


# ── The combat band frame (CB-01 / CB-06 / CB-18) ──────────────────────────────
# History note: the front line itself was removed 13/10 (Liam, CB-06); the band math below stays.
# combat-v2.html's vertical structure is: top bar (60, anchored top) · enemy band · front line ·
# party band · deck (216, anchored bottom). The two bars are full-bleed and already anchored to
# a real viewport edge in Combat.tscn. Everything BETWEEN them was not: `%FrontLine` sat at a
# literal `offset_top = 480` and `%Stage3D` at fractional `anchor_top = 0.13 / bottom = 0.78`.
#
# Both are wrong under `window/stretch/aspect="expand"`, and wrong in different directions: the
# canvas grows vertically (a 2387x1540 window lays out in ~1920x1238), so the absolute 480 stays
# put while the fractional stage slides down past it, and the front line ends up floating inside
# the enemy band instead of sitting on the boundary between the two.
#
# The mockup's three numbers are kept, but as fractions of the band BETWEEN the two bars rather
# than of the whole canvas. At 1080 this reproduces the mockup exactly, by construction; on a
# taller canvas the band absorbs the slack and the three keep their relationship.
const _TOP_BAR_H := 60.0        ## CB-01, and Combat.tscn's %TopBar offset_bottom
## CB-18 says 216, and that is what this was. TRIMMED to 204 on 2026-09-21 at the owner's
## request ("thu gọn lại phần hub của skill — đang thừa ra 1 đoạn trống ở trên"), and 204 is not
## a taste call: the bar's own content is a 4px top border, the mockup's 16px inner inset top and
## bottom, and a tallest column of 166 (a 158 die card plus its 8px shelf; the MANA + RELIC
## ACTIVES column beside it measures ~156). 4 + 16 + 166 + 16 = 202, so 204 keeps two pixels of
## slack and takes the rest back for the stage. Anything below 202 starts eating the cards.
## Combat.tscn's %DeckBar offset_top carries the same number.
const _DECK_H := 204.0
## Reference frame only — the canvas the mockup was authored on. NOT a layout position: nothing
## below uses it except to convert one of the mockup's own y values into a band fraction.
const _MOCK_CANVAS_H := 1080.0
const _MOCK_BAND_H := _MOCK_CANVAS_H - _TOP_BAR_H - _DECK_H          ## 804
const _STAGE_TOP_F := (0.13 * _MOCK_CANVAS_H - _TOP_BAR_H) / _MOCK_BAND_H
## WAS `(0.78 * _MOCK_CANVAS_H - _TOP_BAR_H) / _MOCK_BAND_H`, i.e. the stage stopped at y=842
## and left a 22px strip of nothing between it and the deck bar. The strip was not the bug but it
## was where the bug showed: the party models were being sliced by a hard horizontal line, and a
## line with empty space under it reads as a rendering fault rather than a framing choice. The
## stage now runs to the deck bar.
##
## Extending it does NOT by itself reveal more of a model — `CombatStage3D` is a
## SubViewportContainer with `stretch = true`, so the render resizes with the Control and the
## camera keeps its vertical fov; a clipped foot stays clipped at the same fraction. It was
## tested that way round first and the tail was still cut, just lower down. What it does buy is
## 22 more pixels of band for the same world, which is a ~3% larger frame — worth having, and it
## is the party row moving back (CombatStage3D._POS_Z_PARTY) that actually uncovers the tails.
const _STAGE_BOTTOM_F := 1.0


## Places the two things that live between the top bar and the deck. Idempotent; runs once at
## build and again on every viewport resize. See the band-frame block above.
func _layout_stage_bands() -> void:
	var canvas_h: float = get_viewport_rect().size.y
	var band: float = maxf(canvas_h - _TOP_BAR_H - _DECK_H, 1.0)
	if _stage3d != null:
		# L6 (Liam 16/10, "remove the horizontal bar in the middle of the combat screen"): the
		# stage used to be a rectangle from y=140 to the deck. Its opaque sky/ground started with a
		# hard edge at y=140 and met the dark painted plate above it, which read as a horizontal
		# band across the screen. The 3D view now fills the WHOLE canvas and the arena runs behind
		# the top bar and the deck; the camera is re-framed so the units land on exactly the same
		# pixels they did inside the old band (see CombatStage3D.frame_band()).
		_stage3d.anchor_top = 0.0
		_stage3d.anchor_bottom = 0.0
		_stage3d.offset_top = 0.0
		_stage3d.offset_bottom = canvas_h
		_stage3d.frame_band(canvas_h, _TOP_BAR_H + band * _STAGE_TOP_F, _TOP_BAR_H + band * _STAGE_BOTTOM_F)


## C1 — where the enemy HUD column starts, in CANVAS pixels.
##
## combat-v2.html does not hang the enemy row off its creatures. The row is an absolutely
## positioned container — `top:69px; left:490px; height:376px` with `align-items:flex-end` — and
## the column inside it is `height:370px`, so the column's top edge is 69 + (376 - 370) = 75 and
## the intent badge is the first thing in it. Badge, status strip and nameplate therefore sit at
## FIXED y in the mockup; only the creature at the bottom of the column moves.
##
## The build anchored all three to `get_unit_screen_pos(uid, HEAD_HEIGHT)` instead, which is what
## dropped the stack 185px (review C1: "the intent badge's top should be y=75, the build has
## y=260"), and no head offset fixes it — see _layout_unit_visuals() for the arithmetic.
##
## 125 = 75 + UnitHeadHUD.HEIGHT (42) + the column's own `gap:8`. Written out rather than
## computed from UnitHeadHUD.HEIGHT so this stays a plain constant expression; the two are
## checked against each other in _layout_unit_visuals(), which uses the const from that file.
const _ENEMY_COLUMN_TOP := 75.0
const _ENEMY_PLATE_TOP := 125.0


func _layout_unit_visuals() -> void:
	if _combat == null:
		return
	var stage_offset: Vector2 = _stage3d.position   # Stage3D no longer fills the whole Root
	# UI-05 lane C: ONE enemy column, top-right, clusters 12 apart, AttritionCard last, never on the docks
	# (EnemyColumn.layout_column).
	_ec().layout_column()

	for uid in _portraits.keys():
		var p: UnitPortrait = _portraits[uid]
		if _combat_is_enemy_uid(uid):
			continue
		# Party: the portrait is only the anchor damage numbers rise from (chest height).
		var feet := _stage3d.get_unit_screen_pos(uid, CombatStage3D.FEET_HEIGHT)
		if feet.x >= 0.0:
			var chest := _stage3d.get_unit_screen_pos(uid, CombatStage3D.HEAD_HEIGHT)
			p.position = Vector2(stage_offset.x + chest.x - p.size.x * 0.5, stage_offset.y + chest.y)
	_layout_status_heads(stage_offset)
	_backdrop.apply_parallax(stage_offset)


## UI-03: status icons above the head of every unit (StatusHeads). THE one place that decides where that
## is: change this function (and only this) when the units move to another layout. `stage_offset` is the
## stage's position in this view; returns Vector2(-1, -1) when the unit has no point on screen (dead,
## hidden, behind the camera).
func _status_head_anchor(uid: int, is_party: bool, stage_offset: Vector2) -> Vector2:
	var head_h: float = CombatStage3D.AXIE_HEAD_HEIGHT if is_party \
		else _stage3d.head_height_of(uid, CombatStage3D.HEAD_HEIGHT)   # tall / hovering bosses: the real top
	var head := _stage3d.get_unit_screen_pos(uid, head_h)
	if head.x < 0.0:
		return Vector2(-1, -1)
	return stage_offset + head - Vector2(0, 8.0)   # just above the unit's own head, wherever it stands


func _layout_status_heads(stage_offset: Vector2) -> void:
	if not is_instance_valid(_status_heads):
		_status_heads = StatusHeads.new()
		_status_heads.name = "StatusHeads"
		_status_heads.z_index = 3
		_unit_visuals_root.add_child(_status_heads)
		_status_heads.unit_clicked.connect(_on_target_clicked)
		_status_heads.unit_inspect.connect(_open_unit_inspect)
	var entries: Array = []
	for group in [_combat.party, _combat.enemies]:
		var is_party: bool = group == _combat.party
		for u in group:
			var alive: bool = u.hp > 0
			entries.append({"uid": u.uid, "shield": u.shield, "status": u.status,
				"plating": CombatTraits.plating_of(_combat, u) if not is_party else 0,
				"plating_off": int(u.plating_off) if (not is_party and u.plating > 0) else 0,
				"preview": _plating_preview(u) if not is_party else "",
				"hidden": not alive or _exit_running, "frozen": u.frozen,
				"anchor": _status_head_anchor(u.uid, is_party, stage_offset) if alive else Vector2(-1, -1)})
	_status_heads.sync(entries)


## "4 -> 1": what the picked damage die would do to foe `e` once its Plating cuts the hit. "" when nothing is picked,
## the face is not a single-target damage face, or the foe has no Plating right now. Uses
## CombatEngine.preview_damage (lane A, pure: vulnerable, boss hollow, Plating; no crit / Core hooks).
func _plating_preview(e: Unit) -> String:
	if _combat == null or _selected_die_uid == -1 or e.hp <= 0 or CombatTraits.plating_of(_combat, e) <= 0:
		return ""
	var src := _combat.by_uid(_selected_die_uid)
	if src == null or not src.has_rolled() or _selected_face_type() != "dmg":
		return ""
	var pd: Dictionary = _combat.preview_damage(src, e, src.roll_face_index())
	if not bool(pd.get("single", false)) or int(pd.get("plating", 0)) <= 0:
		return ""
	var raw := int(pd.get("raw", 0))
	var after := int(pd.get("after", 0))
	return "%d → %d" % [raw, after] if after != raw else ""


## Floats near the foe when its Plating breaks / wears (EventBus plating_off, plating_decay): a UI3 chip above the
## foe's head, clamped inside the 24 px safe frame so it never clips at any window size.
func _on_plating_off(uid: int, _turns: int) -> void:
	_plating_learned = true
	_after_impact(func():
		_spawn_foe_note(uid, TranslationServer.translate("Plating broken"))
		_rebuild_all())


func _on_plating_decay(uid: int, p_now: int) -> void:
	_after_impact(func():
		_spawn_foe_note(uid, TranslationServer.translate("Plating wears down") + " " + str(p_now)))


func _spawn_foe_note(uid: int, text: String) -> void:
	if disable_juice_for_tests or not is_inside_tree() or _stage3d == null or _unit_visuals_root == null:
		return
	var a := _status_head_anchor(uid, false, _stage3d.position)
	if a.x < 0.0:
		return
	var chip := UI3.float_chip(text)
	_unit_visuals_root.add_child(chip)
	var sz := chip.get_combined_minimum_size()
	chip.size = sz
	var vs := get_viewport_rect().size
	var pos := a - Vector2(sz.x * 0.5, sz.y + 40.0)   # above the ARM / status chips of that foe
	pos.x = clampf(pos.x, 24.0, vs.x - 24.0 - sz.x)
	pos.y = clampf(pos.y, 24.0, vs.y - 24.0 - sz.y)
	chip.position = pos
	var rise := 16.0 if motion_suppressed() else 40.0
	var tw := chip.create_tween()
	tw.tween_interval(1.0)
	tw.set_parallel(true)
	tw.tween_property(chip, "position:y", maxf(24.0, pos.y - rise), 0.6)
	tw.tween_property(chip, "modulate:a", 0.0, 0.6)
	tw.chain().tween_callback(chip.queue_free)


var _plating_learned := false

const _ENEMY_COLUMN_TOP_UI3 := 24.0
const _ENEMY_PLATE_TOP_R1 := 96.0
const _ENEMY_PLATE_GAP_R1 := 40.0


## C5: true only while iterating _portraits in _layout_unit_visuals() above — kept as a tiny
## helper rather than inlining `_combat.enemies` lookup twice (min/max tracking above, this call).
func _combat_is_enemy_uid(uid: int) -> bool:
	for e in _combat.enemies:
		if e.uid == uid:
			return true
	return false


# ===========================================================================
# Input — click-click (dice tray = select source, Nameplate/3D model = select target)
# ===========================================================================

## The tutorial step-lock, asked once per handler. Outside the tutorial this is one boolean.
func _gated(key: String) -> bool:
	if not _tutorial or not _gate_allows.is_valid():
		return false
	return not bool(_gate_allows.call(key))


## Installed once by the tutorial fixture: `allows(key) -> bool`, asked on every interaction.
func set_tutorial_gate(allows: Callable) -> void:
	_gate_allows = allows


func _on_die_slot_pressed(slot_index: int) -> void:
	# SR0: one seed request in flight = no other dice action (never queue a second action on an unknown result)
	if _combat.epoch_pending:
		return
	_land_dice_now()
	if _is_animating:
		return
	if _gated("die:%d" % slot_index):
		return
	var units := _party_dice_units()
	if slot_index >= units.size():
		return
	var u: Unit = units[slot_index]
	if _rr_mode:
		_rr_toggle(u.uid)
		return
	if _wild_mode:
		_wild_pick_die(u.uid)
		return
	# With a die already selected, a click on ANOTHER column targets that Axie (heal / shield).
	if _selected_die_uid != -1 and u.uid != _selected_die_uid and u.hp > 0 \
			and _selected_ally_target_ok(u):
		_on_target_clicked(u.uid)
		return
	if u.hp <= 0 or not u.has_rolled() or u.roll_used() or u.held:
		return
	_selected_active_id = ""   # a die and a relic active cannot both be waiting on one click
	_selected_die_uid = -1 if _selected_die_uid == u.uid else u.uid
	_rebuild_all()


## Writes the CONTINUE RUN slot with this fight's full state. Called after every action that
## actually changes the engine — the same placement JS uses for its thirteen saveRun() calls.
## Selecting a die is deliberately NOT one of them: it changes nothing an engine snapshot would
## record, and saving on it would write the file on every click for no gain.
func _save_run_progress() -> void:
	if _combat == null or _result_shown or _tutorial:
		return
	RunState.save_run(_combat.to_data())


## Pressing a relic active. Cards that hit nobody in particular resolve on the spot; the rest
## arm and wait for a unit click, exactly like selecting a die does.
##
## Arming an active DISARMS any selected die and vice versa (see _on_die_slot_pressed), because
## _on_target_clicked() can only mean one of them and a player holding both would be guessing.
func _on_active_pressed(relic_id: String) -> void:
	if _is_animating or _combat == null:
		return
	if _gated("active"):
		return
	if _selected_active_id == relic_id:      # press again to put it down
		_selected_active_id = ""
		_clear_all_previews()
		_rebuild_all()
		return
	var def: RelicDef = RelicRegistry.get_def(relic_id)
	if def == null:
		return
	if _combat.mana < _combat.active_cost(def):
		return                                # the tile is already disabled; belt and braces

	if def.act_target() == "none":
		_play_active_now(relic_id, -1)
		return
	_selected_active_id = relic_id
	_selected_die_uid = -1
	_clear_all_previews()
	_rebuild_all()


## The one place an active is actually spent, so the log line, the failure float and the
## disarm cannot drift between the targeted and untargeted paths.
func _play_active_now(relic_id: String, target_uid: int) -> void:
	var ok: bool = _combat.play_active(relic_id, target_uid)
	_append_log("[input] active %s -> %s : %s" % [relic_id,
		_unit_name(target_uid) if target_uid >= 0 else "-", "ok" if ok else "invalid"])
	if not ok and target_uid >= 0:
		var p: UnitPortrait = _portraits.get(target_uid)
		if p != null:
			p.spawn_float_text("Invalid target", "deb", 0)
	_selected_active_id = ""
	_clear_all_previews()
	_rebuild_all()
	_save_run_progress()


func _on_target_clicked(uid: int) -> void:
	# SR0: one seed request in flight = no other dice action (never queue a second action on an unknown result)
	if _combat.epoch_pending:
		return
	if _is_animating:
		return
	if _gated("target:%d" % uid):
		return
	# src/client.html:5273 — a unit that is NOT a legal target opens its inspector instead;
	# a legal one is a target. In this port "legal target" is exactly what _update_portrait()
	# paints as targetable: a die is selected and the unit is alive. So the targeting path
	# below is untouched, and this only fills in the click that used to do nothing at all.
	var u := _combat.by_uid(uid)
	# An armed relic active claims the click before the die path does. Checked FIRST because
	# arming one clears `_selected_die_uid`, so the die branch below would fall through to the
	# inspector and the player's click would look like it did nothing.
	if _selected_active_id != "":
		if u == null or u.hp <= 0:
			_open_unit_inspect(uid)
			return
		_play_active_now(_selected_active_id, uid)
		return
	if _selected_die_uid == -1 or u == null or u.hp <= 0:
		_open_unit_inspect(uid)
		return
	# An illegal target keeps the die picked and keeps showing its reason (the plate's red label).
	if _illegal_reason_for(u) != "":
		_append_log("[input] use %s -> %s : illegal (%s)" % [_unit_name(_selected_die_uid), _unit_name(uid),
			_illegal_reason_for(u)])
		return
	var ok := _combat.use_die(_selected_die_uid, uid)
	_append_log("[input] use %s -> %s : %s" % [_unit_name(_selected_die_uid), _unit_name(uid), "ok" if ok else "invalid"])
	if not ok:
		var p: UnitPortrait = _portraits.get(uid)
		if p != null:
			p.spawn_float_text("Invalid target", "deb", 0)
	_selected_die_uid = -1
	_clear_all_previews()
	_rebuild_all()
	_save_run_progress()


func _on_reroll_pressed() -> void:
	# Reroll pressed (or R) while the dice are still in the air: just land them, do not reroll again.
	if _dice_in_air():
		_land_dice_now()
		return
	_land_dice_now()
	if _gated("reroll") or _combat.epoch_pending or _rr_mode:
		return
	# Depth v4 2.1: past the free reroll, from stage 2 on, "Reroll more" opens the pick mode (Gamble / Safe).
	if _combat.rerolls <= 0 and _combat.depth_stage >= 2 and _combat.reroll_is_payable():
		_enter_rr_mode()
		return
	await _do_reroll(_auto_reroll_uids(), 1)


## Dice the one-button reroll throws: every rerollable die OUTSIDE a Set; if that leaves none, all of them.
func _auto_reroll_uids() -> Array:
	var all: Array = []
	for u in _party_dice_units():
		all.append((u as Unit).uid)
	var ok: Array = []
	var outside: Array = []
	for u in _combat._rerollable(all):
		ok.append((u as Unit).uid)
		if V4Ui.group_of(_combat.bo, (u as Unit).uid).is_empty():
			outside.append((u as Unit).uid)
	return outside if not outside.is_empty() else ok


func _do_reroll(uids: Array, rmode: int) -> void:
	_exit_rr_mode(false)
	_wild_mode = false
	_wild_uid = -1
	# The face each die showed BEFORE the reroll: the +2 / -1 / NEW chips are measured against it.
	_reroll_prev.clear()
	if _combat.rerolls > 0 or _combat.reroll_is_payable():
		for uid in uids:
			_reroll_prev[uid] = _combat.by_uid(uid).roll_face_index()
	var gamble_on := rmode == 0 and _combat.depth_stage >= 2
	# dm_roll itself is played once, by the throw (pre-throw or _start_dice_throw), not here.
	if gamble_on or rmode != 0:
		_dm_audio.play("dm_gamble_arm" if gamble_on else "dm_reroll_safe")
	_begin_pre_throw(uids, rmode)   # PB: the dice fly NOW, the seed lands while they roll
	if _hud_frame != null:
		_hud_frame.set_seed_wait(true)
	var rr: Dictionary = await _combat.request_reroll_dice(uids, false, rmode)
	if not _still_running():
		_cancel_pre_throw()
		return
	if _hud_frame != null:
		_hud_frame.set_seed_wait(false)
	var ok := bool(rr["ok"])
	if not ok:
		_cancel_pre_throw()
	if ok and gamble_on:
		var cracked := 0
		for uid in uids:
			var cu := _combat.by_uid(int(uid))
			if cu != null and cu.cracked:
				cracked += 1
		_dm_audio.play("dm_crack" if cracked > 0 else "dm_gamble_clean")
	_append_log("[input] reroll %d dice (%s): %s" % [uids.size(), "gamble" if rmode == 0 else "safe", "ok" if ok else "failed"])
	if not ok:
		_reroll_prev.clear()
		if String(rr["code"]) not in ["illegal", "busy"]:
			NetNotice.show(self, String(rr["code"]), _on_reroll_pressed, "Could not reroll your dice")
	_selected_die_uid = -1
	# The rebuild sees the rerolled dice in _reroll_prev and throws them in 3D, like the first roll.
	_rebuild_all()
	_cancel_pre_throw()   # no-op when the rebuild handed the faces to the dice in the air
	_save_run_progress()


# ---- Depth v4 reroll pick mode (combat-v4.md 2.2, 2.3, 2.5) -------------------------------------------------
var _rr_mode := false
var _rr_sel: Array = []
var _rr_bar: RerollBar = null


func _rr_all_uids() -> Array:
	var all: Array = []
	for u in _party_dice_units():
		all.append((u as Unit).uid)
	return all


func _rr_pinned() -> Dictionary:
	var k: int = _combat.reroll_k + 1
	return _combat.reroll_lock[k] if _combat.reroll_lock.has(k) else {}


func _enter_rr_mode() -> void:
	_coach_hide()
	_wild_mode = false
	_rr_mode = true
	_selected_die_uid = -1
	_selected_active_id = ""
	var pin := _rr_pinned()
	_rr_sel = (pin["uids"] as Array).duplicate() if not pin.is_empty() else _auto_reroll_uids()
	_rebuild_all()
	if _rr_bar != null:
		(_rr_bar.safe_button if (_rr_bar.safe_button.visible and not _rr_bar.safe_button.disabled) else _rr_bar.gamble_button).grab_focus()


func _exit_rr_mode(rebuild := true) -> void:
	if not _rr_mode:
		return
	_rr_mode = false
	_rr_sel.clear()
	if rebuild:
		_rebuild_all()


func _rr_toggle(uid: int) -> void:
	if not _rr_pinned().is_empty():
		return   # a locked roll must repeat the same dice
	if _combat._rerollable([uid]).is_empty():
		return
	if _rr_sel.has(uid):
		_rr_sel.erase(uid)
	else:
		_rr_sel.append(uid)
	_rebuild_all()


func _on_rr_chosen(rmode: int) -> void:
	if not _rr_mode:
		return
	await _do_reroll(_rr_sel.duplicate(), rmode)


## Why a die cannot be picked for the reroll ("" = it can).
func _rr_die_why(u: Unit) -> String:
	if u.hp <= 0 or not u.has_rolled():
		return ""
	if u.roll_used():
		return TranslationServer.translate("Used")
	if u.overcast:
		return TranslationServer.translate("Has Overcast, cannot reroll")
	if u.wild_slot >= 0:
		return TranslationServer.translate("Has a Wild face, cannot reroll")
	if u.held:
		return TranslationServer.translate("Held")
	if u.frozen or u.heavy:
		return TranslationServer.translate("Frozen")
	return ""


## High Stakes (stage >= 2): the crack chance in percent of the forced Gamble, else 0.
func _stakes_pct() -> int:
	if _combat == null or _combat.depth_stage < 2 or not CoreHooks.RelicHooks_has(_combat, "rule_high_stakes"):
		return 0
	return roundi(float(CoreHooks.rule_knob("rule_high_stakes", "crack_chance", 0.2)) * 100.0)


func _update_rr_bar() -> void:
	var hud := _hud_frame
	if hud == null or _combat == null:
		return
	if _rr_mode and not (_combat.phase == CombatPhase.EXECUTE and not (_combat.won or _combat.lost)):
		_rr_mode = false
		_rr_sel.clear()
	if _rr_bar == null:
		_rr_bar = RerollBar.new()
		_rr_bar.z_index = 9
		_shell_root.add_child(_rr_bar)
		_rr_bar.chosen.connect(_on_rr_chosen)
	_rr_bar.visible = _rr_mode
	if not _rr_mode:
		return
	for b in [hud.undo_button, hud.reroll_button, hud.hold_button, hud.overcast_button, hud.wild_button]:
		(b as Control).visible = false   # 5.1b: only the tray and the pick bar while picking
	var n := _rr_sel.size()
	var stakes := _stakes_pct()
	var pct := float(stakes) if stakes > 0 else CombatEngine.tune_knob("crack", "pct", 30.0)
	var gref := _combat.reroll_refusal(_rr_sel, false, 0)
	var sref := _combat.reroll_refusal(_rr_sel, false, 1)
	var cost := _combat.reroll_mana_cost(false, 1)
	var line := ""
	var pin := _rr_pinned()
	if not pin.is_empty():
		line = TranslationServer.translate("Locked for this roll: %s · %d dice") % [
			TranslationServer.translate("GAMBLE") if int(pin["rmode"]) == 0 else TranslationServer.translate("SAFE"),
			(pin["uids"] as Array).size()]
	elif gref == "":
		line = V4Ui.gamble_line(n, pct)
	else:
		line = V4Ui.refusal_text(gref, cost, _combat.mana)
	if stakes > 0 and pin.is_empty():
		line = TranslationServer.translate("High Stakes: Gamble · Crack %d%% per die. Crack = half value this turn.") % stakes \
			+ ("\n" + V4Ui.refusal_text(gref, cost, _combat.mana) if gref != "" else "")
	elif sref != "" and sref != gref and pin.is_empty():
		line += "\n" + V4Ui.refusal_text(sref, cost, _combat.mana)
	_rr_bar.update({
		"gamble_ok": gref == "", "gamble_text": TranslationServer.translate("Gamble · free"),
		"gamble_tip": TranslationServer.translate("Each rerolled die has a %d%% chance to Crack (half value, out of the Set, until next turn).") % int(pct) if gref == "" else V4Ui.refusal_text(gref, cost, _combat.mana),
		"safe_ok": sref == "", "safe_text": TranslationServer.translate("Safe · %d MP") % cost,
		"safe_tip": TranslationServer.translate("No risk. Costs mana.") if sref == "" else V4Ui.refusal_text(sref, cost, _combat.mana),
		"line": line, "show_gamble": true, "show_safe": stakes <= 0})
	_rr_bar.place(get_viewport_rect().size.x - 24.0, hud.reroll_button.position.y)


