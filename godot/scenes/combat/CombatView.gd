## Player-facing translation (review P0 #1: "Buba cắm sừng Gooey Slime · 5", NOT
## "[use] Puffy -> Puffy (ears/mana)"). Built from the same hit_landed payload the raw log
## line above uses, plus the face part/type cached from the most recent face_used for this
## attacker — see _on_face_used()/_last_face_used_by_uid comments.
func _player_hit_line(src_uid: int, tgt_uid: int, value: int, crit: bool) -> String:
	var src := _unit_name(src_uid)
	var tgt := _unit_name(tgt_uid)
	var cached: Dictionary = _last_face_used_by_uid.get(src_uid, {})
	var part := String(cached.get("part", ""))
	var face_type := String(cached.get("type", ""))
	var line: String
	match face_type:
		"heal":
			line = "%s heals %s" % [src, tgt]
		"shield":
			line = "%s shields %s" % [src, tgt]
		"poison":
			line = "%s poisons %s" % [src, tgt]
		_:
			var verb: String = _PART_VERB.get(part, "hits")
			line = "%s %s %s" % [src, verb, tgt]
	line += " · %d" % value
	if crit:
		line += " (crit)"
	return line


