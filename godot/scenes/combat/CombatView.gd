func _ready() -> void:
	_setup = RunState.pending_combat
	RunState.pending_combat = {}
	# CONTINUE RUN enters this scene straight from the main menu, so nobody has called
	# RunState.enter_node() and pending_combat is empty. Everything _setup is read for —
	# node_id, kind, pw, combat_seed — is already inside the saved engine snapshot, so rebuild
	# it from there rather than requiring the map to be walked again just to produce it.
	if _setup.is_empty() and not RunState.resume_combat.is_empty():
		_setup = _setup_from_snapshot(RunState.resume_combat)
	assert(not _setup.is_empty(), "Combat.tscn entered with no pending_combat set — " +
		"RunMapController must call RunState.enter_node() with a combat node_kind first")

	_build_gradient_textures()
	_connect_event_bus()
	_build_top_bar()
	_connect_ui_buttons()
	_player_log_panel.visible = false   # task defect 2 — nothing to show yet; see _append_player_log()

	_audio = CombatAudioDirector.new()
	_audio.name = "CombatAudioDirector"
	add_child(_audio)   # must be in the tree (and so past its _ready) before _spawn_portrait()
		# starts calling register_unit() below

	_combat = CombatEngine.new()
	# The run owns the log; the combat only writes into it. Set before any action can be taken,
	# and on the resume path too — a fight resumed from a save is the same run, and a log with a
	# hole in the middle is not evidence of anything.
	_combat.action_log = RunState.action_log
	# CONTINUE RUN: a run saved mid-fight carries the whole CombatEngine snapshot, and restoring
	# it is not the same thing as starting the node again — setup_new() would re-roll the
	# encounter and hand the player a fresh, full-health enemy line-up for a fight they were
	# halfway through winning. JS resumes the same way (client.html:3996 drops straight back to
	# screen='combat' with the saved `s`).
	var resumed: Dictionary = RunState.resume_combat
	RunState.resume_combat = {}
	if not resumed.is_empty():
		_combat.from_data(resumed)
		_append_log("=== combat RESUMED from save: node=%s turn=%d ===" % [_combat.node_id, _combat.turn])
	else:
		_combat.setup_new(_setup)
	_max_rerolls = _combat.max_rerolls

	# One path builds the board, at t=0 and at every later spawn alike. Two separate paths is
	# what let units that JOIN a fight (gooey_king's SPLIT, summoner adds, Axie Eggs) ship with
	# no nameplate, no HP bar and no sound: `_ready()` was the only place that ever built one.
	_sync_unit_visuals()

	# Pick the backdrop from where this fight sits in the run, so an 18-row run reads as a
	# journey instead of eighteen fights on the same patch of desert. The row comes from the
	# map graph rather than from power_level: power_level counts every node type, so it drifts
	# away from the row number as soon as the player takes an event or a shop.
	_backdrop.show_for_node(_current_map_row(), String(_setup.get("kind", "")) == "boss")
	# Same two inputs the backdrop uses, so picture and music agree about which fight this is.
	# The track itself is chosen from the node id's hash, never randomly — see CombatAudio.
	_audio.start_music(String(_setup.get("node_id", "")),
		String(_setup.get("kind", "")) == "boss")

	_append_log("=== combat start: node=%s kind=%s pw=%d seed=%d ===" % [
		_setup.get("node_id", "?"), _setup.get("kind", "?"), _setup.get("pw", -1), _setup.get("combat_seed", -1)])
	_rebuild_all()
	_save_run_progress()   # quitting before the first click still resumes INTO this fight,
		# rather than back onto the map with the node not yet entered


func _process(_delta: float) -> void:
	_layout_unit_visuals()


## The CombatSetup fields this scene reads, recovered from a saved CombatEngine snapshot.
## Deliberately NOT the full setup shape: `roster_snapshot`/`relic_ids` are only an input to
## setup_new(), which a resumed fight never calls — the units and relics come back inside the
## snapshot itself. Including them would invite someone to believe this is a setup you could
## start a fresh fight from.
func _setup_from_snapshot(snap: Dictionary) -> Dictionary:
	return {
		"node_id": String(snap.get("node_id", "")),
		"kind": String(snap.get("kind", "battle")),
		"pw": int(snap.get("pw", 0)),
		"ascension": int(snap.get("ascension", 0)),
		"combat_seed": int(snap.get("combat_seed", 0)),
	}


## The RunMap row this combat's node sits on, or 1 when there is no map to ask (DevReview and
## the QA capture scenes enter Combat.tscn directly, without a run).
func _current_map_row() -> int:
	var node_id := String(_setup.get("node_id", ""))
	if node_id == "" or RunState.map_graph.is_empty():
		return 1
	var node := RunMapGraph.from_data(RunState.map_graph).find_node(node_id)
	return node.row if node != null else 1


func _exit_tree() -> void:
	_stage3d.dispose_all()


func _unhandled_key_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not (event as InputEventKey).echo:
		if (event as InputEventKey).keycode == KEY_SPACE and not _end_turn_button.disabled and not _is_animating:
			_on_end_turn_pressed()


