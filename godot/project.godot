; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes as script root
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Axie Dice (Godot port)"
run/main_scene="res://scenes/main_menu/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon=""

[axie]

; Web builds have no `curl`, so AxieApi falls back to Transport.PROXY and does a plain
; GET <proxy_url>?id=<axieId>. Without this setting active_transport() returns NONE and
; Import Axie silently reports "unavailable" in the browser -- desktop kept working, which
; is exactly why it went unnoticed. The endpoint is `api/axie.js` in this repository, a
; serverless function that answers with the already-unwrapped Axie and sends
; Access-Control-Allow-Origin: *, so the Godot build may be hosted on any origin.
proxy_url="https://axiedice.vercel.app/api/axie"

[autoload]

EventBus="*res://autoload/EventBus.gd"
MetaState="*res://autoload/MetaState.gd"
ContentDB="*res://autoload/ContentDB.gd"
RunState="*res://autoload/RunState.gd"
RunStatsAccumulator="*res://autoload/RunStatsAccumulator.gd"
RelicRegistry="*res://autoload/RelicRegistry.gd"
AxieMixerBoot="*res://autoload/AxieMixerBoot.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/axie_mixer_3d/plugin.cfg", "res://addons/axie_mixer_3d_weapon_anims/plugin.cfg")

[display]

; No [display] section existed before this — the project ran at the engine default
; 1152x648 viewport with stretch mode "disabled". Any real window bigger than that
; (e.g. ~2000x1400, a normal desktop) just showed MORE raw canvas at 1:1 pixel scale
; instead of scaling UI/backgrounds to fill it — this is why Combat.tscn's background
; sprite (sized/positioned for the old assumed 1152x648) only covered a small
; top-left rectangle of the real window (bug report: background not covering screen).
; canvas_items stretch mode scales the whole 2D canvas (Controls AND plain Node2D/
; Sprite2D content, not just CanvasLayers) to fill the actual window. The aspect mode
; that pairs with it is decided in the block below.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
; ── aspect: back to expand, 20 Sep 2026 (user decision, reversing this morning's) ──
; This block previously read "expand → keep". That has been reversed. The reasoning
; for "keep" was that the four v2 mockups are authored at a fixed 1920x1080 and place
; every element by absolute coordinate, so pixel-exactness is only well-defined if the
; logical canvas is exactly 1920x1080. True — but the price was letterbox bars on every
; window that is not 16:9, which is most of them.
;
; The reconciliation, and the rule that now holds:
;   * The mockups remain the source of truth for every INTRINSIC number — width,
;     height, padding, radius, border, gap, font size, colour. Type those in as drawn.
;   * The mockups are NOT a source of ABSOLUTE POSITION. A y coordinate read off a
;     1080-tall mockup is not portable, because under "expand" the logical viewport
;     keeps its horizontal scale and grows vertically (a 2387x1540 window lays out in
;     roughly 1920x1238). 1920x1080 is the MINIMUM canvas, not the design canvas.
;   * So: full-bleed bands anchor to a real viewport edge; everything else lives in a
;     centred content column and stacks by relationship ("28px below the ribbon"),
;     never by an absolute offset_top copied from a mockup.
;
; This restores the 2026-09-18 arbitration and matches FIX-PASS-03 §1 and §10.
window/stretch/aspect="expand"

[gui]

; ONE theme, project-wide. The v2 UI handoff §07 step 1 asks for "one Theme applied at the
; root of all six scenes"; setting it here instead reaches every Control in the project,
; including the ones built at runtime by CombatView/RunMapController/MainMenu — which is most
; of this game's UI and would each have had to remember to inherit it. It also means a scene
; added later cannot forget.
;
; The file is GENERATED. Do not hand-edit it: run `Godot --headless --path godot --script
; tools/gen_theme.gd`, which builds it from DangoTheme so the theme and the code-built widgets
; cannot drift apart.
theme/custom="res://resources/theme/dango.tres"

[rendering]

; Forward+ required by Axie Mixer 3D (mystic glow / outline shaders target it — see
; third_party/godot-axie-mixer-3d-main/README.md "Godot 4.7 (Forward+) port"). Combat
; is still 2D-composited UI/layout (architecture plan §2-§3); this only affects how the
; 3D Axie renderer sub-viewport draws.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
